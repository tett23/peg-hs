import LabelsTranslated
import LabelCheckModel

/-!
The translation of Peg.Grammar.Labels (LabelsTranslated, generated by
TranslateHaskell.hs from the Haskell source) against the model
LabelCheckModel.

The projections `pExpr`, `pGrammar` and the others map the translated types
to the model's: a location's integers become natural numbers, a code point
keeps its value, and the fields that the model leaves out (`other`) are
empty.

Theorems:
- `strip_expr`: the translated `expr` of `stripLabels` is the model's
  `stripExpr` on every expression (and `strip_items` on items).
- `stripLabels_translated`: the translated `stripLabels` is the model's
  `stripLabels`, under the projection.
- `stripLabelsAs_translated`: the same for `stripLabelsAs`.
- `stripLabels_template_args`: the translated `stripLabels` keeps the
  arguments of a template call as they are (README premise L4, first half,
  is a property of the translation).

The model's theorems on `stripLabels` (LabelCheckTheorems:
`unlabelExpr_stripExpr`, `stripLabels_rules`, `stripLabels_fields`,
`recoveryEntries_spec`) thus hold of the translated function. Premises: the
translator's rules and the evaluation rules of HsPrelude.lean (README X2,
H1-H8).
-/

namespace PegHs.LabelsTranslatedProof

abbrev TExpr := LabelsTranslated.Expr
abbrev TItem := LabelsTranslated.Item
abbrev MExpr := PegHs.LabelCheck.Expr
abbrev MItem := PegHs.LabelCheck.Item

def pLoc : LabelsTranslated.Loc → PegHs.LabelCheck.Loc
  | .Loc f l c => ⟨f.toNat, l.toNat, c.toNat⟩

def pLocated : LabelsTranslated.Located String → PegHs.LabelCheck.Loc × String
  | .Located l x => (pLoc l, x)

def pChar (c : HsChar) : PegHs.LabelCheck.HChar :=
  ⟨c.val, by have := c.isLt; simp [PegHs.LabelCheck.maxCode]; omega⟩

mutual
def pExpr : TExpr → MExpr
  | .ELit t w => .lit t w
  | .EClass rs w => .cls (rs.map fun p => (pChar p.1, pChar p.2)) w
  | .EAny => .any
  | .ERef l n as => .ref (pLoc l) n (as.map pLocated)
  | .EGroup alts => .group (pAlts alts)
  | .EStar x => .star (pExpr x)
  | .EPlus x => .plus (pExpr x)
  | .EOpt x => .opt (pExpr x)
  | .EAnd x => .and (pExpr x)
  | .ENot x => .not (pExpr x)
  | .ECapture x => .capture (pExpr x)
  | .ELabel l x n => .label (pLoc l) (pExpr x) n
  | .EPred b c => .pred b (pLocated c)
  | .ETemplate l n as vs => .template (pLoc l) n (pList as) (vs.map pLocated)
  | .EDiscard x => .discard (pExpr x)
def pItem : TItem → MItem
  | .Item l b e => (pLoc l, b, pExpr e)
def pItems : List TItem → List MItem
  | [] => []
  | i :: is => pItem i :: pItems is
def pAlts : List (List TItem) → List (List MItem)
  | [] => []
  | a :: as => pItems a :: pAlts as
def pList : List TExpr → List MExpr
  | [] => []
  | e :: es => pExpr e :: pList es
end

def pAlt : LabelsTranslated.Alt → PegHs.LabelCheck.Alt
  | .Alt l is _ _ => ⟨pLoc l, pItems is, []⟩

def pRule : LabelsTranslated.Rule → PegHs.LabelCheck.Rule
  | .Rule n _ ps _ _ _ alts => ⟨n, ps.map LabelsTranslated.Param.paramName, alts.map pAlt, []⟩

def pPair (p : LabelsTranslated.Located String × LabelsTranslated.Located String) :
    (PegHs.LabelCheck.Loc × String) × (PegHs.LabelCheck.Loc × String) :=
  (pLocated p.1, pLocated p.2)

def pGrammar (g : LabelsTranslated.Grammar) : PegHs.LabelCheck.Grammar where
  module := pLocated g.grammarModule
  start := g.grammarStart.map pLocated
  entries := g.grammarEntries.map pLocated
  recovers := g.grammarRecovers.map pPair
  safe := g.grammarSafe.map pLocated
  messages := g.grammarMessages.map pPair
  rules := g.grammarRules.map pRule
  other := []

/-! ## stripLabels -/

theorem pItems_map (xs : List TItem) : pItems xs = xs.map pItem := by
  induction xs with
  | nil => simp [pItems]
  | cons x xs ih => simp [pItems, ih]

theorem pAlts_map (xs : List (List TItem)) : pAlts xs = xs.map pItems := by
  induction xs with
  | nil => simp [pAlts]
  | cons x xs ih => simp [pAlts, ih]

mutual
theorem strip_expr (e : TExpr) :
    pExpr (LabelsTranslated.stripLabels.expr_1019 e) = PegHs.LabelCheck.stripExpr (pExpr e) := by
  cases e with
  | EGroup alts =>
    rw [LabelsTranslated.stripLabels.expr_1019]
    simp only [pExpr, PegHs.LabelCheck.stripExpr]
    congr 1
    exact strip_alts alts
  | ELabel l x n =>
    rw [LabelsTranslated.stripLabels.expr_1019]
    simp only [pExpr, PegHs.LabelCheck.stripExpr]
    exact strip_expr x
  | EDiscard x | EStar x | EPlus x | EOpt x | EAnd x | ENot x | ECapture x =>
    rw [LabelsTranslated.stripLabels.expr_1019]
    simp only [pExpr, PegHs.LabelCheck.stripExpr]
    rw [strip_expr x]
  | _ =>
    rw [LabelsTranslated.stripLabels.expr_1019] <;> simp [pExpr, PegHs.LabelCheck.stripExpr]
termination_by sizeOf e
theorem strip_items (is : List TItem) :
    pItems (is.map LabelsTranslated.stripLabels.item_1018) = PegHs.LabelCheck.stripItems (pItems is) := by
  match is with
  | [] => simp [pItems, PegHs.LabelCheck.stripItems]
  | .Item l b x :: rest =>
    simp only [List.map, pItems, pItem, PegHs.LabelCheck.stripItems]
    rw [LabelsTranslated.stripLabels.item_1018]
    simp only [LabelsTranslated.Item.itemLoc, LabelsTranslated.Item.itemBind,
      LabelsTranslated.Item.itemExpr, pItem]
    rw [strip_expr x, strip_items rest]
termination_by sizeOf is
theorem strip_alts (alts : List (List TItem)) :
    pAlts (alts.map (fun a => a.map (fun i => LabelsTranslated.stripLabels.item_1018 i))) =
      PegHs.LabelCheck.stripAlts (pAlts alts) := by
  match alts with
  | [] => simp [pAlts, PegHs.LabelCheck.stripAlts]
  | a :: rest =>
    simp only [List.map, pAlts, PegHs.LabelCheck.stripAlts]
    have h : pItems (a.map (fun i => LabelsTranslated.stripLabels.item_1018 i)) =
        PegHs.LabelCheck.stripItems (pItems a) := strip_items a
    rw [h, strip_alts rest]
termination_by sizeOf alts
end

theorem hsElem_contains (x : String) (xs : List String) : HsList.elem x xs = xs.contains x := by
  induction xs with
  | nil => rfl
  | cons y ys ih =>
    simp only [HsList.elem, List.any_cons, List.contains_cons] at ih ⊢
    rw [ih]
    by_cases h : x = y
    · simp [h]
    · have h1 : (y == x) = false := by simpa using Ne.symm h
      have h2 : (x == y) = false := by simpa using h
      rw [h1, h2]

theorem recovery_go (seen : List String) (rs : List (LabelsTranslated.Located String)) :
    (LabelsTranslated.stripLabels.go_1009 seen rs).map pLocated =
      PegHs.LabelCheck.recoveryGo seen (rs.map pLocated) := by
  induction rs generalizing seen with
  | nil => rw [LabelsTranslated.stripLabels.go_1009]; simp [PegHs.LabelCheck.recoveryGo]
  | cons r rs ih =>
    cases r with
    | Located l x =>
      rw [LabelsTranslated.stripLabels.go_1009]
      simp only [LabelsTranslated.Located.unLoc, List.map, pLocated, PegHs.LabelCheck.recoveryGo,
        hsElem_contains]
      split <;> simp_all [pLocated]

theorem start_name (g : LabelsTranslated.Grammar) :
    (match (g.grammarStart, g.grammarRules) with
      | (some s, _) => LabelsTranslated.Located.unLoc s
      | (none, r :: _) => LabelsTranslated.Rule.ruleName r
      | _ => "") = PegHs.LabelCheck.startName (pGrammar g) := by
  rcases g with ⟨_, _, _, start, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, rules⟩
  cases start with
  | some s => cases s; simp [LabelsTranslated.Grammar.grammarStart, PegHs.LabelCheck.startName, pGrammar, pLocated, LabelsTranslated.Located.unLoc]
  | none =>
    cases rules with
    | nil => simp [LabelsTranslated.Grammar.grammarStart, LabelsTranslated.Grammar.grammarRules, PegHs.LabelCheck.startName, pGrammar]
    | cons r _ =>
      cases r
      simp [LabelsTranslated.Grammar.grammarStart, LabelsTranslated.Grammar.grammarRules, PegHs.LabelCheck.startName, pGrammar, pRule, LabelsTranslated.Rule.ruleName]

theorem strip_rule (r : LabelsTranslated.Rule) :
    pRule (LabelsTranslated.Rule.Rule r.ruleName r.ruleLoc r.ruleParams r.ruleTemplateParams r.ruleType
        r.ruleAnnotation (r.ruleAlts.map (fun a => LabelsTranslated.stripLabels.alt_1017 a))) =
      { pRule r with alts := (pRule r).alts.map (fun a => { a with items := PegHs.LabelCheck.stripItems a.items }) } := by
  cases r with
  | Rule n l ps tps ty ann alts =>
    simp only [pRule, LabelsTranslated.Rule.ruleName, LabelsTranslated.Rule.ruleParams,
      LabelsTranslated.Rule.ruleAlts, List.map_map]
    congr 1
    apply List.map_congr_left
    intro a _
    cases a with
    | Alt l is act con =>
      simp only [Function.comp, LabelsTranslated.stripLabels.alt_1017, pAlt, LabelsTranslated.Alt.altLoc,
        LabelsTranslated.Alt.altItems]
      have h : pItems (is.map (fun i => LabelsTranslated.stripLabels.item_1018 i)) =
          PegHs.LabelCheck.stripItems (pItems is) := strip_items is
      rw [h]

theorem recovers_snd (recovers : List (LabelsTranslated.Located String × LabelsTranslated.Located String)) :
    (HsList.concatMap (fun p => [p.2]) recovers).map pLocated = (recovers.map pPair).map (·.2) := by
  induction recovers with
  | nil => rfl
  | cons p ps ih => simp_all [HsList.concatMap, pPair]

theorem strip_rules (rules : List LabelsTranslated.Rule) :
    (HsList.concatMap (fun r => [LabelsTranslated.Rule.Rule r.ruleName r.ruleLoc r.ruleParams r.ruleTemplateParams
        r.ruleType r.ruleAnnotation (r.ruleAlts.map (fun a => LabelsTranslated.stripLabels.alt_1017 a))]) rules).map pRule =
      (rules.map pRule).map (fun r => { r with alts := r.alts.map (fun a => { a with items := PegHs.LabelCheck.stripItems a.items }) }) := by
  induction rules with
  | nil => rfl
  | cons r rs ih =>
    simp only [HsList.concatMap, List.flatMap_cons, List.map_cons, List.singleton_append] at ih ⊢
    rw [strip_rule r, ih]

theorem entries_unLoc (entries : List (LabelsTranslated.Located String)) :
    entries.map LabelsTranslated.Located.unLoc = (entries.map pLocated).map (·.2) := by
  induction entries with
  | nil => rfl
  | cons e es ih => cases e; simp_all [pLocated, LabelsTranslated.Located.unLoc]

/-- The translated `stripLabels` is the model's, under the projection. -/
theorem stripLabels_translated (g : LabelsTranslated.Grammar) :
    pGrammar (LabelsTranslated.stripLabels g) = PegHs.LabelCheck.stripLabels (pGrammar g) := by
  rcases g with ⟨md, imps, lib, start, entries, ex, env, tab, nomemo, langs, syn, toks, triv, inl, recovers,
    safe, expects, messages, der, verb, rules⟩
  have hr := recovers_snd recovers
  have hu := strip_rules rules
  have he := entries_unLoc entries
  simp only [LabelsTranslated.stripLabels, LabelsTranslated.Grammar.grammarModule,
    LabelsTranslated.Grammar.grammarStart, LabelsTranslated.Grammar.grammarEntries,
    LabelsTranslated.Grammar.grammarRecovers, LabelsTranslated.Grammar.grammarSafe,
    LabelsTranslated.Grammar.grammarMessages, LabelsTranslated.Grammar.grammarRules,
    LabelsTranslated.Grammar.grammarImports, LabelsTranslated.Grammar.grammarLibrary,
    LabelsTranslated.Grammar.grammarExports, LabelsTranslated.Grammar.grammarEnv,
    LabelsTranslated.Grammar.grammarTabstop, LabelsTranslated.Grammar.grammarNoMemo,
    LabelsTranslated.Grammar.grammarLanguages, LabelsTranslated.Grammar.grammarSyntax,
    LabelsTranslated.Grammar.grammarTokens, LabelsTranslated.Grammar.grammarTrivia,
    LabelsTranslated.Grammar.grammarInline, LabelsTranslated.Grammar.grammarExpects,
    LabelsTranslated.Grammar.grammarDeriving, LabelsTranslated.Grammar.grammarVerbatim,
    pGrammar, PegHs.LabelCheck.stripLabels, PegHs.LabelCheck.recoveryEntries, HsList.append,
    List.map_append, List.map_nil]
  rw [recovery_go, hr, hu, he]
  cases start with
  | some s =>
    cases s
    simp [PegHs.LabelCheck.startName, pLocated, LabelsTranslated.Located.unLoc]
  | none =>
    cases rules with
    | nil => simp [PegHs.LabelCheck.startName]
    | cons r rs =>
      cases r
      simp [PegHs.LabelCheck.startName, pRule, LabelsTranslated.Rule.ruleName]

/-- The translated `stripLabelsAs` is the model's, under the projection. -/
theorem stripLabelsAs_translated (m : String) (g : LabelsTranslated.Grammar) :
    pGrammar (LabelsTranslated.stripLabelsAs m g) = PegHs.LabelCheck.stripLabelsAs m (pGrammar g) := by
  have h := stripLabels_translated g
  have hmod : (LabelsTranslated.stripLabels g).grammarModule = g.grammarModule := by
    simp [LabelsTranslated.stripLabels, LabelsTranslated.Grammar.grammarModule]
  unfold LabelsTranslated.stripLabelsAs PegHs.LabelCheck.stripLabelsAs
  rw [← h]
  generalize LabelsTranslated.stripLabels g = s at hmod
  rcases s with ⟨md, _⟩
  rcases g with ⟨md', _⟩
  simp only [LabelsTranslated.Grammar.grammarModule] at hmod
  subst hmod
  cases md
  rfl

/-- The translated `stripLabels` leaves a template call, with its arguments,
as it is: it does not remove labels inside template arguments (README L4). -/
theorem stripLabels_template_args (l : LabelsTranslated.Loc) (n : String) (as : List TExpr)
    (vs : List (LabelsTranslated.Located String)) :
    LabelsTranslated.stripLabels.expr_1019 (.ETemplate l n as vs) = .ETemplate l n as vs := by
  rw [LabelsTranslated.stripLabels.expr_1019] <;> simp

end PegHs.LabelsTranslatedProof
