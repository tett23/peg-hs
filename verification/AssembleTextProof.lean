import AssembleTranslated
import AssembleValidation

/-!
Characters and texts of the translation of Peg.Grammar.Assemble
(AssembleTranslated, generated by TranslateHaskell.hs) against the models
of AssemblePredicates and AssembleValidationHelpers.

The translation reads a `Text` (a Lean `String`) through `HsText.unpack`,
which maps each character to its code point (`HsChar.ofChar`), and builds a
`Text` with `HsText.pack`, which maps a code point back. The lemmas here move
between the two, and identify the character classes of HsPrelude (rule H10)
with the tables of AssembleChars and with `ghcIsSpace` of Whitespace.
-/

namespace PegHs.AssembleTextProof

/-! ## Code points and characters -/

theorem toChar_ofChar (c : Char) : HsText.toChar (HsChar.ofChar c) = c := by
  have valid : c.toNat.isValidChar := c.valid
  simp [HsText.toChar, HsChar.ofChar, valid, Char.ofNat_toNat]

theorem pack_map_ofChar (cs : List Char) : HsText.pack (cs.map HsChar.ofChar) = String.ofList cs := by
  simp [HsText.pack, Function.comp_def, toChar_ofChar]

theorem unpack_eq (s : String) : HsText.unpack s = s.toList.map HsChar.ofChar := rfl

theorem pack_unpack (s : String) : HsText.pack (HsText.unpack s) = s := by
  simp [unpack_eq, pack_map_ofChar, String.ofList_toList]

theorem ofChar_inj {c d : Char} : HsChar.ofChar c = HsChar.ofChar d ↔ c = d := by
  constructor
  · intro h
    exact Char.toNat_inj.mp (congrArg HsChar.val h)
  · intro h; rw [h]

theorem ofChar_eq_ofNat (c : Char) (n : Nat) (lt : n < 0x110000) :
    HsChar.ofChar c = HsChar.ofNat n ↔ c.toNat = n := by
  simp only [HsChar.ofChar, HsChar.ofNat, lt, dite_true]
  constructor
  · intro h; exact congrArg HsChar.val h
  · intro h; cases h; rfl

/-- `HsBase.eq` of a character and a character literal. -/
theorem eq_ofChar_ofNat (c : Char) (n : Nat) (lt : n < 0x110000) :
    HsBase.eq (HsChar.ofChar c) (HsChar.ofNat n) = decide (c.toNat = n) := by
  rw [HsBase.eq, Bool.eq_iff_iff, beq_iff_eq, decide_eq_true_iff]
  exact ofChar_eq_ofNat c n lt

theorem ofChar_val (c : Char) : (HsChar.ofChar c).val = c.toNat := rfl

theorem toNat_ofNat_valid (n : Nat) (h : n.isValidChar) : (Char.ofNat n).toNat = n := by
  simp only [Char.ofNat, h, dite_true]
  rfl

/-- `HsBase.eq` of a character and a character literal, as Lean's `==`. -/
theorem eq_ofChar_lit (c : Char) (n : Nat) (h : n.isValidChar) :
    HsBase.eq (HsChar.ofChar c) (HsChar.ofNat n) = (c == Char.ofNat n) := by
  have lt : n < 0x110000 := by simp [Nat.isValidChar] at h; omega
  rw [eq_ofChar_ofNat c n lt, Bool.eq_iff_iff, decide_eq_true_iff, beq_iff_eq]
  constructor
  · intro e; rw [← Char.toNat_inj, e, toNat_ofNat_valid n h]
  · intro e; rw [e, toNat_ofNat_valid n h]

/-! ## Character classes (rule H10 against the AssembleChars tables) -/

theorem inRangesNat_eq (rs : List (Nat × Nat)) (c : Char) :
    inRangesNat rs c.toNat = AssembleChars.inRanges rs c := by
  simp [inRangesNat, AssembleChars.inRanges]

theorem isAlpha_ofChar (c : Char) : HsChar.isAlpha (HsChar.ofChar c) = AssembleChars.isAlpha c :=
  inRangesNat_eq _ c

theorem isAlphaNum_ofChar (c : Char) :
    HsChar.isAlphaNum (HsChar.ofChar c) = AssembleChars.isAlphaNum c :=
  inRangesNat_eq _ c

theorem isUpper_ofChar (c : Char) : HsChar.isUpper (HsChar.ofChar c) = AssembleChars.isUpper c :=
  inRangesNat_eq _ c

theorem modifier_ofChar (c : Char) :
    HsBase.eq (HsChar.generalCategory (HsChar.ofChar c)) HsGeneralCategory.ModifierLetter =
      AssembleChars.isModifier c := by
  rw [HsBase.eq, Bool.eq_iff_iff, beq_iff_eq]
  exact (HsGeneralCategory.ofCode_modifier_iff c.toNat).trans
    (by simp [AssembleChars.isModifier, AssembleChars.inRanges])

/-- The code points of `ghcSpaceChars`. -/
def spaceCodes : List Nat :=
  [9, 10, 11, 12, 13, 32, 160, 0x1680] ++ (List.range 11).map (0x2000 + ·) ++
    [0x202f, 0x205f, 0x3000]

theorem ghcIsSpace_iff (c : Char) :
    PegVerification.ghcIsSpace c = true ↔ c.toNat ∈ spaceCodes := by
  have valid : ∀ n ∈ spaceCodes, (Char.ofNat n).toNat = n := by decide
  simp only [PegVerification.ghcIsSpace, PegVerification.ghcSpaceChars, List.contains_iff_mem,
    List.mem_map]
  constructor
  · rintro ⟨n, hn, rfl⟩
    rw [valid n hn]
    exact hn
  · intro h
    exact ⟨c.toNat, h, Char.ofNat_toNat c⟩

theorem isSpace_ofChar (c : Char) :
    HsChar.isSpace (HsChar.ofChar c) = PegVerification.ghcIsSpace c := by
  rw [Bool.eq_iff_iff, ghcIsSpace_iff]
  show inRangesNat spaceRanges c.toNat = true ↔ _
  simp [inRangesNat, spaceRanges, spaceCodes, List.range_succ]
  omega

theorem isSpaceChar_eq : isSpaceChar = PegVerification.ghcIsSpace := by
  funext c
  exact isSpace_ofChar c

/-! ## Texts -/

theorem null_eq (s : String) : HsText.null s = s.isEmpty := by
  rw [Bool.eq_iff_iff]
  simp [HsText.null, String.isEmpty_iff, String.toList_eq_nil_iff]

theorem strip_eq (s : String) :
    HsText.strip s = String.ofList (AssembleValidationHelpers.stripSpace s.toList) := by
  simp [HsText.strip, AssembleValidationHelpers.stripSpace, isSpaceChar_eq]

/-- T.words is the model's `words`. -/
theorem wordsList_eq (cur cs : List Char) :
    (HsText.wordsList cur cs).map String.ofList = AssembleValidation.wordsGo cur cs := by
  induction cs generalizing cur with
  | nil => cases cur <;> simp [HsText.wordsList, AssembleValidation.wordsGo]
  | cons c cs ih =>
    simp only [HsText.wordsList, AssembleValidation.wordsGo, isSpaceChar_eq]
    split
    · cases cur <;> simp [ih]
    · exact ih (c :: cur)

theorem words_eq (s : String) : HsText.words s = AssembleValidation.words s :=
  wordsList_eq [] s.toList

/-! ## Splitting at a character -/

theorem splitOnChar_eq (c : Char) (xs : List Char) :
    AssembleValidation.splitOnChar c xs = xs.splitOn c := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    rw [List.splitOn_cons_eq_ite_modifyHead, AssembleValidation.splitOnChar, ← ih]
    split
    · rename_i h
      have : (x == c) = true := by simpa using h
      simp
    · rename_i h
      rw [ih]
      cases h' : List.splitOn c xs with
      | nil => exact absurd h' (List.splitOn_ne_nil _ _)
      | cons => rfl

theorem breakOnList_single (c : Char) (xs : List Char) :
    HsText.breakOnList [c] xs = (xs.takeWhile (· != c), xs.dropWhile (· != c)) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [HsText.breakOnList, List.isPrefixOf, List.takeWhile_cons, List.dropWhile_cons, ih]
    by_cases h : x = c
    · simp [h]
    · simp [h, Ne.symm h]

theorem splitOn_takeWhile (c : Char) (xs : List Char) :
    xs.splitOn c = (xs.takeWhile (· != c)) ::
      (match xs.dropWhile (· != c) with
       | [] => []
       | _ :: rest => rest.splitOn c) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    rw [List.splitOn_cons_eq_ite_modifyHead]
    by_cases h : x = c
    · subst h; simp
    · have hb : (x == c) = false := by simpa using h
      simp only [hb, Bool.false_eq_true, ite_false, ih, List.modifyHead_cons]
      simp [h]

theorem splitOnList_go_single (c : Char) (xs : List Char) (fuel : Nat) (enough : xs.length ≤ fuel) :
    HsText.splitOnList.go [c] xs fuel = xs.splitOn c := by
  induction fuel generalizing xs with
  | zero =>
    have : xs = [] := List.eq_nil_of_length_eq_zero (by omega)
    subst this; rfl
  | succ fuel ih =>
    rw [HsText.splitOnList.go, breakOnList_single, splitOn_takeWhile]
    simp only
    split
    · rename_i h
      have : xs.dropWhile (· != c) = [] := by simpa using h
      simp [this]
    · rename_i h
      cases hd : xs.dropWhile (· != c) with
      | nil => simp [hd] at h
      | cons y rest =>
        simp only [List.drop_one, List.tail_cons, List.cons.injEq, true_and, List.length_singleton]
        apply ih
        have := (List.dropWhile_sublist (l := xs) (· != c)).length_le
        rw [hd] at this
        simp at this
        omega

/-- T.splitOn at a one-character needle is Lean's `List.splitOn`. -/
theorem splitOn_single_eq (c : Char) (s : String) :
    HsText.splitOn (String.singleton c) s = (s.toList.splitOn c).map String.ofList := by
  simp [HsText.splitOn, HsText.splitOnList, splitOnList_go_single c s.toList s.toList.length (Nat.le_refl _)]

/-! ## The predicates of AssemblePredicates -/

open PegHs.AssembleValidation in
theorem isIdentChar_eq :
    (fun c => AssembleTranslated.isIdentChar (HsChar.ofChar c)) = identChar := by
  funext x
  simp only [AssembleTranslated.isIdentChar, identChar, HsBase.or, isAlphaNum_ofChar,
    eq_ofChar_lit _ 95 (by decide), eq_ofChar_lit _ 39 (by decide), Bool.or_assoc]

open PegHs.AssembleValidation in
theorem isValidIdent_eq (s : String) : AssembleTranslated.isValidIdent s = validIdent s := by
  unfold AssembleTranslated.isValidIdent validIdent
  simp only [HsText.uncons]
  cases s.toList with
  | nil => rfl
  | cons c cs =>
    simp only [HsText.all, String.toList_ofList, AssembleTranslated.isIdentStart, identStart,
      HsBase.or, HsBase.and, isAlpha_ofChar, eq_ofChar_lit _ 95 (by decide)]
    rw [← isIdentChar_eq]

open PegHs.AssembleValidation in
theorem startsWithModifier_eq (s : String) :
    AssembleTranslated.startsWithModifier s = startsWithModifier s := by
  unfold AssembleTranslated.startsWithModifier startsWithModifier
  simp only [HsText.uncons]
  cases s.toList with
  | nil => rfl
  | cons c cs => simp [HsBase.maybe, modifier_ofChar]

theorem reservedWords_eq : AssembleTranslated.Peg_Grammar_reservedWords = grammarReservedWords := by
  decide

open PegHs.AssembleValidation in
theorem foldl_step_eq (options names : List String) :
    HsList.foldl (fun enabled option => AssembleTranslated.assemble.step_244 names enabled option) false
      options = extensionEnabled names options := by
  unfold extensionEnabled
  simp only [HsList.foldl]
  congr 1
  funext enabled option
  simp only [AssembleTranslated.assemble.step_244, extensionFlag, HsList.elem, List.any_eq_true,
    beq_iff_eq]
  have app : HsText.append "No" = fun x => "No" ++ x := rfl
  simp only [app, exists_eq_right]
  split <;> (try split) <;> rfl

theorem elem_eq_contains {α : Type} [BEq α] [LawfulBEq α] (x : α) (xs : List α) :
    HsList.elem x xs = xs.contains x := by
  rw [Bool.eq_iff_iff]
  simp [HsList.elem, List.any_eq_true]

open PegHs.AssembleValidation in
theorem extensionKeyword_eq (options : List String) (name : String) :
    AssembleTranslated.extensionKeyword (recursiveDoEnabled options) (arrowsEnabled options) name =
      extensionKeyword options name := by
  simp only [AssembleTranslated.extensionKeyword, extensionKeyword, HsBase.or, HsBase.and,
    elem_eq_contains]

open PegHs.AssembleValidation in
theorem classPart_eq (cs : List Char) :
    AssembleTranslated.isClassName.part_459 (String.ofList cs) = classPart cs := by
  unfold AssembleTranslated.isClassName.part_459
  simp only [HsText.uncons, String.toList_ofList]
  cases cs with
  | nil => rfl
  | cons c cs =>
    simp only [classPart, HsBase.and, HsText.all, String.toList_ofList, isUpper_ofChar]
    rw [← isIdentChar_eq]

open PegHs.AssembleValidation in
theorem isClassName_eq (s : String) : AssembleTranslated.isClassName s = validClass s := by
  unfold AssembleTranslated.isClassName validClass
  have dot : (".") = String.singleton '.' := rfl
  rw [dot, splitOn_single_eq, splitOnChar_eq]
  simp [HsBase.and, HsBase.not, HsList.all, null_eq, List.all_map, Function.comp_def, classPart_eq]

theorem isModuleName_eq (s : String) :
    AssembleTranslated.isModuleName s = AssembleValidation.validModule s :=
  isClassName_eq s

end PegHs.AssembleTextProof
