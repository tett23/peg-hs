  · simp [h]
  · simp only [List.map_eq_nil_iff, h, ite_false, Option.some.injEq, ne_eq, not_false_eq_true, true_and,
      List.length_map]
    exact ⟨Eq.symm, Eq.symm⟩

theorem defCounts_member (items : List Top) (n : String) :
