theorem unique_getLast (items : List Top) (hu : ∀ n, (defsNamed items n).length ≤ 1) (n : String) l tns
    (h : (l, tns) ∈ defsNamed items n) : (defsNamed items n).getLast? = some (l, tns) := by
  have := hu n
  generalize defsNamed items n = L at this h
  rcases L with _ | ⟨a, _ | ⟨b, rest⟩⟩
  · simp at h
  · simp at h; simp [h]
  · simp at this

theorem unique_templateNames (items : List Top) (hu : ∀ n, (defsNamed items n).length ≤ 1)
    (d : String × List String) (hd : d ∈ AssembleValidation.definitions (view items)) :
    assemble.templateNamesOf_297 items d.1 = d.2 := by
  obtain ⟨⟨l, tns⟩, hm, e⟩ := List.mem_map.mp ((mem_definitions items d).mp hd)
  simp only at e
  subst e
  rw [templateNamesOf_eq, unique_getLast items hu _ _ _ hm]
  rfl

