theorem known_eq : assemble.known_257 = AssembleValidation.known := rfl

theorem notElem_eq_contains {α : Type} [BEq α] [LawfulBEq α] (x : α) (xs : List α) :
    HsList.notElem x xs = !xs.contains x := by
  rw [HsList.notElem, ← HsList.elem, elem_eq_contains]

theorem flatMap_if_single {α : Type} (P : α → Prop) [DecidablePred P] (xs : List α) :
    xs.flatMap (fun x => if P x then [x] else []) = xs.filter (fun x => decide (P x)) := by
  induction xs with
  | nil => rfl
  | cons x xs ih => by_cases h : P x <;> simp [h, ih]

theorem nodup_filter_contains (S ns : List String) :
    (ns.filter (fun n => S.contains n)).Nodup ↔ ∀ n ∈ S, (ns.filter (· == n)).length ≤ 1 := by
  rw [List.nodup_iff_count]
  constructor
  · intro h n hn
    have := h n
    rwa [List.count_filter (by simpa using hn), List.count_eq_length_filter] at this
  · intro h a
    by_cases ha : a ∈ S
    · rw [List.count_filter (by simpa using ha), List.count_eq_length_filter]
      exact h a ha
    · have : List.count a (ns.filter (fun n => S.contains n)) = 0 :=
        List.count_eq_zero.mpr (by simp [ha])
      omega

/-- The two sides of a condition on a list of items agree after simp. -/
macro "agree" h:term : tactic => `(tactic|
  simpa [List.filter_eq_nil_iff, List.forall_mem_map, -List.mem_map, -Prod.forall] using $h)

attribute [local simp] notElem_eq_contains elem_eq_contains HsBase.not HsBase.and HsBase.or HsBase.eq HsBase.ne
  null_eq known_eq isImportPath_eq isValidIdent_eq isModuleName_eq isClassName_eq isExtensionName_eq
  words_eq String.isEmpty_iff

theorem filter_eq_filterMap {α : Type} (p : α → Bool) (l : List α) :
    l.filter p = l.filterMap (fun a => if p a then some a else none) := by
  induction l with
  | nil => rfl
  | cons a l ih => by_cases h : p a <;> simp [h, ih]

/-- No element of a list is among the ones before it (zip [0 ..] and take
in Assemble.hs), against `Nodup` of the model. -/
theorem zipFrom_take_iff {β : Type} (xs : List β) (g : β → String) (p : String → Bool) :
    (∀ x ∈ HsList.zipFrom 0 xs, p (g x.2) = true → g x.2 ∉ (HsList.take x.1 xs).map g) ↔
      ((xs.map g).filter p).Nodup := by
  rw [filter_eq_filterMap, nodup_filterMap_iff]
  constructor
  · intro h i hi b hb
    simp only [List.getElem_map] at hb
    split at hb
    · rename_i hp
      cases hb
      have := h (i, xs[i]'(by simpa using hi)) ((mem_zipFrom _ _ _ _).mpr ⟨i, by simpa using hi, by simp, rfl⟩) hp
      simp only [HsList.take, Int.toNat_natCast] at this
      rw [← List.map_take, ← filter_eq_filterMap]
      intro m
      exact this (List.mem_filter.mp m).1
    · cases hb
  · intro h x hx hp hm
    obtain ⟨k, y⟩ := x
    obtain ⟨i, hi, hk, hy⟩ := (mem_zipFrom _ _ _ _).mp hx
    simp only at hp hm
    subst hk hy
    have := h i (by simpa using hi) (g xs[i]) (by simp [hp])
    apply this
    rw [← List.map_take, ← filter_eq_filterMap, List.mem_filter]
    simp only [HsList.take, Int.zero_add, Int.toNat_natCast] at hm
    exact ⟨hm, hp⟩

theorem string_ok (items : List Top) (d : String) :
    (∀ x ∈ assemble.stringArgs_274 items d, x.2.toBool = true) ↔
      ∀ r ∈ AssembleValidation.stringResults (AssembleValidation.directives (view items)) d, r.toBool = true := by
  have h := stringArgs_view items d
  have outcome : ∀ r, (stringOutcome r).toBool = r.toBool := by
    intro r; rcases r with _ | ⟨_, _⟩ <;> rfl
  have mapError : ∀ (r : Except String String), (r.mapError (fun _ => ())).toBool = r.toBool := by
    intro r; cases r <;> rfl
  constructor
  · intro hx r hr
    have : r.mapError (fun _ => ()) ∈ (assemble.stringArgs_274 items d).map (fun x => stringOutcome x.2) := by
      rw [h]; exact List.mem_map_of_mem hr
    obtain ⟨x, hx', e⟩ := List.mem_map.mp this
    rw [← mapError, ← e, outcome]
    exact hx x hx'
  · intro hr x hx
    have : stringOutcome x.2 ∈ (AssembleValidation.stringResults (AssembleValidation.directives (view items)) d).map
        (·.mapError (fun _ => ())) := by
      rw [← h]; exact List.mem_map_of_mem hx
    obtain ⟨r, hr', e⟩ := List.mem_map.mp this
    rw [← outcome, ← e, mapError]
    exact hr r hr'

/-- The name of a string argument that assemble reads. -/
def okName (x : Loc × Except Diagnostic (Located String × Located String)) : Option String :=
  match x.2 with
  | .ok (n, _) => some (Located.unLoc n)
  | .error _ => none

theorem parsedNames_eq (items : List Top) (d : String) :
    AssembleValidation.parsedNames (AssembleValidation.stringResults (AssembleValidation.directives (view items)) d) =
      (assemble.stringArgs_274 items d).filterMap okName := by
  have h := stringArgs_view items d
  let g : Except Unit String → Option String := fun r => match r with
    | .ok n => some n
    | .error _ => none
  have model : AssembleValidation.parsedNames (AssembleValidation.stringResults (AssembleValidation.directives (view items)) d) =
      ((AssembleValidation.stringResults (AssembleValidation.directives (view items)) d).map
        (·.mapError (fun _ => ()))).filterMap g := by
    unfold AssembleValidation.parsedNames
    rw [List.filterMap_map]
    congr 1
    funext r
    cases r <;> rfl
  rw [model, ← h, List.filterMap_map]
  congr 1
  funext x
  obtain ⟨l, r⟩ := x
  rcases r with _ | ⟨n, v⟩ <;> rfl

/-! ## Rules: definitions and annotations -/

section
open AssembleValidation

theorem view_cons (t : AssembleTranslated.Top) (ts : List AssembleTranslated.Top) :
    view (t :: ts) = topView t :: view ts := rfl

theorem definitions_definition (n : String) ps alts xs :
    definitions (.definition n ps alts :: xs) = (n, ps) :: definitions xs := rfl
theorem definitions_annotation (n : String) ps params xs :
    definitions (.annotation n ps params :: xs) = definitions xs := rfl
theorem definitions_directive (n a : String) xs : definitions (.directive n a :: xs) = definitions xs := rfl
theorem definitions_verbatim xs : definitions (.verbatim :: xs) = definitions xs := rfl
theorem annotations_definition (n : String) ps alts xs :
    annotations (.definition n ps alts :: xs) = annotations xs := rfl
theorem annotations_annotation (n : String) ps params xs :
    annotations (.annotation n ps params :: xs) = (n, ps) :: annotations xs := rfl
theorem annotations_directive (n a : String) xs : annotations (.directive n a :: xs) = annotations xs := rfl
theorem annotations_verbatim xs : annotations (.verbatim :: xs) = annotations xs := rfl

theorem defsNamed_cons (t : AssembleTranslated.Top) (ts : List AssembleTranslated.Top) (n : String) :
    defsNamed (t :: ts) n = (match t with
      | AssembleTranslated.Top.TDef l n' tns _ => if n' = n then [(l, tns)] else []
      | _ => []) ++ defsNamed ts n := rfl

theorem annsNamed_cons (t : AssembleTranslated.Top) (ts : List AssembleTranslated.Top) (n : String) :
    annsNamed (t :: ts) n = (match t with
      | AssembleTranslated.Top.TAnnot l n' ps tps ty => if n' = n then [(l, ps, tps, ty)] else []
      | _ => []) ++ annsNamed ts n := rfl

end

theorem defs_view (items : List Top) :
    (assemble.defs_287 items).map (·.2.1) = (AssembleValidation.definitions (view items)).map (·.1) := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp_all [assemble.defs_287, HsList.concatMap, view_cons, topView,
      definitions_definition, definitions_annotation, definitions_directive, definitions_verbatim]

theorem defsNamed_length (items : List Top) (n : String) :
    (defsNamed items n).length = ((AssembleValidation.definitions (view items)).map (·.1)).count n := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp only [defsNamed_cons, view_cons, topView, definitions_definition, definitions_annotation,
      definitions_directive, definitions_verbatim, List.nil_append, ih]
    rename_i n' _ _
    by_cases h : n' = n <;> simp [h, ih] <;> omega

theorem defsFilter_length (items : List Top) (n : String) :
    ((assemble.defs_287 items).filter (fun x => decide (x.2.1 = n))).length = (defsNamed items n).length := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    have e : assemble.defs_287 (t :: ts) = (match t with
        | .TDef l n _ alts => [(l, n, alts)]
        | _ => []) ++ assemble.defs_287 ts := by
      cases t <;> rfl
    rw [e, defsNamed_cons, List.filter_append, List.length_append, List.length_append, ih]
    cases t <;> simp
    rename_i n' _ _
    by_cases h : n' = n <;> simp [h]

theorem annsNamed_length (items : List Top) (n : String) :
    (annsNamed items n).length = ((AssembleValidation.annotations (view items)).map (·.1)).count n := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp only [annsNamed_cons, view_cons, topView, annotations_definition, annotations_annotation,
      annotations_directive, annotations_verbatim, List.nil_append, ih]
    rename_i n' _ _ _
    by_cases h : n' = n <;> simp [h, ih] <;> omega

theorem annotations_find (items : List Top) (n : String) :
    (AssembleValidation.annotations (view items)).find? (·.1 == n) =
      (annsNamed items n).head?.map (fun a => (n, a.2.2.1.map TemplateParam.templateParamName)) := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp only [annsNamed_cons, view_cons, topView, annotations_definition, annotations_annotation,
      annotations_directive, annotations_verbatim, List.nil_append, ih]
    rename_i n' _ _ _
    by_cases h : n' = n
    · subst h; simp
    · simp [h, ih]

theorem mem_definitions (items : List Top) (d : String × List String) :
    d ∈ AssembleValidation.definitions (view items) ↔ d.2 ∈ (defsNamed items d.1).map (·.2) := by
  induction items with
  | nil => simp [AssembleValidation.definitions, view, defsNamed]
  | cons t ts ih =>
    cases t <;> simp only [defsNamed_cons, view_cons, topView, definitions_definition, definitions_annotation,
      definitions_directive, definitions_verbatim, List.nil_append, ih]
    rename_i n' tns _
    obtain ⟨n, ps⟩ := d
    by_cases h : n' = n
    · subst h
      simp only [List.mem_cons, Prod.mk.injEq, true_and, List.mem_map] at ih ⊢
      rw [ih]
      simp only [ite_true, List.singleton_append, List.mem_cons, exists_eq_or_imp]
      exact or_congr ⟨Eq.symm, Eq.symm⟩ Iff.rfl
    · simpa [h, Ne.symm h] using ih

theorem annsNamed_mem (items : List Top) (n : String) l ps tps ty :
    (l, ps, tps, ty) ∈ annsNamed items n ↔ Top.TAnnot l n ps tps ty ∈ items := by
  induction items with
  | nil => simp [annsNamed]
  | cons t ts ih =>
    rw [annsNamed_cons, List.mem_append, ih, List.mem_cons]
    cases t <;> simp
    rename_i l' n' ps' tps' ty'
    by_cases h : n' = n
    · subst h
      constructor <;> rintro (h | h) <;> simp_all
    · simp [h, Ne.symm h]

theorem elems_annots_mem (items : List Top) anns :
    anns ∈ HsMap.elems (assemble.annots_286 items) ↔ ∃ n, annsNamed items n ≠ [] ∧ anns = annsNamed items n := by
  rw [HsMap.mem_elems]
  simp [annots_mem]

theorem annotationParams_mem (items : List Top) (name : String) :
    name ∈ AssembleValidation.annotationParams (view items) ↔
      ∃ l n ps tps ty, Top.TAnnot l n ps tps ty ∈ items ∧ ∃ p ∈ ps, Param.paramName p = name := by
  simp only [AssembleValidation.annotationParams, view, List.flatMap_map, List.mem_flatMap]
  constructor
  · rintro ⟨t, ht, hn⟩
    cases t <;> simp [topView] at hn
    exact ⟨_, _, _, _, _, ht, hn⟩
  · rintro ⟨l, n, ps, tps, ty, ht, hn⟩
    exact ⟨_, ht, by simpa [topView] using hn⟩

theorem mem_defs (items : List Top) x :
    x ∈ assemble.defs_287 items ↔ ∃ tns, Top.TDef x.1 x.2.1 tns x.2.2 ∈ items := by
  simp only [assemble.defs_287, HsList.concatMap, List.mem_flatMap]
  constructor
  · rintro ⟨t, ht, hx⟩
    cases t <;> simp at hx
    subst hx
    exact ⟨_, ht⟩
  · rintro ⟨tns, ht⟩
    exact ⟨_, ht, by simp⟩

theorem definitionBinders_mem (items : List Top) (name : String) :
    name ∈ AssembleValidation.definitionBinders (view items) ↔
      ∃ x ∈ assemble.defs_287 items, ∃ alt ∈ x.2.2, ∃ i ∈ (Alt.altItems alt).flatMap assemble.nestedItems_405,
        Item.itemBind i = some name := by
  have e : ∀ alt : Alt, (∃ tree ∈ itemsTree alt.altItems, name ∈ tree.names) ↔
      ∃ i ∈ (Alt.altItems alt).flatMap assemble.nestedItems_405, Item.itemBind i = some name := by
    intro alt
    rw [← List.mem_flatMap, ← nested_items, List.mem_filterMap]
  have d : ∀ t : Top, (name ∈ (match topView t with
      | .definition _ _ alternatives => AssembleValidation.altBinders alternatives
      | _ => [])) ↔ ∃ l n tns alts, t = Top.TDef l n tns alts ∧
        ∃ alt ∈ alts, ∃ tree ∈ itemsTree alt.altItems, name ∈ tree.names := by
    intro t
    cases t
    case TDef l n tns alts =>
      simp only [topView, AssembleValidation.altBinders, List.mem_flatMap, List.mem_map]
      constructor
      · rintro ⟨_, ⟨alt, halt, rfl⟩, tree, ht, hn⟩
        exact ⟨_, _, _, _, rfl, alt, halt, tree, ht, hn⟩
      · rintro ⟨l', n', tns', alts', e, alt, halt, tree, ht, hn⟩
        cases e
        exact ⟨_, ⟨alt, halt, rfl⟩, tree, ht, hn⟩
    all_goals simp [topView]
  constructor
  · intro h
    simp only [AssembleValidation.definitionBinders, view, List.flatMap_map, List.mem_flatMap] at h
    obtain ⟨t, ht, hn⟩ := h
    obtain ⟨l, n, tns, alts, rfl, alt, halt, hb⟩ := (d t).mp hn
    exact ⟨(l, n, alts), (mem_defs items _).mpr ⟨tns, ht⟩, alt, halt, (e alt).mp hb⟩
  · rintro ⟨x, hx, alt, halt, hb⟩
    obtain ⟨tns, ht⟩ := (mem_defs items x).mp hx
    simp only [AssembleValidation.definitionBinders, view, List.flatMap_map, List.mem_flatMap]
    exact ⟨_, ht, (d _).mpr ⟨x.1, x.2.1, tns, x.2.2, rfl, alt, halt, (e alt).mpr hb⟩⟩

theorem defsNamed_mem (items : List Top) (n : String) l tns :
    (l, tns) ∈ defsNamed items n ↔ ∃ alts, Top.TDef l n tns alts ∈ items := by
  induction items with
  | nil => simp [defsNamed]
  | cons t ts ih =>
    rw [defsNamed_cons, List.mem_append, ih]
    cases t <;> simp
    rename_i l' n' tns' alts'
    by_cases h : n' = n
    · subst h
      constructor
      · rintro (h | ⟨alts, h⟩)
        · exact ⟨alts', Or.inl (by simp_all)⟩
        · exact ⟨alts, Or.inr h⟩
      · rintro ⟨alts, h | h⟩
        · exact Or.inl (by simp_all)
        · exact Or.inr ⟨alts, h⟩
    · simp [h, Ne.symm h]

theorem definitions_of_mem (items : List Top) l n tns alts (h : Top.TDef l n tns alts ∈ items) :
