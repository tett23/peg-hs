/-!
The translation of `Peg.Grammar.Assemble.assemble` (AssembleTranslated,
generated by TranslateHaskell.hs) against the model AssembleValidation.
-/

/-! ## Maps of HsPrelude (rule H4) -/

namespace HsMap

variable {κ ν : Type} [BEq κ] [LawfulBEq κ]

/-- The values of a key in a list of pairs, in order. -/
def valuesOf (xs : List (κ × ν)) (k : κ) : List ν := (xs.filter (·.1 == k)).map (·.2)

/-- The value of fromListWith for the values of one key. -/
def combined (f : ν → ν → ν) : List ν → Option ν
  | [] => none
  | v :: vs => some (vs.foldl (fun acc x => f x acc) v)

theorem combined_append (f : ν → ν → ν) (vs : List ν) (v : ν) :
    combined f (vs ++ [v]) = some (match combined f vs with
      | none => v
      | some a => f v a) := by
  cases vs <;> simp [combined, List.foldl_append]

/-- What fromListWith keeps of a prefix of its list. -/
structure Holds (f : ν → ν → ν) (m : HsMap κ ν) (pre : List (κ × ν)) : Prop where
  mem : ∀ k v, (k, v) ∈ m.pairs ↔ combined f (valuesOf pre k) = some v
  nodup : (m.pairs.map (·.1)).Nodup

theorem member_iff (m : HsMap κ ν) (k : κ) : member k m = true ↔ ∃ v, (k, v) ∈ m.pairs := by
  simp [member, List.any_eq_true]

theorem holds_insertWith (f : ν → ν → ν) (m : HsMap κ ν) (pre : List (κ × ν)) (k : κ) (v : ν)
    (h : Holds f m pre) : Holds f (insertWith f k v m) (pre ++ [(k, v)]) := by
  constructor
  · intro k' v'
    simp only [valuesOf, List.filter_append, List.map_append, List.filter_cons, List.filter_nil] at *
    have hm := h.mem
    simp only [valuesOf] at hm
    by_cases e : k = k'
    · subst e
      simp only [beq_self_eq_true, ite_true, List.map_cons, List.map_nil, combined_append]
      unfold insertWith
      split
      · rename_i mem
        obtain ⟨old, hold⟩ := (member_iff m k).mp mem
        have hc := (hm k old).mp hold
        rw [hc]
        simp only [List.mem_map, Option.some.injEq]
        constructor
        · rintro ⟨p, hp, eq⟩
          split at eq
          · rename_i pk
            have : p.1 = k := by simpa using pk
            have hp' : (k, p.2) ∈ m.pairs := by rw [← this]; exact hp
            have := (hm k p.2).mp hp'
            rw [hc] at this
            cases this
            simp at eq
            exact eq
          · rename_i pk
            subst eq
            simp at pk
        · intro eq
          refine ⟨(k, old), hold, ?_⟩
          simp [eq]
      · rename_i notMem
        have none : combined f (List.map (·.2) (List.filter (·.1 == k) pre)) = none := by
          cases hc : combined f (List.map (·.2) (List.filter (·.1 == k) pre)) with
          | none => rfl
          | some a =>
            exact absurd ((member_iff m k).mpr ⟨a, (hm k a).mpr hc⟩) (by simpa using notMem)
        rw [none]
        simp only [List.mem_append, List.mem_singleton, Prod.mk.injEq, true_and, Option.some.injEq]
        constructor
        · rintro (hp | rfl)
          · rw [(hm k v').mp hp] at none; cases none
          · rfl
        · intro eq; exact Or.inr eq.symm
    · have ne : (k == k') = false := by simpa using e
      simp only [ne, Bool.false_eq_true, ite_false, List.map_nil, List.append_nil]
      rw [← hm k' v']
      unfold insertWith
      split
      · simp only [List.mem_map]
        constructor
        · rintro ⟨p, hp, eq⟩
          split at eq
          · simp at eq; exact absurd eq.1 e
          · subst eq; exact hp
        · intro hp
          refine ⟨(k', v'), hp, ?_⟩
          simp [Ne.symm e]
      · simp [Ne.symm e]
  · unfold insertWith
    split
    · simp only [List.map_map]
      have : ((fun p : κ × ν => p.1) ∘ fun p => if (p.1 == k) = true then (k, f v p.2) else p) =
          (fun p : κ × ν => p.1) := by
        funext p; simp only [Function.comp_apply]; split <;> simp_all
      rw [this]
      exact h.nodup
    · rename_i notMem
      simp only [List.map_append, List.map_cons, List.map_nil]
      refine List.nodup_append.mpr ⟨h.nodup, by simp, ?_⟩
      intro a ha b hb
      simp at hb
      subst hb
      intro eq
      subst eq
      obtain ⟨p, hp, rfl⟩ := List.mem_map.mp ha
      exact notMem ((member_iff m _).mpr ⟨p.2, hp⟩)

theorem holds_fromListWith (f : ν → ν → ν) (xs : List (κ × ν)) : Holds f (fromListWith f xs) xs := by
  unfold fromListWith
  suffices ∀ m pre, Holds f m pre → Holds f (xs.foldl (fun m p => insertWith f p.1 p.2 m) m) (pre ++ xs) by
    simpa using this ⟨[]⟩ [] ⟨by simp [valuesOf, combined], by simp⟩
  induction xs with
  | nil => intro m pre h; simpa using h
  | cons x xs ih =>
    intro m pre h
    simp only [List.foldl_cons]
    have := ih _ _ (holds_insertWith f m pre x.1 x.2 h)
    simpa using this

theorem mem_fromListWith (f : ν → ν → ν) (xs : List (κ × ν)) (k : κ) (v : ν) :
    (k, v) ∈ (fromListWith f xs).pairs ↔ combined f (valuesOf xs k) = some v :=
  (holds_fromListWith f xs).mem k v

theorem lookup_fromListWith (f : ν → ν → ν) (xs : List (κ × ν)) (k : κ) :
    lookup k (fromListWith f xs) = combined f (valuesOf xs k) := by
  have h := holds_fromListWith f xs
  unfold lookup
  cases hf : (fromListWith f xs).pairs.find? (·.1 == k) with
  | none =>
    cases hc : combined f (valuesOf xs k) with
    | none => rfl
    | some v =>
      have := (h.mem k v).mpr hc
      have := List.find?_eq_none.mp hf _ this
      simp at this
  | some p =>
    have mem := List.mem_of_find?_eq_some hf
    have pk := List.find?_some hf
    have pk' : p.1 = k := by simpa using pk
    have := (h.mem p.1 p.2).mp mem
    rw [pk'] at this
    simp [this]

theorem member_fromListWith (f : ν → ν → ν) (xs : List (κ × ν)) (k : κ) :
    member k (fromListWith f xs) = true ↔ (valuesOf xs k) ≠ [] := by
  rw [member_iff]
  simp only [mem_fromListWith]
  constructor
  · rintro ⟨v, hv⟩ e; rw [e] at hv; cases hv
  · intro ne
    cases hvs : valuesOf xs k with
    | nil => exact absurd hvs ne
    | cons a as => exact ⟨_, rfl⟩

omit [BEq κ] [LawfulBEq κ] in
theorem mem_insertByKey [Ord κ] (p q : κ × ν) (qs : List (κ × ν)) :
    q ∈ insertByKey p qs ↔ q = p ∨ q ∈ qs := by
  induction qs with
  | nil => simp [insertByKey]
  | cons r rs ih =>
    unfold insertByKey
    split
    · simp
    · simp only [List.mem_cons, ih]; exact or_left_comm

omit [BEq κ] [LawfulBEq κ] in
theorem mem_toList [Ord κ] (m : HsMap κ ν) (q : κ × ν) : q ∈ toList m ↔ q ∈ m.pairs := by
  unfold toList
  induction m.pairs with
  | nil => simp
  | cons p ps ih => simp [List.foldr_cons, mem_insertByKey, ih]

omit [BEq κ] [LawfulBEq κ] in
theorem mem_elems [Ord κ] (m : HsMap κ ν) (v : ν) : v ∈ elems m ↔ ∃ k, (k, v) ∈ m.pairs := by
  simp [elems, mem_toList]

end HsMap

namespace PegHs.AssembleTranslatedProof

open AssembleTranslated
open PegHs.AssembleTextProof
open PegHs.AssembleValidation (BindingTree)

/-! ## Lists -/

theorem repeated_go_nil_iff {α : Type} [BEq α] [LawfulBEq α] (seen xs : List α) :
    AssembleValidation.repeated.go seen xs = [] ↔ (∀ x ∈ xs, x ∉ seen) ∧ xs.Nodup := by
  induction xs generalizing seen with
  | nil => simp [AssembleValidation.repeated.go]
  | cons x xs ih =>
    simp only [AssembleValidation.repeated.go, List.append_eq_nil_iff, ih, List.mem_cons,
      List.nodup_cons, forall_eq_or_imp]
    by_cases h : x ∈ seen
    · simp [h]
    · simp only [List.contains_iff_mem, h, ite_false, true_and, not_false_eq_true]
      constructor
      · rintro ⟨hs, hn⟩
        refine ⟨fun y hy => ?_, fun hx => ?_, hn⟩
        · exact fun m => (hs y hy) (Or.inr m)
        · exact hs x hx (Or.inl rfl)
      · rintro ⟨hs, hx, hn⟩
        refine ⟨fun y hy m => ?_, hn⟩
        rcases m with rfl | m
        · exact hx hy
        · exact hs y hy m

theorem repeated_nil_iff {α : Type} [BEq α] [LawfulBEq α] (xs : List α) :
    AssembleValidation.repeated xs = [] ↔ xs.Nodup := by
  simp [AssembleValidation.repeated, repeated_go_nil_iff]

theorem mem_zipFrom {α : Type} (n : Int) (xs : List α) (k : Int) (x : α) :
    (k, x) ∈ HsList.zipFrom n xs ↔ ∃ i, ∃ h : i < xs.length, k = n + i ∧ x = xs[i] := by
  induction xs generalizing n with
  | nil => simp [HsList.zipFrom]
  | cons y ys ih =>
    simp only [HsList.zipFrom, List.mem_cons, Prod.mk.injEq, ih, List.length_cons]
    constructor
    · rintro (⟨rfl, rfl⟩ | ⟨i, hi, rfl, rfl⟩)
      · exact ⟨0, by omega, by simp, rfl⟩
      · exact ⟨i + 1, by omega, by omega, rfl⟩
    · rintro ⟨i, hi, rfl, rfl⟩
      cases i with
      | zero => left; simp
      | succ i => right; exact ⟨i, by omega, by omega, rfl⟩

theorem nodup_filterMap_append {α β : Type} (f : α → Option β) (pre ys : List α) :
    ((pre ++ ys).filterMap f).Nodup ↔ (pre.filterMap f).Nodup ∧
      ∀ i (h : i < ys.length), ∀ b, f ys[i] = some b → b ∉ (pre ++ ys.take i).filterMap f := by
  induction ys generalizing pre with
  | nil => simp
  | cons y ys ih =>
    have e : pre ++ y :: ys = (pre ++ [y]) ++ ys := by simp
    rw [e, ih]
    constructor
    · rintro ⟨hpre, hrest⟩
      rw [List.filterMap_append, List.nodup_append] at hpre
      obtain ⟨hpre, -, hdis⟩ := hpre
      refine ⟨hpre, fun i hi b hb => ?_⟩
      cases i with
      | zero =>
        simp only [List.getElem_cons_zero] at hb
        simp only [List.take_zero, List.append_nil]
        intro m
        exact hdis b m b (by simp [hb]) rfl
      | succ i =>
        simp only [List.getElem_cons_succ] at hb
        have := hrest i (by simp at hi; omega) b hb
        simpa using this
    · rintro ⟨hpre, hrest⟩
      refine ⟨?_, fun i hi b hb => ?_⟩
      · rw [List.filterMap_append, List.nodup_append]
        refine ⟨hpre, ?_, ?_⟩
        · cases hf : f y <;> simp [hf]
        · intro a ha c hc eq
          subst eq
          have hy : f y = some a := by
            cases hf : f y <;> simp [hf] at hc; exact hc ▸ rfl
          have := hrest 0 (by simp) a (by simpa using hy)
          exact this (by simpa using ha)
      · have := hrest (i + 1) (by simp; omega) b (by simpa using hb)
        simpa using this

/-- A list without repetitions, element by element: no element is among the
ones before it. -/
theorem nodup_filterMap_iff {α β : Type} (f : α → Option β) (ys : List α) :
    (ys.filterMap f).Nodup ↔
      ∀ i (h : i < ys.length), ∀ b, f ys[i] = some b → b ∉ (ys.take i).filterMap f := by
  simpa using nodup_filterMap_append f [] ys

/-! ## The view of the items that AssembleValidation reads -/

mutual
def exprTree : Expr → BindingTree
  | .EGroup groups => .group (groupsTree groups)
  | .EStar e | .EPlus e | .EOpt e | .EAnd e | .ENot e | .ECapture e | .ELabel _ e _ | .EDiscard e =>
    .unary (exprTree e)
  | .ETemplate _ _ args _ => .templateArgs (exprsTree args)
  | .ELit .. | .EClass .. | .EAny | .ERef .. | .EPred .. => .leaf
def itemTree : Item → BindingTree
  | .Item _ b e => .item b (exprTree e)
def itemsTree : List Item → List BindingTree
  | [] => []
  | i :: is => itemTree i :: itemsTree is
def groupsTree : List (List Item) → List (List BindingTree)
  | [] => []
  | g :: gs => itemsTree g :: groupsTree gs
def exprsTree : List Expr → List BindingTree
  | [] => []
  | e :: es => exprTree e :: exprsTree es
end

def topView : Top → AssembleValidation.Top
  | .TDirective _ n _ a => .directive n a
  | .TVerbatim _ _ => .verbatim
  | .TAnnot _ n ps tps _ =>
    .annotation n (tps.map TemplateParam.templateParamName) (ps.map Param.paramName)
  | .TDef _ n tns alts => .definition n tns (alts.map fun alt => itemsTree (Alt.altItems alt))

def view (items : List Top) : List AssembleValidation.Top := items.map topView

/-! ## The lists of assemble against the model's -/

theorem directives_view (items : List Top) :
    (assemble.directives_235 items).map (fun x => (x.2.1, x.2.2)) =
      AssembleValidation.directives (view items) := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp_all [assemble.directives_235, HsList.concatMap, view, topView,
      AssembleValidation.directives]

theorem argLocs_view (items : List Top) :
    (assemble.argLocs_236 items).map (fun x => (x.1, x.2.2)) =
      AssembleValidation.directives (view items) := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp_all [assemble.argLocs_236, HsList.concatMap, view, topView,
      AssembleValidation.directives]

theorem imports_view (items : List Top) :
    (assemble.imports_262 items).map (·.2.2) =
      AssembleValidation.args (AssembleValidation.directives (view items)) "import" := by
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp_all [assemble.imports_262, HsList.concatMap, view, topView,
      AssembleValidation.directives, AssembleValidation.args, HsBase.eq]
    split <;> simp_all

theorem args_view (items : List Top) (n : String) :
    AssembleValidation.args (AssembleValidation.directives (view items)) n =
      ((assemble.directives_235 items).filter (·.2.1 == n)).map (·.2.2) := by
  rw [← directives_view]
  simp [AssembleValidation.args, List.filter_map, Function.comp_def]

theorem flatMap_single {α β : Type} (f : α → β) (xs : List α) :
    xs.flatMap (fun x => [f x]) = xs.map f := by
  induction xs <;> simp_all

theorem languageOptions_view (items : List Top) :
    assemble.languageOptions_240 items = AssembleValidation.languageOptions (view items) := by
  unfold AssembleValidation.languageOptions
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp_all [assemble.languageOptions_240, HsList.concatMap, view, topView,
      AssembleValidation.directives, AssembleValidation.args, HsBase.eq]
    rename_i n _ a
    by_cases h : n = "language"
    · subst h
      simp [flatMap_single, splitExports_eq]
    · simp [h]

theorem recursiveDoEnabled_view (items : List Top) :
    assemble.recursiveDoEnabled_248 items =
      AssembleValidation.recursiveDoEnabled (AssembleValidation.languageOptions (view items)) := by
  simp [assemble.recursiveDoEnabled_248, assemble.extensionEnabled_242, languageOptions_view,
    foldl_step_eq, AssembleValidation.recursiveDoEnabled]

theorem arrowsEnabled_view (items : List Top) :
    assemble.arrowsEnabled_249 items =
      AssembleValidation.arrowsEnabled (AssembleValidation.languageOptions (view items)) := by
  simp [assemble.arrowsEnabled_249, assemble.extensionEnabled_242, languageOptions_view,
    foldl_step_eq, AssembleValidation.arrowsEnabled]

theorem binderError_view (items : List Top) (name : String) :
    (assemble.binderError_253 items name).isSome =
      AssembleValidation.binderError (AssembleValidation.languageOptions (view items)) name := by
  simp only [assemble.binderError_253, assemble.binderKeyword_250, recursiveDoEnabled_view,
    arrowsEnabled_view, AssembleValidation.binderError, AssembleValidation.binderKeyword,
    extensionKeyword_eq, startsWithModifier_eq, reservedWords_eq, HsBase.or, HsBase.and, HsBase.ne,
    elem_eq_contains]
  cases hk : ((!name == "_" && grammarReservedWords.contains name) ||
      AssembleValidation.extensionKeyword (AssembleValidation.languageOptions (view items)) name) <;>
    cases hm : AssembleValidation.startsWithModifier name <;> simp_all [bne]

theorem stringArgs_view (items : List Top) (d : String) :
    (assemble.stringArgs_274 items d).map (fun x => stringOutcome x.2) =
      (AssembleValidation.stringResults (AssembleValidation.directives (view items)) d).map
        (·.mapError (fun _ => ())) := by
  rw [AssembleValidation.stringResults, args_view]
  induction items with
  | nil => rfl
  | cons t ts ih =>
    cases t <;> simp_all [assemble.stringArgs_274, assemble.directives_235, HsList.concatMap,
      HsBase.eq, HsBase.not, null_eq]
    rename_i l n al a
    by_cases h : n = d
    · subst h
      by_cases e : a = "" <;> simp [e, stringArg_eq]
    · simp [h]

theorem single_view (items : List Top) (n : String) :
    (assemble.single_277 items n).map Located.unLoc =
      (AssembleValidation.args (AssembleValidation.directives (view items)) n).head? := by
  rw [args_view]
  simp only [assemble.single_277]
  induction assemble.directives_235 items with
  | nil => rfl
  | cons x xs ih =>
    by_cases h : x.2.1 = n <;> simp_all [HsList.concatMap, HsBase.eq, Located.unLoc]


/-! ## The binders that nestedItems finds -/

mutual
theorem nested_item (i : Item) :
    (assemble.nestedItems_405 i).filterMap Item.itemBind = (itemTree i).names := by
  cases i with
  | Item l b e =>
    rw [assemble.nestedItems_405]
    simp only [List.filterMap_cons, Item.itemBind, Item.itemExpr, itemTree, BindingTree.names, nested_expr e]
    cases b <;> rfl
theorem nested_expr (e : Expr) :
    (assemble.nestedExpr_406 e).filterMap Item.itemBind = (exprTree e).names := by
  cases e with
  | EGroup gs =>
    rw [assemble.nestedExpr_406]
    simp only [HsList.concatMap, exprTree, BindingTree.names]
    exact nested_groups gs
  | ETemplate l n args vs =>
    rw [assemble.nestedExpr_406]
    simp only [HsList.concatMap, exprTree, BindingTree.names]
    exact nested_exprs args
  | EStar x | EPlus x | EOpt x | EAnd x | ENot x | ECapture x | EDiscard x | ELabel _ x _ =>
    rw [assemble.nestedExpr_406]
    simp only [exprTree, BindingTree.names]
    exact nested_expr x
  | ELit _ _ | EClass _ _ | EAny | ERef _ _ _ | EPred _ _ =>
    simp [assemble.nestedExpr_406, exprTree, BindingTree.names]
theorem nested_items (is : List Item) :
    (is.flatMap assemble.nestedItems_405).filterMap Item.itemBind =
      (itemsTree is).flatMap BindingTree.names := by
  cases is with
  | nil => rfl
  | cons i is =>
    simp only [List.flatMap_cons, List.filterMap_append, itemsTree, nested_item i, nested_items is]
theorem nested_groups (gs : List (List Item)) :
    (gs.flatMap (fun g => g.flatMap assemble.nestedItems_405)).filterMap Item.itemBind =
      (groupsTree gs).flatMap (fun items => items.flatMap BindingTree.names) := by
  cases gs with
  | nil => rfl
  | cons g gs =>
    simp only [List.flatMap_cons, List.filterMap_append, groupsTree, nested_items g, nested_groups gs]
theorem nested_exprs (es : List Expr) :
    (es.flatMap assemble.nestedExpr_406).filterMap Item.itemBind =
      (exprsTree es).flatMap BindingTree.names := by
  cases es with
  | nil => rfl
  | cons e es =>
    simp only [List.flatMap_cons, List.filterMap_append, exprsTree, nested_expr e, nested_exprs es]
end

/-! ## The maps of assemble -/

/-- The annotations of a rule, in order. -/
def annsNamed (items : List Top) (n : String) :
    List (Loc × List Param × List TemplateParam × Located String) :=
  items.flatMap fun
    | .TAnnot l n' ps tps ty => if n' = n then [(l, ps, tps, ty)] else []
    | _ => []

/-- The definitions of a rule, in order. -/
def defsNamed (items : List Top) (n : String) : List (Loc × List String) :=
  items.flatMap fun
    | .TDef l n' tns _ => if n' = n then [(l, tns)] else []
    | _ => []

/-- The pairs of the maps of assemble, as lists. -/
def annPairs (items : List Top) :
    List (String × List (Loc × List Param × List TemplateParam × Located String)) :=
  items.flatMap fun
    | .TAnnot l n ps tps ty => [(n, [(l, ps, tps, ty)])]
    | _ => []

def tnPairs (items : List Top) : List (String × Loc × List String) :=
  items.flatMap fun
    | .TDef l n tns _ => [(n, (l, tns))]
    | _ => []

theorem annots_def (items : List Top) :
    assemble.annots_286 items = HsMap.fromListWith (HsBase.flip HsList.append) (annPairs items) := rfl

theorem defCounts_def (items : List Top) :
    assemble.defCounts_289 items =
      HsMap.fromListWith HsInt.add ((assemble.defs_287 items).map (fun x => (x.2.1, (1 : Int)))) := by
  unfold assemble.defCounts_289
  congr 1
  simp [HsList.concatMap, flatMap_single]

theorem defTemplateNames_def (items : List Top) :
    assemble.defTemplateNames_288 items = HsMap.fromListWith (fun new _ => new) (tnPairs items) := rfl

theorem combined_singletons {α : Type} (xs : List α) :
    HsMap.combined (HsBase.flip HsList.append) (xs.map (fun x => [x])) =
      if xs = [] then none else some xs := by
  cases xs with
  | nil => rfl
  | cons x xs =>
    simp only [List.map_cons, HsMap.combined, reduceCtorEq, ite_false, Option.some.injEq]
    suffices ∀ acc : List α, (xs.map (fun x => [x])).foldl (fun acc y => HsBase.flip HsList.append y acc) acc =
        acc ++ xs by simpa using this [x]
    induction xs with
    | nil => simp
    | cons y ys ih => intro acc; simpa [HsBase.flip, HsList.append] using ih (acc ++ [y])

theorem combined_ones (xs : List Int) (ones : ∀ x ∈ xs, x = 1) :
    HsMap.combined HsInt.add xs = if xs = [] then none else some (Int.ofNat xs.length) := by
  cases xs with
  | nil => rfl
  | cons x xs =>
    simp only [HsMap.combined, reduceCtorEq, ite_false, Option.some.injEq, List.length_cons]
    have hx := ones x (by simp)
    subst hx
    suffices ∀ acc : Int, xs.foldl (fun acc y => HsInt.add y acc) acc = acc + xs.length by
      simpa [Int.add_comm] using this 1
    induction xs with
    | nil => simp
    | cons y ys ih =>
      intro acc
      have hy := ones y (by simp)
      subst hy
      simp only [List.foldl_cons, List.length_cons]
      rw [ih (fun x hx => ones x (by simp [hx])) (HsInt.add 1 acc)]
      simp [HsInt.add]
      omega

theorem combined_last {β : Type} (xs : List β) :
    HsMap.combined (fun new _ => new) xs = xs.getLast? := by
  cases xs with
  | nil => rfl
  | cons x xs =>
    simp only [HsMap.combined]
    induction xs generalizing x with
    | nil => rfl
    | cons y ys ih => simp [ih y, List.getLast?_cons]

theorem annots_values (items : List Top) (n : String) :
