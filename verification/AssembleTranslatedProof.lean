theorem libraryLoc_isSome (items : List Top) :
    (assemble.libraryLoc_259 items).isSome =
      (AssembleValidation.directives (view items)).any (·.1 == "library") := by
  rw [← directives_view]
  unfold assemble.libraryLoc_259
