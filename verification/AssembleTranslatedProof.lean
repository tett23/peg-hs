/-! ## assemble against the model -/

theorem insertOnOrd_length {α β : Type} [Ord β] (key : α → β) (x : α) (xs : List α) :
    (HsList.insertOnOrd key x xs).length = xs.length + 1 := by
  induction xs with
  | nil => rfl
  | cons y ys ih => unfold HsList.insertOnOrd; split <;> simp [ih]

theorem sortOnOrd_length {α β : Type} [Ord β] (key : α → β) (xs : List α) :
    (HsList.sortOnOrd key xs).length = xs.length := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp [HsList.sortOnOrd, insertOnOrd_length, ih]

/-- The translated assemble accepts exactly the items whose view the model
AssembleValidation accepts. -/
theorem assemble_ok_iff (items : List Top) :
    (∃ g, assemble items = .ok g) ↔ AssembleValidation.assemble (view items) = .ok () := by
  rw [AssembleValidation.assemble_ok_iff, ← errors_nil_iff, ← moduleName_isSome]
  unfold assemble
  simp only
  split
  · rename_i e
    rw [e]
    simp only [true_and]
    split
    · rename_i m hm
      simp [hm]
    · rename_i hm
      simp [hm]
  · rename_i ne
    simp only [reduceCtorEq, exists_false, false_iff, not_and]
    intro h
    exact absurd h ne

/-- What the former premise A3 of PublicGeneration assumed: when the translated
assemble accepts the items, the model accepts their view. -/
theorem assemble_agrees (items : List Top) (g : Grammar) (h : assemble items = .ok g) :
    AssembleValidation.assemble (view items) = .ok () :=
  (assemble_ok_iff items).mp ⟨g, h⟩

theorem assemble_error_nonempty (items : List Top) (ds : List Diagnostic) (h : assemble items = .error ds) :
    ds ≠ [] := by
  unfold assemble at h
  simp only at h
  split at h
  · split at h
    · cases h
    · cases h; simp
  · rename_i ne
    cases h
    intro empty
    have := congrArg List.length empty
    rw [sortOnOrd_length] at this
    exact ne (List.length_eq_zero_iff.mp (by simpa using this))

#print axioms errors_nil_iff
#print axioms assemble_ok_iff
#print axioms assemble_agrees
#print axioms assemble_error_nonempty

