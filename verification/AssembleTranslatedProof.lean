  rw [annots_def, HsMap.mem_fromListWith, annots_values, combined_singletons]
  by_cases h : annsNamed items n = []
  · simp [h]
  · simp only [h, ite_false, Option.some.injEq, ne_eq, not_false_eq_true, true_and]
    exact ⟨Eq.symm, Eq.symm⟩

theorem annots_lookup (items : List Top) (n : String) :
