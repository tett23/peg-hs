      exact ⟨x, hx, by by_cases e : x.2.1 = "library" <;> simp_all⟩
    simp [List.any_map, this]
  · rename_i h
    simp only [List.flatMap_eq_nil_iff] at h
    simp only [Option.isSome_none, List.any_map, Function.comp_def, Bool.false_eq, List.any_eq_false,
      beq_iff_eq]
