import AssembleProbeCases

-- The Lean half of check-assemble-predicates.sh. AssembleProbeCases is
-- generated by AssemblePredicatesProbe.hs from the same inputs.
open PegHs.AssembleValidation PegHs.AssembleProbeCases

def codes (t : String) : String :=
  "[" ++ ", ".intercalate (t.toList.map fun c => toString c.toNat) ++ "]"

def showBool (b : Bool) : String := if b then "true" else "false"

def kindName : Kind → String
  | .unknownDirective => "unknownDirective"
  | .duplicateDirective => "duplicateDirective"
  | .missingArgument => "missingArgument"
  | .unexpectedArgument => "unexpectedArgument"
  | .libraryConflict => "libraryConflict"
  | .libraryDirective => "libraryDirective"
  | .libraryVerbatim => "libraryVerbatim"
  | .invalidImportPath => "invalidImportPath"
  | .duplicateImport => "duplicateImport"
  | .invalidRecover => "invalidRecover"
  | .invalidLanguage => "invalidLanguage"
  | .invalidModule => "invalidModule"
  | .invalidExport => "invalidExport"
  | .invalidDeriving => "invalidDeriving"
  | .invalidString => "invalidString"
  | .duplicateString => "duplicateString"
  | .invalidSafe => "invalidSafe"
  | .invalidRuleName => "invalidRuleName"
  | .invalidTabstop => "invalidTabstop"
  | .missingTemplateType => "missingTemplateType"
  | .orphanAnnotation => "orphanAnnotation"
  | .duplicateAnnotation => "duplicateAnnotation"
  | .duplicateDefinition => "duplicateDefinition"
  | .noRules => "noRules"
  | .templateMismatch => "templateMismatch"
  | .reservedParameter => "reservedParameter"
  | .reservedBinding => "reservedBinding"

def sortStrings (xs : List String) : List String := xs.mergeSort (fun a b => decide (a ≤ b))

def assembleLine (k : Nat) (tops : List Top) : String :=
  let vs := violations tops
  if vs.isEmpty && modulePresent tops then s!"assemble {k} accepted"
  else
    let kinds := if vs.isEmpty then ["missingModule"] else vs.map (kindName ·.kind)
    let binders := (vs.filter fun v => v.kind == .reservedBinding || v.kind == .reservedParameter).map
      fun v => kindName v.kind ++ ":" ++ codes v.subject
    s!"assemble {k} rejected kinds=" ++ ",".intercalate (sortStrings kinds).eraseDups ++
      " binders=" ++ ",".intercalate (sortStrings binders)

def indexed (xs : List α) : List (Nat × α) := (List.range xs.length).zip xs

def main : IO Unit := do
  for (i, n) in indexed nameCases do IO.println s!"ident {i} {showBool (validIdent n)}"
  for (i, n) in indexed nameCases do IO.println s!"class {i} {showBool (validClass n)}"
  for (i, n) in indexed nameCases do IO.println s!"module {i} {showBool (validModule n)}"
  for (i, n) in indexed nameCases do IO.println s!"modifier {i} {showBool (startsWithModifier n)}"
  for (i, n) in indexed nameCases do IO.println s!"words {i} {",".intercalate ((words n).map codes)}"
  for (j, o) in indexed optionSets do
    for (i, n) in indexed nameCases do
      IO.println s!"binder {j} {i} {showBool (binderError (languageOptions o) n)}"
  for (j, o) in indexed optionSets do
    for (i, x) in indexed (exportCases ++ nameCases) do
      IO.println s!"export {j} {i} {showBool (validExport (languageOptions o) x)}"
  for (k, tops) in indexed assembleCases do IO.println (assembleLine k tops)
