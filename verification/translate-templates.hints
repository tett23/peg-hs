-- Every explicit fuel group is checked by the Lean kernel. Adequate fuel
-- for the whole template pass remains a separate refinement obligation.
fuel expandOnce.freshName
fuel identifierSplit
decreasing plain
  termination_by sizeOf $1
  decreasing_by
    all_goals hs_decreasing
    all_goals first
      | (have outer := List.sizeOf_lt_of_mem (α := List Item) (by assumption)
         have inner := List.sizeOf_lt_of_mem (α := Item) (by assumption)
         have field := Item.itemExpr_sizeOf (by assumption)
         omega)
      | (have smaller := List.sizeOf_lt_of_mem (α := Expr) (by assumption)
         omega)
before exprCode
  @[wf_preprocess] theorem exprChildren_wfParam {e : Expr} :
      exprChildren (wfParam e) = wfParam (exprChildren e) := rfl
  theorem exprChildren_shrinks (e x : Expr) (member : x ∈ exprChildren e) :
      sizeOf x < sizeOf e := by
    cases e <;> simp_all [exprChildren] <;> omega
decreasing exprCode
  termination_by sizeOf $1
  decreasing_by
    all_goals hs_decreasing
    all_goals first
      | (have outer := List.sizeOf_lt_of_mem (α := List Item) (by assumption)
         have inner := List.sizeOf_lt_of_mem (α := Item) (by assumption)
         have field := Item.itemExpr_sizeOf (by assumption)
         omega)
      | (have smaller := List.sizeOf_lt_of_mem (α := Expr) (by assumption)
         omega)
      | (apply exprChildren_shrinks; assumption)
fuel Peg_Grammar_codeVariables.blockComment
fuel Peg_Grammar_codeVariables.string
fuel Peg_Grammar_codeVariables.qualified
fuel Peg_Grammar_codeVariables.fields
fuel Peg_Grammar_codeVariables.go
fuel expandOnce.itemBinds
fuel substituteAlt.passed
fuel Peg_Grammar_Types_classify.unknownFix
fuel Peg_Grammar_Types_parens.needsParens
fuel Peg_Grammar_Types_countedItems
fuel Peg_Grammar_Types_classify.exprType
fuel Peg_Grammar_Types_classify.unitFix
fuel Peg_Grammar_Types_classify.go
fuel Peg_Grammar_Types_classify.resolve
fuel expandOnce.expandExpr
fuel expandOnce.drain
fuel expandTemplates.go
