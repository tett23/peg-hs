  | cons p ps ih => simp_all [eGalts, eAlts]

/-- The sites of the alternatives `restM` of a choice, from the k-th on. -/
theorem altSites_part (rn : String) (outer : List Frame) (galts : List (Loc × List Item)) (body : Bool)
    (S : Int → Int → List LabelsTranslated.Item → LabelsTranslated.Item → List LabelsTranslated.Site)
    (hS : ∀ (k j : Nat) (is : List Item) (i : Item), (∃ l, (l, is) ∈ galts) → i ∈ is →
      S k j (eItems is) (eItem i) = (exprSites rn (.seq is j :: .alts galts k body :: outer) i.1 i.2.2).map eSite) :
    ∀ (restM : List (Loc × List Item)) (k : Nat), (∀ p ∈ restM, p ∈ galts) →
      HsList.concat (HsList.concatMap (fun ν93 => match ν93 with
          | (k, (_, is)) => HsList.concatMap (fun ν92 => match ν92 with
            | (j, item) => [S k j is item]) (HsList.zipFrom 0 is))
          (HsList.zipFrom (k : Int) (eGalts restM))) =
        (altSites rn outer galts body k (restM.map Prod.snd)).map eSite
  | [], k, _ => by simp [eGalts, HsList.zipFrom, HsList.concat, HsList.concatMap, altSites]
  | (l, is) :: rest, k, h => by
    have ih := altSites_part rn outer galts body S hS rest (k + 1) (fun p hp => h p (List.mem_cons_of_mem _ hp))
    have hits := itemSites_part rn outer galts body k is (fun j item => S k j (eItems is) item)
      (fun j i hi => hS k j is i ⟨l, h _ (by simp)⟩ hi) is 0 (fun _ hi => hi)
    simp only [HsList.concat, HsList.concatMap] at ih hits ⊢
    rw [eGalts, List.map_cons, zipFrom_cons, List.flatMap_cons, List.flatten_append]
    rw [show ((k : Int) + 1) = ((k + 1 : Nat) : Int) by omega]
    have ih' := ih
    simp only [eGalts] at ih'
    rw [ih', List.map_cons, altSites, List.map_append]
    congr 1

