    obtain ⟨N1, h1⟩ := substExpr_ev e
    obtain ⟨N2, h2⟩ := substList_ev es
    refine ⟨max N1 N2, fun n hn pm => ?_⟩
    simp only [eList, HsMaybe.mapM, h1 n (by omega) pm, h2 n (by omega) pm]
    rw [substList]
    cases substExpr pm e <;> cases substList pm es <;> simp [eList]
termination_by es => sizeOf es
end

theorem substItems_ev (is : List Item) : Eventually (fun n => ∀ pm,
    LabelsTranslated.substItems n (HsMap.fromList pm) (eItems is) = (substItems pm is).map eItems) :=
  (substItemsL_ev is).mono (fun n h pm => by simp only [LabelsTranslated.substItems, substItems, h pm])


/-! ## lift, expandCall, expansions -/

theorem itemsExprCodes_e (is : List Item) :
    HsList.concatMap (fun i => LabelsTranslated.exprCodes (LabelsTranslated.Item.itemExpr i)) (eItems is) =
      is.flatMap (fun i => exprCodes (itemExpr i)) := by
  rw [eItems_map]
  simp only [HsList.concatMap, List.flatMap_map]
  congr 1
  funext i
  simp [eItem, LabelsTranslated.Item.itemExpr, exprCodes_e, itemExpr]

theorem codesShort_e (cs : List String) :
    HsList.all (fun c => (fun n => HsInt.le n LabelsTranslated.maxCode') (HsText.length c)) cs =
      cs.all (fun c => c.length ≤ maxCode') := by
  simp only [HsList.all]
  congr 1
  funext c
  simp only [HsInt.le, HsText.length, LabelsTranslated.maxCode', maxCode', String.length_toList]
  apply Bool.eq_iff_iff.2
  simp only [decide_eq_true_eq, Int.ofNat_eq_natCast]
  constructor
  · intro hh
    have : c.length ≤ 64 := by exact_mod_cast hh
    exact decide_eq_true this
  · intro hh
    have : c.length ≤ 64 := of_decide_eq_true hh
    exact_mod_cast this

theorem lift_ev {tc : LabelsTranslated.Ctx} {mc : Ctx} (h : CtxCorr tc mc) (pre : List Item) :
    Eventually (fun n => ∀ (rule : String) (lifts : Nat) (k : CharSet) (s : Site),
      LabelsTranslated.ruleFailed.lift_632 n tc rule (eItems pre) lifts (eCS k) (eSite s) =
        ((eItems (lift mc rule pre lifts k s).1.1, ((lift mc rule pre lifts k s).1.2 : Int)),
          eCS (lift mc rule pre lifts k s).2)) := by
  refine (substItems_ev pre).mono (fun n hn rule lifts k s => ?_)
  obtain ⟨r, fs, l, e⟩ := s
  have hfb : ((([] : List LabelsTranslated.Item), (0 : Int)), LabelsTranslated.beforeItems tc (eItems pre) (eCS k)) =
      ((eItems [], ((0 : Nat) : Int)), eCS (beforeItems mc pre k)) := by
    simp [beforeItems_e h, eItems]
  cases e with
  | ref l' n0 args =>
    simp only [eSite, eExpr, LabelsTranslated.ruleFailed.lift_632, lift]
    by_cases hl : lifts < maxLifts
    · have hl' : HsInt.lt (lifts : Int) LabelsTranslated.maxLifts = true := by
        have : lifts < 3 := hl
        show decide ((lifts : Int) < 3) = true
        simp; omega
      simp only [hl', ↓reduceIte, hl]
      have hr := h.rules rule
      cases hT : HsMap.lookup rule tc.ctxRules <;> cases hM : findLast mc.rules rule <;>
        rw [hT, hM] at hr <;> simp only [RuleOpt] at hr
      · simp only [HsMaybe.bind, hT, hM, Option.bind_none]
        exact hfb
      · rename_i tr mr
        simp only [HsMaybe.bind, hT, hM, Option.bind_some, paramMap_e hr]
        cases hp : paramMap mr args with
        | none => simpa using hfb
        | some pm =>
          simp only [Option.map_some, HsMaybe.bind, hn pm, Option.bind_some]
          cases hs : substItems pm pre with
          | none => simpa using hfb
          | some pre' =>
            simp only [Option.map_some, itemsExprCodes_e, codesShort_e]
            split
            · simp [HsInt.add]
            · exact hfb
    · have hl' : HsInt.lt (lifts : Int) LabelsTranslated.maxLifts = false := by
        have : ¬ lifts < 3 := hl
        show decide ((lifts : Int) < 3) = false
        simp; omega
      simp only [hl', Bool.false_eq_true, ↓reduceIte, hl]
      exact hfb
  | _ => simp only [eSite, eExpr, LabelsTranslated.ruleFailed.lift_632, lift]; exact hfb

theorem mapM_map {α β γ : Type} (f : β → Option γ) (g : α → β) :
    ∀ (l : List α), HsMaybe.mapM (fun a => f (g a)) l = HsMaybe.mapM f (l.map g)
  | [] => rfl
  | x :: xs => by simp [HsMaybe.mapM, mapM_map f g xs]

theorem ruleOf_mem {mc : Ctx} {n : String} {mr : Rule} (h : findLast mc.rules n = some mr) : (n, mr) ∈ mc.rules :=
  findLast_mem h

theorem expandCall_ev {tc : LabelsTranslated.Ctx} {mc : Ctx} (h : CtxCorr tc mc) :
    Eventually (fun f => ∀ (name : String) (args : List (Loc × String)),
      LabelsTranslated.expandCall f tc name (args.map eLocated) = (expandCall mc name args).map eAlts) := by
  have hall : Eventually (fun f => ∀ p ∈ mc.rules, ∀ a ∈ p.2.alts, ∀ pm,
      LabelsTranslated.substItems f (HsMap.fromList pm) (eItems a.items) = (substItems pm a.items).map eItems) :=
    Eventually.forall_mem mc.rules (fun p _ => Eventually.forall_mem p.2.alts (fun a _ => substItems_ev a.items))
  refine hall.mono (fun f hf name args => ?_)
  simp only [LabelsTranslated.expandCall, expandCall]
  have hr := h.rules name
  cases hT : HsMap.lookup name tc.ctxRules <;> cases hM : findLast mc.rules name <;>
    rw [hT, hM] at hr <;> simp only [RuleOpt] at hr
  · rfl
  · rename_i tr mr
    simp only [HsMaybe.bind, hT, hM, h.expandable name]
    by_cases hx : mc.expandable.contains name = true
    · simp only [hx, ↓reduceIte, paramMap_e hr]
      cases hp : paramMap mr args with
      | none => rfl
      | some pm =>
        simp only [Option.map_some]
        rw [mapM_map (fun is => LabelsTranslated.substItems f (HsMap.fromList pm) is), hr.items, eAlts_map,
          List.map_map]
        have := mapM_e (fun is => LabelsTranslated.substItems f (HsMap.fromList pm) is) (fun a => substItems pm a.items)
          (fun a => eItems a.items) eItems mr.alts
          (fun a ha => hf (name, mr) (ruleOf_mem hM) a ha pm)
        simp only [Function.comp_def] at this ⊢
        rw [this]
        cases List.mapM (fun a => substItems pm a.items) mr.alts <;> simp [eAlts_map]
    · have hx' : name ∉ mc.expandable := by simpa using hx
      simp [hx']

theorem unfold_e {tc : LabelsTranslated.Ctx} {mc : Ctx} {f : Nat}
    (hE : ∀ (name : String) (args : List (Loc × String)),
      LabelsTranslated.expandCall f tc name (args.map eLocated) = (expandCall mc name args).map eAlts)
    (l : Loc) (e : Expr) :
    LabelsTranslated.expansions.unfold_798 f tc (eLoc l) (eExpr e) = (unfold mc l e).map eAlts := by
  cases e <;> simp [LabelsTranslated.expansions.unfold_798, unfold, eExpr, hE, eAlts, eItems]

theorem expansions_e {tc : LabelsTranslated.Ctx} {mc : Ctx} {f : Nat}
    (hE : ∀ (name : String) (args : List (Loc × String)),
      LabelsTranslated.expandCall f tc name (args.map eLocated) = (expandCall mc name args).map eAlts) :
    ∀ (depth : Nat) (matched a : List Item),
      LabelsTranslated.expansions f tc depth (eItems matched) (eItems a) = (expansions mc depth matched a).map eItems := by
  intro depth
  induction depth with
  | zero =>
    intro matched a
    rw [LabelsTranslated.expansions, expansions]
    simp only [commonPrefix_e, eItems_drop]
    cases a.drop (commonPrefix matched a) with
    | nil => simp [eItems]
    | cons i rest =>
      obtain ⟨l, b, e⟩ := i
      simp [eItems, HsInt.gt]
  | succ d ih =>
    intro matched a
    rw [LabelsTranslated.expansions, expansions]
    simp only [commonPrefix_e, eItems_drop]
    cases hd : a.drop (commonPrefix matched a) with
    | nil => simp [eItems]
    | cons i rest =>
      obtain ⟨l, b, e⟩ := i
      simp only [eItems, unfold_e hE]
      have hlen : HsInt.lt (commonPrefix matched a : Int) (HsList.length (eItems matched)) =
          decide (commonPrefix matched a < matched.length) := by
        simp only [HsInt.lt, HsList.length, eItems_map, List.length_map, Int.ofNat_eq_natCast]
        apply Bool.eq_iff_iff.2; simp
      have hpos : HsInt.gt ((d + 1 : Nat) : Int) 0 = true := by simp [HsInt.gt]
      rw [hlen, hpos]
      by_cases hm : commonPrefix matched a < matched.length
      · simp only [hm, decide_true, ↓reduceIte, show d + 1 > 0 by omega, and_self]
        cases unfold mc l e with
        | none => simp [eItems]
        | some alts =>
          have hxs : HsList.concat (HsList.concatMap (fun ν171 => [LabelsTranslated.expansions f tc
              (HsInt.sub ((d + 1 : Nat) : Int) 1) (eItems matched) (HsList.append
                (HsList.take (commonPrefix matched a : Int) (eItems a)) (HsList.append ν171
                  (eItems rest)))]) (eAlts alts)) =
              (alts.flatMap fun alt => expansions mc d matched (a.take (commonPrefix matched a) ++ alt ++ rest)).map
                eItems := by
            simp only [HsList.concat, HsList.concatMap, flatMap_single, HsInt.sub,
              show ((d + 1 : Nat) : Int) - 1 = (d : Int) by omega, eAlts_map, List.map_map, List.map_flatMap]
            rw [List.flatMap_def]
            congr 1
            apply List.map_congr_left
            intro alt _
            simp only [Function.comp_def, HsList.append, eItems_take, ← eItems_append, List.append_assoc]
            exact ih matched _
          simp only [Option.map_some, Nat.add_sub_cancel]
          rw [hxs]
          generalize (alts.flatMap fun alt => expansions mc d matched
            (a.take (commonPrefix matched a) ++ alt ++ rest)) = XS
          simp only [HsInt.gt, HsList.length, List.length_map, LabelsTranslated.maxExpansions, maxExpansions,
            Int.ofNat_eq_natCast]
          by_cases hb : XS.length > 64
          · have hb' : ((XS.length : Int) > 64) := by omega
            simp only [hb', decide_true, ↓reduceIte, hb, List.map_cons, List.map_nil]
          · have hb' : ¬ ((XS.length : Int) > 64) := by omega
            simp only [hb', decide_false, Bool.false_eq_true, ↓reduceIte, hb]
      · simp [hm, eItems]

end PegHs.LabelsBridge
