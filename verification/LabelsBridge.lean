theorem context_e (keyOf : Nat → List Item → String) {tg : LabelsTranslated.Grammar} {mg : Grammar}
    (h : GrammarCorr tg mg) :
    Eventually (fun n => CtxCorr (LabelsTranslated.context n tg) (contextWith keyOf mg)) := by
  obtain ⟨S, hS⟩ := rulesSites_ev h.rules
  refine ⟨max S (max 1002 (mg.rules.length + 1)), fun n hn => ?_⟩
  show CtxCorr (LabelsTranslated.context n tg) (contextWith keyOf mg)
  rw [tContext_eq]
  have hlr := leftRecursion_e h.rules n (by omega)
  have hpass := abstractions_e h.rules n (by omega)
  have hsites : HsList.concatMap (fun r => LabelsTranslated.sites n r) tg.grammarRules =
      (mg.rules.flatMap sites).map eSite := hS n (by omega)
  simp only [tContext]
  generalize LabelsTranslated.abstractions n tg.grammarRules = ab at hpass ⊢
  obtain ⟨e3, pass⟩ := ab
  generalize LabelsTranslated.leftRecursion n tg.grammarRules = lr at hlr ⊢
  obtain ⟨direct, other, growing⟩ := lr
  constructor
  · rw [contextWith_pass]; exact hpass
  · intro x
    simp only [LabelsTranslated.Ctx.ctxCallers]
    rw [findWithDefault_fromListWith]
    have : HsList.concatMap (fun r => HsList.concatMap tCallerPairs (LabelsTranslated.sites n r)) tg.grammarRules =
        (HsList.concatMap (fun r => LabelsTranslated.sites n r) tg.grammarRules).flatMap tCallerPairs := by
      simp [HsList.concatMap, List.flatMap_assoc]
    rw [this, hsites, callers_list]
    simp only [callers, contextWith_refSites]
  · intro x
    simp only [LabelsTranslated.Ctx.ctxEntries]
    rw [hsSet_member_fromList, start_e h, h.entries, contextWith_entries]
    simp [eLocated, LabelsTranslated.Located.unLoc, Function.comp_def]
  · intro x
    simp only [LabelsTranslated.Ctx.ctxRecovery]
    rw [hsSet_member_fromList, recovery_e h, contextWith_recovery]
  · rw [contextWith_directLr]; exact hlr.direct
  · rw [contextWith_otherLr]; exact hlr.other
  · rw [contextWith_growing]; exact hlr.growing
  · intro x
    simp only [LabelsTranslated.Ctx.ctxRules]
    rw [lookup_fromList, contextWith_rules]
    simp only [HsList.concatMap, flatMap_single]
    exact ruleOpt_findLast h.rules x
  · intro x
    simp only [LabelsTranslated.Ctx.ctxExpandable]
    rw [hsSet_member_difference, hsSet_member_union, hlr.direct, hlr.other, hsSet_member_fromList,
      contextWith_expandable]
    have hl : HsList.concatMap (fun r => if LabelsTranslated.context.expandable_503 r then [r.ruleName] else [])
        tg.grammarRules = (mg.rules.filter fun r => !(r.alts.any (fun a => itemsMention a.items))).map (·.name) := by
      have hr := h.rules
      generalize tg.grammarRules = trs at hr
      generalize mg.rules = mrs at hr
      induction hr with
      | nil => rfl
      | cons hc _ ih =>
        simp only [HsList.concatMap, List.flatMap_cons] at ih ⊢
        rw [ih, expandable_e hc, hc.name]
        split <;> simp_all [List.filter_cons]
    rw [hl]
    apply Bool.eq_iff_iff.2
    simp [List.mem_filter]

