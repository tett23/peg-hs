def mIsSeed (ctx : Ctx) (rule : String) (s : Site) : Bool :=
  match s.frames with
  | [.seq _ 0, .alts _ i true] => s.rule == rule && ctx.directLr.contains rule && ctx.growing rule i
  | _ => false

theorem callersOf_unfold (ctx : Ctx) (rule : String) :
    callersOf ctx rule = (callers ctx rule).filter (fun s => !mIsSeed ctx rule s) := rfl

theorem isSeed_e {tc : LabelsTranslated.Ctx} {mc : Ctx} (h : CtxCorr tc mc) (rule : String) (s : Site) :
    LabelsTranslated.callersOf.isSeed_654 tc rule (eSite s) = mIsSeed mc rule s := by
  obtain ⟨r, fs, l, e⟩ := s
  unfold LabelsTranslated.callersOf.isSeed_654 mIsSeed
  simp only [eSite, LabelsTranslated.siteFrames, LabelsTranslated.siteRule]
  match fs with
  | [] => simp
  | [f] => cases f <;> simp [eFrame]
  | [f1, f2] =>
    cases f1 with
    | seq items j =>
      cases f2 with
      | alts as i body =>
        cases body
        · cases j <;> simp [eFrame]
        · cases j with
          | zero =>
            simp [eFrame, HsBase.eq, HsBase.and, h.directLr rule, h.growing rule i, Bool.and_assoc]
          | succ j => simp [eFrame, HsBase.eq]; omega
      | _ => simp [eFrame]
    | _ => cases f2 <;> simp [eFrame]
  | _ :: _ :: _ :: _ => simp [eFrame]

theorem callersOf_e {tc : LabelsTranslated.Ctx} {mc : Ctx} (h : CtxCorr tc mc) (rule : String) :
    LabelsTranslated.callersOf tc rule = (callersOf mc rule).map eSite := by
  rw [callersOf_unfold]
  simp only [LabelsTranslated.callersOf, h.callers rule, HsList.concatMap, HsBase.not]
  induction callers mc rule with
  | nil => rfl
  | cons s ss ih =>
    simp only [List.map_cons, List.flatMap_cons, ih, isSeed_e h, List.filter_cons]
    cases mIsSeed mc rule s <;> simp

