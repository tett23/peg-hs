theorem exprSites_ev (tr : LabelsTranslated.Rule) (rn : String) (hn : tr.ruleName = rn) :
    (e : Expr) → Eventually (fun n => ∀ (fs : List Frame) (l : Loc),
      LabelsTranslated.sites.exprSites_265 n tr (fs.map eFrame) (eLoc l) (eExpr e) =
        (exprSites rn fs l e).map eSite)
  | .group gs => by
    obtain ⟨N, hN⟩ := altsSites_ev tr rn hn gs
    refine ⟨N + 2, fun n hn' fs l => ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
    rw [LabelsTranslated.sites.exprSites_265]
    simp only [eExpr, LabelsTranslated.sites.isSite_284, ↓reduceIte, HsList.append, exprSites, isSite,
      List.map_append, List.map_cons, List.map_nil, eSite, List.map_map, hn]
    congr 1
    · rw [galts_e]
      have := altSites_part rn fs (groupAlts l gs) false
        (fun k j is item => LabelsTranslated.sites.itemSites_264 (m + 1) tr
          (LabelsTranslated.Frame.FSeq is j :: LabelsTranslated.Frame.FAlts (eGalts (groupAlts l gs)) k false ::
            fs.map eFrame) item)
        (fun k j is i hm hi => by
          obtain ⟨l', hl'⟩ := hm
          have hgs : is ∈ gs := by
            simp only [groupAlts, List.mem_map] at hl'
            obtain ⟨a, ha, he⟩ := hl'
            simp only [Prod.mk.injEq] at he
            rw [← he.2]; exact ha
          rw [LabelsTranslated.sites.itemSites_264]
          simp only [eItem, LabelsTranslated.Item.itemLoc, LabelsTranslated.Item.itemExpr]
          have := hN m (by omega) i (List.mem_flatten.2 ⟨is, hgs, hi⟩) (.seq is j :: .alts (groupAlts l gs) k false :: fs) i.1
          simpa [eFrame] using this)
        (groupAlts l gs) 0 (fun _ hp => hp)
      have hsnd : (groupAlts l gs).map Prod.snd = gs := by simp [groupAlts, Function.comp_def]
      rw [hsnd] at this
      simpa using this
  | .star x => by
    obtain ⟨N, hN⟩ := exprSites_ev tr rn hn x
    refine ⟨N + 1, fun n hn' fs l => ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [LabelsTranslated.sites.exprSites_265]
    have := hN m (by omega) (.star x l :: fs) l
    simp only [List.map_cons, eFrame] at this
    simp [eExpr, LabelsTranslated.sites.isSite_284, HsList.append, exprSites, isSite, this]
  | .plus x => by
    obtain ⟨N, hN⟩ := exprSites_ev tr rn hn x
    refine ⟨N + 1, fun n hn' fs l => ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [LabelsTranslated.sites.exprSites_265]
    have := hN m (by omega) (.plus x l :: fs) l
    simp only [List.map_cons, eFrame] at this
    simp [eExpr, LabelsTranslated.sites.isSite_284, HsList.append, exprSites, isSite, this]
  | .opt x => by
    obtain ⟨N, hN⟩ := exprSites_ev tr rn hn x
    refine ⟨N + 1, fun n hn' fs l => ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [LabelsTranslated.sites.exprSites_265]
    have := hN m (by omega) (.opt :: fs) l
    simp only [List.map_cons, eFrame] at this
    simp [eExpr, LabelsTranslated.sites.isSite_284, HsList.append, exprSites, isSite, this]
  | .and x => by
    obtain ⟨N, hN⟩ := exprSites_ev tr rn hn x
    refine ⟨N + 1, fun n hn' fs l => ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [LabelsTranslated.sites.exprSites_265]
    have := hN m (by omega) (.and l :: fs) l
    simp only [List.map_cons, eFrame] at this
    simp [eExpr, LabelsTranslated.sites.isSite_284, HsList.append, exprSites, isSite, this]
  | .not x => by
    obtain ⟨N, hN⟩ := exprSites_ev tr rn hn x
    refine ⟨N + 1, fun n hn' fs l => ?_⟩
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
    rw [LabelsTranslated.sites.exprSites_265]
    have := hN m (by omega) (.not l :: fs) l
    simp only [List.map_cons, eFrame] at this
    simp [eExpr, LabelsTranslated.sites.isSite_284, HsList.append, exprSites, isSite, this]
  | .capture x => by
