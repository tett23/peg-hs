    simp only [HsBase.and, hc, hr]
    by_cases hcond : (exprEq (plainExpr e) (plainExpr e') &&
        (bx == by' || !((exprCodes e).any (readsAny ((bx ++ by').filterMap id))))) = true
    · simp only [hcond, ↓reduceIte]
      rw [show HsInt.add (n : Int) 1 = ((n + 1 : Nat) : Int) by simp [HsInt.add]]
      exact commonPrefixGo_e (n + 1) _ _ xs ys
    · simp only [hcond, Bool.false_eq_true, ↓reduceIte]

