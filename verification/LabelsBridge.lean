/-- The sites of the items `rest` of a sequence, from the j-th on. -/
theorem itemSites_part (rn : String) (outer : List Frame) (galts : List (Loc × List Item)) (body : Bool)
    (k : Nat) (isAll : List Item) (S : Int → LabelsTranslated.Item → List LabelsTranslated.Site)
    (hS : ∀ (j : Nat) (i : Item), i ∈ isAll → S j (eItem i) =
      (exprSites rn (.seq isAll j :: .alts galts k body :: outer) i.1 i.2.2).map eSite) :
    ∀ (rest : List Item) (j : Nat), (∀ i ∈ rest, i ∈ isAll) →
      HsList.concat (HsList.concatMap (fun p => match p with | (j, item) => [S j item])
          (HsList.zipFrom (j : Int) (eItems rest))) =
        (itemSites rn outer galts body k isAll j rest).map eSite
  | [], j, _ => by simp [eItems, HsList.zipFrom, HsList.concat, HsList.concatMap, itemSites]
  | (l, b, e) :: rest, j, h => by
    have ih := itemSites_part rn outer galts body k isAll S hS rest (j + 1)
      (fun i hi => h i (List.mem_cons_of_mem _ hi))
    have hj := hS j (l, b, e) (h _ (by simp))
    simp only [HsList.concat, HsList.concatMap] at ih ⊢
    rw [eItems, zipFrom_cons, List.flatMap_cons, List.flatten_append]
    simp only [List.flatten_cons, List.flatten_nil, List.append_nil]
    rw [show ((j : Int) + 1) = ((j + 1 : Nat) : Int) by omega, ih, itemSites, List.map_append]
    congr 1


theorem galts_e (l : Loc) (gs : List (List Item)) :
    HsList.concatMap (fun ν91 => match ν91 with
      | is => [((HsBase.maybe (eLoc l) LabelsTranslated.Item.itemLoc (LabelsTranslated.sites.headMay_288 is)), is)])
      (eAlts gs) = eGalts (groupAlts l gs) := by
  induction gs with
  | nil => simp [eAlts, HsList.concatMap, eGalts, groupAlts]
  | cons a as ih =>
    simp only [HsList.concatMap, groupAlts, eGalts] at ih ⊢
    rw [eAlts, List.flatMap_cons, ih]
    simp only [List.map_cons, List.singleton_append]
    congr 2
    cases a with
    | nil => simp [eItems, LabelsTranslated.sites.headMay_288, HsBase.maybe]
    | cons i is =>
      obtain ⟨l', b', e'⟩ := i
      simp [eItems, LabelsTranslated.sites.headMay_288, HsBase.maybe, LabelsTranslated.Item.itemLoc]

