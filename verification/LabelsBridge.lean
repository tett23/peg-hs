    simp [HsText.null, String.isEmpty_iff, String.toList_eq_nil_iff]
  | .ref l n as => by
    rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr]
    exact h n
  | .group alts => by
    rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr]
    exact nullableAlts_e h alts
  | .plus x => by rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr, nullableExpr_e h x]
  | .capture x => by rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr, nullableExpr_e h x]
  | .discard x => by rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr, nullableExpr_e h x]
  | .label l x n => by rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr, nullableExpr_e h x]
  | .cls .. | .any | .star _ | .opt _ | .and _ | .not _ | .pred .. | .template .. => by
    rw [eExpr, LabelsTranslated.nullableExpr, nullableExpr] <;> simp
termination_by e => sizeOf e

