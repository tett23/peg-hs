theorem commonPrefixGo_e : ∀ (n : Nat) (bx by' : List (Option String)) (xs ys : List Item),
    LabelsTranslated.commonPrefix.go_664 n bx by' (eItems xs) (eItems ys) = (commonPrefixGo n bx by' xs ys : Int)
  | n, bx, by', [], ys => by rw [LabelsTranslated.commonPrefix.go_664.eq_def]; cases ys <;> simp [eItems, commonPrefixGo]
  | n, bx, by', _ :: _, [] => by rw [LabelsTranslated.commonPrefix.go_664.eq_def]; simp [eItems, commonPrefixGo]
  | n, bx, by', (l, b, e) :: xs, (l', b', e') :: ys => by
    rw [LabelsTranslated.commonPrefix.go_664.eq_def, commonPrefixGo]
    simp only [eItems, LabelsTranslated.Item.itemExpr, LabelsTranslated.Item.itemBind, itemExpr, itemBind]
    have hc : HsBase.eq (LabelsTranslated.plainExpr (eExpr e)) (LabelsTranslated.plainExpr (eExpr e')) =
        exprEq (plainExpr e) (plainExpr e') := by
      rw [plainExpr_e, plainExpr_e]
      exact structEq_e _ _
    have hr : (HsBase.or (HsBase.eq bx by') (HsBase.not (HsList.any (fun c =>
        LabelsTranslated.commonPrefix.readsAny_669 (HsList.catMaybes (HsList.append bx by')) c)
        (LabelsTranslated.exprCodes (eExpr e))))) =
        (bx == by' || !((exprCodes e).any (readsAny ((bx ++ by').filterMap id)))) := by
      simp only [HsBase.or, HsBase.eq, HsBase.not, HsList.any, HsList.catMaybes, HsList.append, exprCodes_e]
      congr 2
      simp only [readsAny_e]
