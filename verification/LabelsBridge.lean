import LabelsTranslated
import LabelCheckTermination

/-!
The translation of Peg.Grammar.Labels (LabelsTranslated, generated by
TranslateHaskell.hs) against the model LabelCheckModel: the embedding of the
model's values into the translated types, and the functions that do not
recur through the visited set.

A model value is embedded (`eLoc`, `eExpr`, `eCS`, ...): a natural number
becomes an integer, a code point keeps its value, a list of characters
becomes a string. The embedding is injective, so the comparisons of the
translated code (`==` on character sets, expressions, keys) decide the
model's equalities.

Each theorem states that a translated function applied to embedded values
gives the embedding of the model function's value. A function translated
with fuel does so at every fuel from some bound on (`Eventually`).
-/

set_option linter.unusedSimpArgs false

namespace PegHs.LabelsBridge

open PegHs.LabelCheck

/-! ## Fuel -/

/-- `P n` holds at every fuel `n` from some bound on. -/
def Eventually (P : Nat → Prop) : Prop := ∃ N, ∀ n, N ≤ n → P n

theorem Eventually.of {P : Nat → Prop} (h : ∀ n, P n) : Eventually P := ⟨0, fun n _ => h n⟩

theorem Eventually.and {P Q : Nat → Prop} (hp : Eventually P) (hq : Eventually Q) :
    Eventually (fun n => P n ∧ Q n) := by
  obtain ⟨a, ha⟩ := hp
  obtain ⟨b, hb⟩ := hq
  exact ⟨max a b, fun n hn => ⟨ha n (by omega), hb n (by omega)⟩⟩

theorem Eventually.mono {P Q : Nat → Prop} (hp : Eventually P) (h : ∀ n, P n → Q n) : Eventually Q := by
  obtain ⟨a, ha⟩ := hp
  exact ⟨a, fun n hn => h n (ha n hn)⟩

/-- A fuel one less: `P` from some bound on gives `P (n - 1)` from one more on. -/
theorem Eventually.pred {P : Nat → Prop} (hp : Eventually P) : Eventually (fun n => ∃ m, n = m + 1 ∧ P m) := by
  obtain ⟨a, ha⟩ := hp
  exact ⟨a + 1, fun n hn => ⟨n - 1, by omega, ha _ (by omega)⟩⟩

theorem Eventually.forall_mem {α : Type} {P : α → Nat → Prop} :
    ∀ (l : List α), (∀ x ∈ l, Eventually (P x)) → Eventually (fun n => ∀ x ∈ l, P x n)
  | [], _ => ⟨0, fun _ _ x hx => by simp at hx⟩
  | y :: ys, h => by
    obtain ⟨a, ha⟩ := h y (by simp)
    obtain ⟨b, hb⟩ := Eventually.forall_mem ys (fun x hx => h x (by simp [hx]))
    refine ⟨max a b, fun n hn x hx => ?_⟩
    simp only [List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact ha n (by omega)
    · exact hb n (by omega) x hx

/-! ## The embedding -/

def eLoc (l : Loc) : LabelsTranslated.Loc := .Loc l.file l.line l.col

def eLocated (p : Loc × String) : LabelsTranslated.Located String := .Located (eLoc p.1) p.2

theorem hchar_lt (c : HChar) : c.val < 0x110000 := by have := c.le; simp [maxCode] at this; omega

def eChar (c : HChar) : HsChar := ⟨c.val, hchar_lt c⟩

def eCharPair (p : HChar × HChar) : HsChar × HsChar := (eChar p.1, eChar p.2)

mutual
def eExpr : Expr → LabelsTranslated.Expr
  | .lit t w => .ELit t w
  | .cls rs w => .EClass (rs.map eCharPair) w
  | .any => .EAny
  | .ref l n as => .ERef (eLoc l) n (as.map eLocated)
  | .group alts => .EGroup (eAlts alts)
  | .star x => .EStar (eExpr x)
  | .plus x => .EPlus (eExpr x)
  | .opt x => .EOpt (eExpr x)
  | .and x => .EAnd (eExpr x)
  | .not x => .ENot (eExpr x)
  | .capture x => .ECapture (eExpr x)
  | .label l x n => .ELabel (eLoc l) (eExpr x) n
  | .pred b c => .EPred b (eLocated c)
  | .template l n as vs => .ETemplate (eLoc l) n (eList as) (vs.map eLocated)
  | .discard x => .EDiscard (eExpr x)
def eItems : List Item → List LabelsTranslated.Item
  | [] => []
  | (l, b, e) :: is => .Item (eLoc l) b (eExpr e) :: eItems is
def eAlts : List (List Item) → List (List LabelsTranslated.Item)
  | [] => []
  | a :: as => eItems a :: eAlts as
def eList : List Expr → List LabelsTranslated.Expr
  | [] => []
  | e :: es => eExpr e :: eList es
end

def eItem (i : Item) : LabelsTranslated.Item := .Item (eLoc i.1) i.2.1 (eExpr i.2.2)

theorem eItems_map : ∀ (is : List Item), eItems is = is.map eItem
  | [] => by simp [eItems]
  | (l, b, e) :: is => by simp [eItems, eItem, eItems_map is]

theorem eAlts_map : ∀ (as : List (List Item)), eAlts as = as.map eItems
  | [] => by simp [eAlts]
  | a :: as => by simp [eAlts, eAlts_map as]

theorem eList_map : ∀ (es : List Expr), eList es = es.map eExpr
  | [] => by simp [eList]
  | e :: es => by simp [eList, eList_map es]

def eCS (c : CharSet) : LabelsTranslated.CharSet :=
  .CharSet (c.rs.map fun p => ((p.1 : Int), (p.2 : Int))) c.eof

def eAbs (a : Abs) : LabelsTranslated.Abs := .Abs (eCS a.consume) (eCS a.empty) (eCS a.sure)

def eGalts (as : List (Loc × List Item)) : List (LabelsTranslated.Loc × List LabelsTranslated.Item) :=
  as.map fun p => (eLoc p.1, eItems p.2)

def eFrame : Frame → LabelsTranslated.Frame
  | .seq items j => .FSeq (eItems items) j
  | .alts as i body => .FAlts (eGalts as) i body
  | .star x l => .FStar (eExpr x) (eLoc l)
  | .plus x l => .FPlus (eExpr x) (eLoc l)
  | .opt => .FOpt
  | .and l => .FAnd (eLoc l)
  | .not l => .FNot (eLoc l)
  | .label => .FLabel
  | .capture => .FCapture

def eSite (s : Site) : LabelsTranslated.Site := .Site s.rule (s.frames.map eFrame) (eLoc s.loc) (eExpr s.expr)

def eVerdict : Verdict → LabelsTranslated.Verdict
  | .safe => .Safe
  | .mayReject why => .Unsafe why
  | .unchecked why => .Unchecked why

def eMode : Mode → LabelsTranslated.Mode
  | .failed => .Failed
  | .succeeded => .Succeeded

def eSim : Sim → LabelsTranslated.Sim
  | .fail => .SFail
  | .ok t => .SOk (String.ofList t)
  | .unknown => .SUnknown

def eDiag (d : Diagnostic) : LabelsTranslated.Diagnostic := .Diagnostic (eLoc d.loc) d.msg

/-! ## Characters and texts -/

theorem toChar_ofChar (c : Char) : HsText.toChar (HsChar.ofChar c) = c := by
  have h : c.toNat.isValidChar := by
    have := c.valid
    simp only [UInt32.isValidChar] at this
    exact this
  simp [HsText.toChar, HsChar.ofChar, h, Char.ofNat_toNat]

theorem pack_map_ofChar (l : List Char) : HsText.pack (l.map HsChar.ofChar) = String.ofList l := by
  simp [HsText.pack, List.map_map, Function.comp_def, toChar_ofChar]

theorem show_nat (n : Nat) : HsText.pack (HsInt.«show» (n : Int)) = toString n := by
  simp only [HsInt.«show», pack_map_ofChar, String.ofList_toList]
  rfl

theorem showLoc_e (l : Loc) : LabelsTranslated.showLoc (eLoc l) = showLoc l := by
  simp [LabelsTranslated.showLoc, eLoc, showLoc, show_nat, HsText.append, String.append_assoc]

theorem verdictMessage_e (name : String) (v : Verdict) :
    LabelsTranslated.verdictMessage name (eVerdict v) = verdictMessage name v := by
  cases v <;> simp [LabelsTranslated.verdictMessage, eVerdict, verdictMessage, HsText.append, String.append_assoc]

theorem inRanges_nat (rs : List (Nat × Nat)) (c : Char) :
    inRangesNat rs c.toNat = PegHs.AssembleChars.inRanges rs c := by
  simp [inRangesNat, PegHs.AssembleChars.inRanges, Bool.decide_and]

theorem isSpaceChar_eq (c : Char) : isSpaceChar c = isSpace c := by
  simp only [isSpaceChar, isSpace, inRanges_nat]
  rfl

theorem strip_eq (s : String) : HsText.strip s = strip s := by
  simp only [HsText.strip, strip]
  have : isSpaceChar = isSpace := funext isSpaceChar_eq
  rw [this]

theorem constantPred_e (b : Bool) (c : Loc × String) :
    LabelsTranslated.constantPred b (eLocated c) = constantPred b c := by
  simp only [LabelsTranslated.constantPred, eLocated, constantPred, strip_eq, HsBase.eq, HsBase.not]

theorem hsChar_eq_ofNat (c : Char) (n : Nat) (h : n < 0x110000) (hc : n.isValidChar) :
    (HsChar.ofChar c == HsChar.ofNat n) = (c == Char.ofNat n) := by
  have hn : (HsChar.ofNat n) = ⟨n, h⟩ := by simp [HsChar.ofNat, h]
  rw [hn]
  apply Bool.eq_iff_iff.2
  simp only [HsChar.ofChar, beq_iff_eq, HsChar.mk.injEq]
  constructor
  · intro e
    subst e
    exact (Char.ofNat_toNat c).symm
  · intro e
    subst e
    simp [Char.ofNat, hc, Char.ofNatAux]

theorem identChar_e (c : Char) : LabelsTranslated.identChar (HsChar.ofChar c) = identChar c := by
  simp only [LabelsTranslated.identChar, identChar, HsBase.or, HsBase.eq, HsChar.isAlphaNum]
  rw [hsChar_eq_ofNat c 95 (by decide) (by decide), hsChar_eq_ofNat c 39 (by decide) (by decide)]
  simp only [HsChar.ofChar, inRanges_nat, PegHs.AssembleChars.isAlphaNum, Bool.or_assoc]

theorem identStart_e (c : Char) :
    LabelsTranslated.identifiers.identStart_718 (HsChar.ofChar c) = identStart c := by
  simp only [LabelsTranslated.identifiers.identStart_718, identStart, HsBase.or, HsBase.eq, HsChar.isAlpha]
  rw [hsChar_eq_ofNat c 95 (by decide) (by decide)]
  simp only [HsChar.ofChar, inRanges_nat, PegHs.AssembleChars.isAlpha]

theorem splitList_eq (p : Char → Bool) : ∀ (l : List Char), HsText.splitList p l = splitOn p l
  | [] => by simp [HsText.splitList, splitOn]
  | c :: cs => by
    have ih := splitList_eq p cs
    cases h : p c <;> simp [HsText.splitList, splitOn, h, ih]
    generalize splitOn p cs = r
    cases r <;> rfl

theorem identifiers_e (s : String) : LabelsTranslated.identifiers s = identifiers s := by
  simp only [LabelsTranslated.identifiers, identifiers, HsText.split, HsBase.not, HsBase.maybe]
  have hp : (fun c => !LabelsTranslated.identChar (HsChar.ofChar c)) = (fun c => !identChar c) := by
    funext c; rw [identChar_e]
  rw [hp, splitList_eq, List.filter_map]
  congr 1
  apply List.filter_congr
  intro w _
  cases w with
  | nil => simp [Function.comp_def, HsText.uncons, String.toList_ofList]
  | cons c cs => simp [Function.comp_def, HsText.uncons, String.toList_ofList, identStart_e]

theorem isInfixList_eq : ∀ (a b : List Char), HsText.isInfixList a b = isInfix a b
  | a, [] => by simp [HsText.isInfixList, isInfix]
  | a, _ :: rest => by simp [HsText.isInfixList, isInfix, isInfixList_eq a rest]

theorem isInfixOf_eq (a b : String) : HsText.isInfixOf a b = isInfix a.toList b.toList := by
  simp [HsText.isInfixOf, isInfixList_eq]


/-! ## Character sets -/

def cp (p : Nat × Nat) : Int × Int := ((p.1 : Int), (p.2 : Int))

theorem cp_inj {p q : Nat × Nat} (h : cp p = cp q) : p = q := by
  obtain ⟨a, b⟩ := p
  obtain ⟨c, d⟩ := q
  simp only [cp, Prod.mk.injEq, Int.natCast_inj] at h
  rw [h.1, h.2]

theorem map_cp_inj : ∀ {l m : List (Nat × Nat)}, l.map cp = m.map cp → l = m
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | x :: xs, y :: ys, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    rw [cp_inj h.1, map_cp_inj h.2]

theorem insertOn_e (x : Nat × Nat) : ∀ (l : List (Nat × Nat)),
    HsList.insertOn Prod.fst (cp x) (l.map cp) = (insertFst x l).map cp
  | [] => by simp [HsList.insertOn, insertFst]
  | y :: ys => by
    have ih := insertOn_e x ys
    simp only [cp] at ih
    by_cases h : x.1 ≤ y.1
    · have h' : ((x.1 : Int) ≤ (y.1 : Int)) := by omega
      simp [HsList.insertOn, insertFst, cp, h, h']
    · have h' : ¬((x.1 : Int) ≤ (y.1 : Int)) := by omega
      simp [HsList.insertOn, insertFst, cp, h, h', ih]

theorem sortOn_e : ∀ (l : List (Nat × Nat)), HsList.sortOn Prod.fst (l.map cp) = (sortFst l).map cp
  | [] => by simp [HsList.sortOn, sortFst]
  | x :: xs => by simp only [List.map_cons, HsList.sortOn, sortFst, sortOn_e xs, insertOn_e]

theorem merge_e : ∀ (n : Nat) (l : List (Nat × Nat)), l.length ≤ n →
    LabelsTranslated.normalise.merge_79 (l.map cp) = (mergeR l).map cp
  | 0, l, h => by
    cases l with
    | nil => rw [LabelsTranslated.normalise.merge_79, mergeR] <;> simp
    | cons _ _ => simp at h
  | n + 1, l, h => by
    match l with
    | (a, b) :: (c, d) :: rest =>
      rw [mergeR]
      simp only [List.map_cons, cp]
      rw [LabelsTranslated.normalise.merge_79]
      simp only [HsInt.le, HsInt.add, HsInt.max]
      by_cases hc : c ≤ b + 1
      · have hc' : ((c : Int) ≤ (b : Int) + 1) := by omega
        simp only [hc, hc', decide_true, ↓reduceIte]
        have hm : (if (b : Int) ≤ (d : Int) then (d : Int) else (b : Int)) = ((max b d : Nat) : Int) := by
          split <;> omega
        rw [hm]
        have := merge_e n ((a, max b d) :: rest) (by simp at h ⊢; omega)
        simpa [cp] using this
      · have hc' : ¬((c : Int) ≤ (b : Int) + 1) := by omega
        simp only [hc, hc', decide_false, Bool.false_eq_true, ↓reduceIte, List.map_cons]
        have := merge_e n ((c, d) :: rest) (by simp at h ⊢; omega)
        simpa [cp] using this
    | [] => rw [LabelsTranslated.normalise.merge_79, mergeR] <;> simp
    | [(a, b)] => rw [LabelsTranslated.normalise.merge_79, mergeR] <;> simp [cp]

theorem normalise_e (l : List (Nat × Nat)) :
    LabelsTranslated.normalise (l.map cp) = (normalise l).map cp := by
  simp only [LabelsTranslated.normalise, normalise, sortOn_e]
  exact merge_e _ _ (Nat.le_refl _)

theorem eCS_rs (c : CharSet) : eCS c = .CharSet (c.rs.map cp) c.eof := rfl

theorem union_e (a b : CharSet) : LabelsTranslated.union (eCS a) (eCS b) = eCS (a.union b) := by
  simp only [eCS_rs, LabelsTranslated.union, CharSet.union, HsList.append, HsBase.or, ← List.map_append,
    normalise_e]

theorem interGo_e : ∀ (n : Nat) (xs ys : List (Nat × Nat)), xs.length + ys.length ≤ n →
    LabelsTranslated.intersect.go_90 (xs.map cp) (ys.map cp) = (interGo xs ys).map cp
  | 0, [], ys, _ => by rw [LabelsTranslated.intersect.go_90, interGo] <;> simp
  | 0, _ :: _, _, h => by simp at h
  | n + 1, [], ys, _ => by rw [LabelsTranslated.intersect.go_90, interGo] <;> simp
  | n + 1, _ :: _, [], _ => by rw [LabelsTranslated.intersect.go_90, interGo] <;> simp
  | n + 1, (x1, y1) :: xs, (x2, y2) :: ys, h => by
    rw [interGo]
    simp only [List.map_cons, cp]
    rw [LabelsTranslated.intersect.go_90]
    simp only [HsInt.lt, HsInt.max, HsInt.min]
    simp only [List.length_cons] at h
    by_cases h1 : y1 < x2
    · have h1' : ((y1 : Int) < (x2 : Int)) := by omega
      simp only [h1, h1', decide_true, ↓reduceIte]
      have := interGo_e n xs ((x2, y2) :: ys) (by simp; omega)
      simpa [cp] using this
    · have h1' : ¬((y1 : Int) < (x2 : Int)) := by omega
      simp only [h1, h1', decide_false, Bool.false_eq_true, ↓reduceIte]
      by_cases h2 : y2 < x1
      · have h2' : ((y2 : Int) < (x1 : Int)) := by omega
        simp only [h2, h2', decide_true, ↓reduceIte]
        have := interGo_e n ((x1, y1) :: xs) ys (by simp; omega)
        simpa [cp] using this
      · have h2' : ¬((y2 : Int) < (x1 : Int)) := by omega
        simp only [h2, h2', decide_false, Bool.false_eq_true, ↓reduceIte, List.map_cons]
        have hmax : (if (x1 : Int) ≤ (x2 : Int) then (x2 : Int) else (x1 : Int)) = ((max x1 x2 : Nat) : Int) := by
          split <;> omega
        have hmin : (if (y1 : Int) ≤ (y2 : Int) then (y1 : Int) else (y2 : Int)) = ((min y1 y2 : Nat) : Int) := by
          split <;> omega
        rw [hmax, hmin]
        by_cases h3 : y1 < y2
        · have h3' : ((y1 : Int) < (y2 : Int)) := by omega
          simp only [h3, h3', decide_true, ↓reduceIte]
          have := interGo_e n xs ((x2, y2) :: ys) (by simp; omega)
          simp only [List.map_cons, cp] at this
          rw [this]; rfl
        · have h3' : ¬((y1 : Int) < (y2 : Int)) := by omega
          simp only [h3, h3', decide_false, Bool.false_eq_true, ↓reduceIte]
          have := interGo_e n ((x1, y1) :: xs) ys (by simp; omega)
          simp only [List.map_cons, cp] at this
          rw [this]; rfl

theorem intersect_e (a b : CharSet) : LabelsTranslated.intersect (eCS a) (eCS b) = eCS (a.intersect b) := by
  simp only [eCS_rs, LabelsTranslated.intersect, CharSet.intersect, HsBase.and,
    interGo_e _ a.rs b.rs (Nat.le_refl _)]

theorem minusGo_e : ∀ (n : Nat) (xs ys : List (Nat × Nat)), xs.length + ys.length ≤ n →
    LabelsTranslated.minus.go_100 (xs.map cp) (ys.map cp) = (minusGo xs ys).map cp
  | 0, [], ys, _ => by rw [LabelsTranslated.minus.go_100.eq_def, minusGo] <;> simp
  | 0, _ :: _, _, h => by simp at h
  | n + 1, [], ys, _ => by rw [LabelsTranslated.minus.go_100.eq_def, minusGo] <;> simp
  | n + 1, x :: xs, [], _ => by rw [LabelsTranslated.minus.go_100.eq_def, minusGo] <;> simp
  | n + 1, (x1, y1) :: xs, (x2, y2) :: ys, h => by
    rw [minusGo]
    simp only [List.map_cons, cp]
    rw [LabelsTranslated.minus.go_100.eq_def]
    simp only [HsInt.lt, HsInt.sub, HsInt.add, HsList.append]
    simp only [List.length_cons] at h
    have ih1 := minusGo_e n ((x1, y1) :: xs) ys (by simp; omega)
    have ih2 := minusGo_e n xs ((x2, y2) :: ys) (by simp; omega)
    have ih3 := minusGo_e n ((y2 + 1, y1) :: xs) ys (by simp; omega)
    simp only [List.map_cons, cp] at ih1 ih2 ih3
    rw [show ((y2 + 1 : Nat) : Int) = (y2 : Int) + 1 by omega] at ih3
    by_cases h1 : y2 < x1
    · have h1' : ((y2 : Int) < (x1 : Int)) := by omega
      simp [h1, h1', ih1]
    · have h1' : ¬((y2 : Int) < (x1 : Int)) := by omega
      by_cases h2 : y1 < x2
      · have h2' : ((y1 : Int) < (x2 : Int)) := by omega
        simp [h1, h1', h2, h2', ih2, cp]
      · have h2' : ¬((y1 : Int) < (x2 : Int)) := by omega
        by_cases h4 : x1 < x2
        · have h4' : ((x1 : Int) < (x2 : Int)) := by omega
          have h5 : ((x2 - 1 : Nat) : Int) = (x2 : Int) - 1 := by omega
          by_cases h3 : y2 < y1
          · have h3' : ((y2 : Int) < (y1 : Int)) := by omega
            simp [h1, h1', h2, h2', h3, h3', h4, h4', h5, ih3, cp]
          · have h3' : ¬((y2 : Int) < (y1 : Int)) := by omega
            simp [h1, h1', h2, h2', h3, h3', h4, h4', h5, ih2, cp]
        · have h4' : ¬((x1 : Int) < (x2 : Int)) := by omega
          by_cases h3 : y2 < y1
          · have h3' : ((y2 : Int) < (y1 : Int)) := by omega
            simp [h1, h1', h2, h2', h3, h3', h4, h4', ih3, cp]
          · have h3' : ¬((y2 : Int) < (y1 : Int)) := by omega
            simp [h1, h1', h2, h2', h3, h3', h4, h4', ih2, cp]

theorem minus_e (a b : CharSet) : LabelsTranslated.minus (eCS a) (eCS b) = eCS (a.minus b) := by
  simp only [eCS_rs, LabelsTranslated.minus, CharSet.minus, HsBase.and, HsBase.not,
    minusGo_e _ a.rs b.rs (Nat.le_refl _)]

theorem isEmpty_e (a : CharSet) : LabelsTranslated.isEmpty (eCS a) = a.isEmpty := by
  simp [eCS_rs, LabelsTranslated.isEmpty, CharSet.isEmpty, HsBase.and, HsBase.not, HsList.null]

theorem meets_e (a b : CharSet) : LabelsTranslated.meets (eCS a) (eCS b) = a.meets b := by
  simp [LabelsTranslated.meets, CharSet.meets, HsBase.not, intersect_e, isEmpty_e]

theorem none_e : LabelsTranslated.none_ = eCS CharSet.none := rfl
theorem everything_e : LabelsTranslated.everything = eCS everything := by
  simp [LabelsTranslated.everything, eCS, everything, LabelsTranslated.maxCode, maxCode, cp]
theorem anyChar_e : LabelsTranslated.anyChar = eCS anyChar := by
  simp [LabelsTranslated.anyChar, eCS, anyChar, LabelsTranslated.maxCode, maxCode, cp]
theorem endOfInput_e : LabelsTranslated.endOfInput = eCS endOfInput := rfl

theorem ranges_pairs : ∀ (rs : List (HChar × HChar)),
    HsList.concatMap (fun p => match p with
      | (a, b) => if HsChar.le a b then [(HsChar.fromEnum a, HsChar.fromEnum b)] else []) (rs.map eCharPair) =
      ((rs.filter (fun p => decide (p.1.val ≤ p.2.val))).map (fun p => (p.1.val, p.2.val))).map cp
  | [] => by simp [HsList.concatMap]
  | p :: ps => by
    have ih := ranges_pairs ps
    simp only [HsList.concatMap] at ih ⊢
    rw [List.map_cons, List.flatMap_cons, ih]
    by_cases h : p.1.val ≤ p.2.val
    · have h' : HsChar.le (eCharPair p).1 (eCharPair p).2 = true := by
        simp [HsChar.le, eCharPair, eChar, h]
      simp only [h', ↓reduceIte, List.filter_cons, h, decide_true]
      simp [eCharPair, eChar, HsChar.fromEnum, cp]
    · have h' : HsChar.le (eCharPair p).1 (eCharPair p).2 = false := by
        simp [HsChar.le, eCharPair, eChar, h]
      simp only [h', Bool.false_eq_true, ↓reduceIte, List.filter_cons, h, decide_false, List.nil_append]

theorem ranges_e (rs : List (HChar × HChar)) :
    LabelsTranslated.ranges (rs.map eCharPair) = eCS (ranges rs) := by
  simp only [LabelsTranslated.ranges, ranges, ranges_pairs, normalise_e, eCS_rs]

theorem single_e (c : Char) : LabelsTranslated.single (HsChar.ofChar c) = eCS (single c) := by
  simp [LabelsTranslated.single, LabelsTranslated.ranges, single, HsChar.le, HsChar.fromEnum,
    HsChar.ofChar, HsList.concatMap, eCS_rs, ← normalise_e, cp]

theorem charSet_beq_e (a b : CharSet) : (eCS a == eCS b) = decide (a = b) := by
  obtain ⟨ra, ea⟩ := a
  obtain ⟨rb, eb⟩ := b
  show LabelsTranslated.instBEqCharSet.beq _ _ = _
  simp only [eCS_rs, LabelsTranslated.instBEqCharSet.beq]
  apply Bool.eq_iff_iff.2
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, CharSet.mk.injEq]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨map_cp_inj h1, h2⟩
  · rintro ⟨rfl, rfl⟩
    exact ⟨rfl, rfl⟩


/-! ## The abstraction of an expression -/

theorem bottom_e : LabelsTranslated.bottom = eAbs bottom := rfl

theorem epsilon_e : LabelsTranslated.epsilon = eAbs epsilon := by
  simp [LabelsTranslated.epsilon, eAbs, epsilon, everything_e, none_e]

theorem possible_e (a : Abs) : LabelsTranslated.possible (eAbs a) = eCS (possible a) := by
  simp [LabelsTranslated.possible, eAbs, possible, LabelsTranslated.Abs.absConsume,
    LabelsTranslated.Abs.absEmpty, union_e]

theorem andThen_e (x y : Abs) : LabelsTranslated.andThen (eAbs x) (eAbs y) = eAbs (andThen x y) := by
  simp only [LabelsTranslated.andThen, eAbs, LabelsTranslated.Abs.absConsume, LabelsTranslated.Abs.absEmpty,
    LabelsTranslated.Abs.absSure, intersect_e, union_e, HsBase.eq, everything_e, charSet_beq_e, andThen,
    none_e]
  congr 1
  by_cases h : y.sure = everything <;> simp [h]

theorem orElse_e (x y : Abs) : LabelsTranslated.orElse (eAbs x) (eAbs y) = eAbs (orElse x y) := by
  simp [LabelsTranslated.orElse, eAbs, LabelsTranslated.Abs.absConsume, LabelsTranslated.Abs.absEmpty,
    LabelsTranslated.Abs.absSure, union_e, orElse]

/-- The translated pass and the model's pass agree on embedded values. -/
structure PassCorr (tp : LabelsTranslated.Pass) (mp : Pass) : Prop where
  env : ∀ n, HsMap.findWithDefault LabelsTranslated.bottom n tp.passEnv = eAbs ((findLast mp.env n).getD bottom)
  notEmpty : ∀ e, tp.passNotEmpty (eExpr e) = eCS (mp.notEmpty e)
  notSure : ∀ e, tp.passNotSure (eExpr e) = eCS (mp.notSure e)

theorem uncons_toList (t : String) :
    HsText.uncons t = match t.toList with
      | [] => none
      | c :: cs => some (HsChar.ofChar c, String.ofList cs) := rfl

mutual
theorem exprAbs_e {tp : LabelsTranslated.Pass} {mp : Pass} (h : PassCorr tp mp) :
    (e : Expr) → LabelsTranslated.exprAbs tp (eExpr e) = eAbs (exprAbs mp e)
  | .lit t w => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp only [uncons_toList]
    cases ht : t.toList with
    | nil => simp [epsilon_e]
    | cons c cs =>
      simp only [single_e, none_e, HsText.null, String.toList_ofList, eAbs]
      cases cs <;> simp
  | .cls rs w => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [ranges_e, none_e, eAbs]
  | .any => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [anyChar_e, none_e, eAbs]
  | .ref l n as => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    exact h.env n
  | .group alts => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    exact altsAbs_e h alts
  | .star x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [exprAbs_e h x, eAbs, everything_e, LabelsTranslated.Abs.absConsume]
  | .plus x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [exprAbs_e h x, eAbs, LabelsTranslated.Abs.absConsume, LabelsTranslated.Abs.absEmpty,
      LabelsTranslated.Abs.absSure]
  | .opt x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [exprAbs_e h x, eAbs, everything_e, LabelsTranslated.Abs.absConsume]
  | .and x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp only [exprAbs_e h x, possible_e]
    simp [eAbs, none_e, LabelsTranslated.Abs.absSure]
  | .not x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [h.notEmpty x, h.notSure x, eAbs, none_e]
  | .capture x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    exact exprAbs_e h x
  | .label l x n => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    exact exprAbs_e h x
  | .discard x => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    exact exprAbs_e h x
  | .template l n as vs => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp [eAbs, everything_e, none_e]
  | .pred b c => by
    rw [eExpr, LabelsTranslated.exprAbs, exprAbs]
    simp only [constantPred_e]
    cases constantPred b c with
    | none => simp [eAbs, none_e, everything_e]
    | some v => cases v <;> simp [epsilon_e, bottom_e]
termination_by e => sizeOf e

theorem seqAbs_e {tp : LabelsTranslated.Pass} {mp : Pass} (h : PassCorr tp mp) :
    (is : List Item) → LabelsTranslated.seqAbs tp (eItems is) = eAbs (seqAbs mp is)
  | [] => by
    rw [eItems, LabelsTranslated.seqAbs, seqAbs]
    simp [HsList.foldr, epsilon_e]
  | (l, b, e) :: is => by
    have ih := seqAbs_e h is
    rw [LabelsTranslated.seqAbs] at ih
    rw [eItems, LabelsTranslated.seqAbs, seqAbs]
    simp only [HsList.foldr, List.foldr_cons] at ih ⊢
    rw [ih, LabelsTranslated.Item.itemExpr, exprAbs_e h e, andThen_e]
termination_by is => sizeOf is

theorem altsAbs_e {tp : LabelsTranslated.Pass} {mp : Pass} (h : PassCorr tp mp) :
    (as : List (List Item)) →
      HsList.foldr (fun a b => LabelsTranslated.orElse a b) LabelsTranslated.bottom
        (List.map (fun a => LabelsTranslated.seqAbs tp a) (eAlts as)) = eAbs (altsAbs mp as)
  | [] => by
    rw [eAlts, altsAbs]
    simp [HsList.foldr, bottom_e]
  | a :: as => by
    have ih := altsAbs_e h as
    rw [eAlts, altsAbs]
    simp only [HsList.foldr, List.map_cons, List.foldr_cons] at ih ⊢
    rw [ih, seqAbs_e h a, orElse_e]
termination_by as => sizeOf as
end


/-! ## Plain expressions and equality -/

theorem eLoc_noLoc : eLoc noLoc = .Loc 0 0 0 := rfl

theorem flatMap_single {α β : Type} (f : α → β) : ∀ (l : List α), l.flatMap (fun x => [f x]) = l.map f
  | [] => rfl
  | x :: xs => by simp [flatMap_single f xs]

theorem map_inj_of {α β : Type} {f : α → β} (hf : ∀ a b, f a = f b → a = b) :
    ∀ {l m : List α}, l.map f = m.map f → l = m
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | x :: xs, y :: ys, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    rw [hf _ _ h.1, map_inj_of hf h.2]

mutual
theorem plainExpr_e : (e : Expr) → LabelsTranslated.plainExpr (eExpr e) = eExpr (plainExpr e)
  | .lit .. | .cls .. | .any => by
    rw [eExpr, LabelsTranslated.plainExpr, plainExpr] <;> simp [eExpr]
  | .ref l n as => by
    rw [eExpr, LabelsTranslated.plainExpr, plainExpr]
    simp [eExpr, eLoc_noLoc, HsList.concatMap, eLocated, LabelsTranslated.Located.unLoc, flatMap_single,
      Function.comp_def]
  | .group alts => by
    rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr]
    congr 1
    exact plainAlts_e alts
  | .star x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .plus x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .opt x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .and x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .not x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .capture x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .discard x => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr, plainExpr_e x]
  | .label l x n => by rw [eExpr, LabelsTranslated.plainExpr, plainExpr, plainExpr_e x]
  | .pred b c => by
    rw [eExpr, LabelsTranslated.plainExpr, plainExpr]
    simp [eExpr, eLocated, eLoc_noLoc]
  | .template l n as vs => by
    rw [eExpr, LabelsTranslated.plainExpr, plainExpr, eExpr]
    simp only [eLoc_noLoc, plainList_e as]
    simp [HsList.concatMap, eLocated, LabelsTranslated.Located.unLoc, eLoc_noLoc, flatMap_single,
      Function.comp_def]
termination_by e => sizeOf e

theorem plainAlts_e : (as : List (List Item)) →
    List.map (fun a => List.map (fun i => LabelsTranslated.Item.Item (.Loc 0 0 0) none
      (LabelsTranslated.plainExpr i.itemExpr)) a) (eAlts as) = eAlts (plainAlts as)
  | [] => by simp [eAlts, plainAlts]
  | a :: as => by
    rw [eAlts, plainAlts, eAlts, List.map_cons, plainAlts_e as, plainItems_e a]
termination_by as => sizeOf as

theorem plainItems_e : (is : List Item) →
    List.map (fun i => LabelsTranslated.Item.Item (.Loc 0 0 0) none
      (LabelsTranslated.plainExpr i.itemExpr)) (eItems is) = eItems (plainItems is)
  | [] => by simp [eItems, plainItems]
  | (l, b, e) :: is => by
    rw [eItems, plainItems, eItems, List.map_cons, plainItems_e is, LabelsTranslated.Item.itemExpr,
      plainExpr_e e, eLoc_noLoc]
termination_by is => sizeOf is

theorem plainList_e : (es : List Expr) →
    List.map (fun e => LabelsTranslated.plainExpr e) (eList es) = eList (plainList es)
  | [] => by simp [eList, plainList]
  | e :: es => by rw [eList, plainList, eList, List.map_cons, plainList_e es, plainExpr_e e]
termination_by es => sizeOf es
end

instance : LawfulBEq Loc where
  eq_of_beq {a b} h := by
    cases a; cases b
    simp [BEq.beq, PegHs.LabelCheck.instBEqLoc.beq] at h
    simp [h]
  rfl {a} := by cases a; simp [BEq.beq, PegHs.LabelCheck.instBEqLoc.beq]

instance : LawfulBEq HChar where
  eq_of_beq {a b} h := by
    cases a; cases b
    simp only [BEq.beq, beq_iff_eq] at h
    simp at h
    subst h; rfl
  rfl {a} := by simp [BEq.beq]

theorem eLoc_inj {l l' : Loc} (h : eLoc l = eLoc l') : l = l' := by
  cases l; cases l'
  simp only [eLoc, LabelsTranslated.Loc.Loc.injEq, Int.natCast_inj] at h
  rw [h.1, h.2.1, h.2.2]

theorem locStructEq_e (l l' : Loc) : LabelsTranslated.Loc.structEq (eLoc l) (eLoc l') = (l == l') := by
  cases l; cases l'
  apply Bool.eq_iff_iff.2
  simp [LabelsTranslated.Loc.structEq, eLoc, beq_iff_eq, Int.natCast_inj, and_assoc]

theorem locatedListEq_e : ∀ (as as' : List (Loc × String)),
    LabelsTranslated.Located.listEq (as.map eLocated) (as'.map eLocated) = (as == as')
  | [], [] => by simp [LabelsTranslated.Located.listEq]
  | [], _ :: _ => by simp [LabelsTranslated.Located.listEq]
  | _ :: _, [] => by simp [LabelsTranslated.Located.listEq]
  | (l, x) :: as, (l', x') :: as' => by
    rw [List.map_cons, List.map_cons, LabelsTranslated.Located.listEq, locatedListEq_e as as']
    simp only [eLocated, LabelsTranslated.Located.structEq, locStructEq_e]
    apply Bool.eq_iff_iff.2
    simp [beq_iff_eq, and_assoc]

theorem eCharPair_inj {p q : HChar × HChar} (h : eCharPair p = eCharPair q) : p = q := by
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := p
  obtain ⟨⟨c, hc⟩, ⟨d, hd⟩⟩ := q
  simp only [eCharPair, eChar, Prod.mk.injEq, HsChar.mk.injEq] at h
  obtain ⟨rfl, rfl⟩ := h
  rfl

theorem charPairs_beq_e (rs rs' : List (HChar × HChar)) :
    (rs.map eCharPair == rs'.map eCharPair) = (rs == rs') := by
  apply Bool.eq_iff_iff.2
  simp only [beq_iff_eq]
  constructor
  · intro h
    exact map_inj_of (fun _ _ h => eCharPair_inj h) h
  · intro h; rw [h]

mutual
theorem structEq_e : (x y : Expr) → LabelsTranslated.Expr.structEq (eExpr x) (eExpr y) = exprEq x y
  | .lit t w, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq]
  | .cls rs w, y => by
    cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, charPairs_beq_e]
  | .any, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq]
  | .ref l n as, y => by
    cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, locStructEq_e, locatedListEq_e]
  | .group a, y => by
    cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, altsEq_e a]
  | .star x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .plus x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .opt x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .and x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .not x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .capture x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .discard x, y => by cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x]
  | .label l x n, y => by
    cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, structEq_e x, locStructEq_e]
  | .pred b c, y => by
    cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, eLocated,
      LabelsTranslated.Located.structEq, locStructEq_e]
    all_goals (apply Bool.eq_iff_iff.2; simp [beq_iff_eq, Prod.ext_iff])
  | .template l n as vs, y => by
    cases y <;> simp [eExpr, LabelsTranslated.Expr.structEq, exprEq, locStructEq_e, locatedListEq_e,
      listEq_e as]
termination_by x => sizeOf x

theorem itemsEq_e : (a a' : List Item) → LabelsTranslated.Expr.itemsEq (eItems a) (eItems a') = itemsEq a a'
  | [], [] => by simp [eItems, LabelsTranslated.Expr.itemsEq, itemsEq]
  | [], _ :: _ => by simp [eItems, LabelsTranslated.Expr.itemsEq, itemsEq]
  | _ :: _, [] => by simp [eItems, LabelsTranslated.Expr.itemsEq, itemsEq]
  | (l, b, e) :: is, (l', b', e') :: is' => by
    simp only [eItems, LabelsTranslated.Expr.itemsEq, itemsEq, LabelsTranslated.Expr.itemEq,
      locStructEq_e, structEq_e e e', itemsEq_e is is', Bool.and_assoc]
termination_by a => sizeOf a

theorem altsEq_e : (a a' : List (List Item)) → LabelsTranslated.Expr.altsEq (eAlts a) (eAlts a') = altsEq a a'
  | [], [] => by simp [eAlts, LabelsTranslated.Expr.altsEq, altsEq]
  | [], _ :: _ => by simp [eAlts, LabelsTranslated.Expr.altsEq, altsEq]
  | _ :: _, [] => by simp [eAlts, LabelsTranslated.Expr.altsEq, altsEq]
  | x :: xs, y :: ys => by
    simp only [eAlts, LabelsTranslated.Expr.altsEq, altsEq, itemsEq_e x y, altsEq_e xs ys]
termination_by a => sizeOf a

theorem listEq_e : (a a' : List Expr) → LabelsTranslated.Expr.listEq (eList a) (eList a') = listEq a a'
  | [], [] => by simp [eList, LabelsTranslated.Expr.listEq, listEq]
  | [], _ :: _ => by simp [eList, LabelsTranslated.Expr.listEq, listEq]
  | _ :: _, [] => by simp [eList, LabelsTranslated.Expr.listEq, listEq]
  | x :: xs, y :: ys => by
    simp only [eList, LabelsTranslated.Expr.listEq, listEq, structEq_e x y, listEq_e xs ys]
termination_by a => sizeOf a
end


/-! ## Codes, mentions, labels removed, nullable expressions, left calls -/

theorem elem_contains {α : Type} [BEq α] [LawfulBEq α] (x : α) (xs : List α) : HsList.elem x xs = xs.contains x := by
  induction xs with
  | nil => rfl
  | cons y ys ih =>
    simp only [HsList.elem, List.any_cons, List.contains_cons] at ih ⊢
    rw [ih]
    by_cases h : x = y
    · simp [h]
    · have h1 : (y == x) = false := by simpa using Ne.symm h
      have h2 : (x == y) = false := by simpa using h
      rw [h1, h2]

theorem concatMap_eq_flatMap {α β : Type} (f : α → List β) (l : List α) : HsList.concatMap f l = l.flatMap f := rfl

mutual
theorem exprCodes_e : (e : Expr) → LabelsTranslated.exprCodes (eExpr e) = exprCodes e
  | .ref l n as => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes]
    simp [eExpr, eLocated, LabelsTranslated.Located.unLoc, Function.comp_def]
  | .pred b c => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes]
    simp [eExpr, eLocated, LabelsTranslated.Located.unLoc]
  | .lit .. | .cls .. | .any => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes] <;>
      simp [eExpr, LabelsTranslated.subExprs, HsList.concatMap]
  | .group alts => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes]
    simp only [eExpr, LabelsTranslated.subExprs]
    exact altsCodes_e alts
  | .star x | .plus x | .opt x | .and x | .not x | .capture x | .discard x => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes] <;>
      simp [eExpr, LabelsTranslated.subExprs, HsList.concatMap, exprCodes_e x]
  | .label l x n => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes]
    simp [eExpr, LabelsTranslated.subExprs, HsList.concatMap, exprCodes_e x]
  | .template l n as vs => by
    rw [LabelsTranslated.exprCodes.eq_def, exprCodes]
    simp only [eExpr, LabelsTranslated.subExprs]
    exact listCodes_e as
termination_by e => sizeOf e

theorem itemsCodes_e : (is : List Item) →
    HsList.concatMap (fun x => LabelsTranslated.exprCodes x) ((eItems is).map LabelsTranslated.Item.itemExpr) =
      itemsCodes is
  | [] => by simp [eItems, itemsCodes, HsList.concatMap]
  | (l, b, e) :: is => by
    have ih := itemsCodes_e is
    simp only [HsList.concatMap] at ih ⊢
    simp [eItems, itemsCodes, LabelsTranslated.Item.itemExpr, exprCodes_e e, ih]
termination_by is => sizeOf is

theorem altsCodes_e : (as : List (List Item)) →
    HsList.concatMap (fun x => LabelsTranslated.exprCodes x)
      (List.map LabelsTranslated.Item.itemExpr (HsList.concat (eAlts as))) = altsCodes as
  | [] => by simp [eAlts, altsCodes, HsList.concatMap, HsList.concat]
  | a :: as => by
    have ih := altsCodes_e as
    have ia := itemsCodes_e a
    simp only [HsList.concatMap, HsList.concat] at ih ia ⊢
    simp only [eAlts, List.flatten_cons, List.map_append, List.flatMap_append, ih, ia, altsCodes]
termination_by as => sizeOf as

theorem listCodes_e : (es : List Expr) →
    HsList.concatMap (fun x => LabelsTranslated.exprCodes x) (eList es) = listCodes es
  | [] => by simp [eList, listCodes, HsList.concatMap]
  | e :: es => by
    have ih := listCodes_e es
    simp only [HsList.concatMap] at ih ⊢
    simp [eList, listCodes, exprCodes_e e, ih]
termination_by es => sizeOf es
end

theorem isTemplateOrEnv_504_eq (e : LabelsTranslated.Expr) :
    LabelsTranslated.context.isTemplateOrEnv_504 e =
      ((match e with | .ETemplate .. => true | _ => false) ||
        (LabelsTranslated.exprCodes e).any (fun c => HsList.elem "_env" (LabelsTranslated.identifiers c))) := by
  cases e <;> simp [LabelsTranslated.context.isTemplateOrEnv_504, HsList.any]

theorem isTemplateOrEnv_eq (e : Expr) :
    isTemplateOrEnv e =
      ((match e with | .template .. => true | _ => false) ||
        (exprCodes e).any (fun c => (identifiers c).contains "_env")) := by
  cases e <;> simp [isTemplateOrEnv]

theorem isTemplateOrEnv_e (e : Expr) :
    LabelsTranslated.context.isTemplateOrEnv_504 (eExpr e) = isTemplateOrEnv e := by
  rw [isTemplateOrEnv_504_eq, isTemplateOrEnv_eq, exprCodes_e]
  simp only [identifiers_e, elem_contains]
  congr 1
  cases e <;> simp [eExpr]

mutual
theorem mentions_e : (e : Expr) →
    LabelsTranslated.exprMentions (fun x => LabelsTranslated.context.isTemplateOrEnv_504 x) (eExpr e) =
      mentionsTemplateOrEnv e
  | .group alts => by
    rw [LabelsTranslated.exprMentions, mentionsTemplateOrEnv]
    simp only [isTemplateOrEnv_e, HsBase.or]
    congr 1
    simp only [eExpr, LabelsTranslated.subExprs]
    exact altsMention_e alts
  | .star x | .plus x | .opt x | .and x | .not x | .capture x | .discard x | .label _ x _ => by
    rw [LabelsTranslated.exprMentions, mentionsTemplateOrEnv]
    simp only [isTemplateOrEnv_e]
    simp [HsBase.or, eExpr, LabelsTranslated.subExprs, HsList.any, mentions_e x]
  | .template l n as vs => by
    rw [LabelsTranslated.exprMentions, mentionsTemplateOrEnv]
