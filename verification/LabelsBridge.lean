          (HsInt.gt (n : Int) 1000)) = false := by
        simp only [HsBase.or, HsInt.gt] at hstop ⊢
        have : ((n : Int) ≤ 1000) ↔ n ≤ 1000 := by omega
        simpa [this] using hstop
      have hstop2 : (envEq rulesM (rulesM.map fun r => (r.name, ruleAbs (mkM me) r)) me || decide (n > 1000)) = false := by
        simpa using hstop
      simp only [hstop', Bool.false_eq_true, ↓reduceIte, hstop2]
      have hn : n ≤ 1000 := by simp at hstop2; omega
      have := ih (n + 1) _ _ (by omega) hk' he' f (by omega)
      simpa [HsInt.add] using this

theorem fixpoint_e {rulesT : List LabelsTranslated.Rule} {rulesM : List Rule} (hr : RulesCorr rulesT rulesM)
    {mkT : HsMap String LabelsTranslated.Abs → LabelsTranslated.Pass} {mkM : Env → Pass}
