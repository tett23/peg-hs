    intro n te me hb hk he fuel hf
    obtain ⟨f, rfl⟩ : ∃ f, fuel = f + 1 := ⟨fuel - 1, by omega⟩
    rw [LabelsTranslated.fixpoint.go_197, fixpointGo]
    have hlist : HsList.concatMap (fun r => [(r.ruleName, LabelsTranslated.ruleAbs (mkT te) r)]) rulesT =
