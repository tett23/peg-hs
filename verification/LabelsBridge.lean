    simp [eExpr, LabelsTranslated.sites.isSite_284, HsList.append, exprSites, isSite]
termination_by e => sizeOf e

theorem altsSites_ev (tr : LabelsTranslated.Rule) (rn : String) (hn : tr.ruleName = rn) :
    (gs : List (List Item)) → Eventually (fun n => ∀ i ∈ gs.flatten, ∀ (fs : List Frame) (l : Loc),
      LabelsTranslated.sites.exprSites_265 n tr (fs.map eFrame) (eLoc l) (eExpr i.2.2) =
        (exprSites rn fs l i.2.2).map eSite)
  | [] => Eventually.of (fun _ i hi => by simp at hi)
  | a :: as => by
    obtain ⟨N1, h1⟩ := itemsSites_ev tr rn hn a
    obtain ⟨N2, h2⟩ := altsSites_ev tr rn hn as
    refine ⟨max N1 N2, fun n hn' i hi => ?_⟩
    simp only [List.flatten_cons, List.mem_append] at hi
    rcases hi with hi | hi
    · exact h1 n (by omega) i hi
    · exact h2 n (by omega) i hi
termination_by gs => sizeOf gs

theorem itemsSites_ev (tr : LabelsTranslated.Rule) (rn : String) (hn : tr.ruleName = rn) :
    (is : List Item) → Eventually (fun n => ∀ i ∈ is, ∀ (fs : List Frame) (l : Loc),
      LabelsTranslated.sites.exprSites_265 n tr (fs.map eFrame) (eLoc l) (eExpr i.2.2) =
        (exprSites rn fs l i.2.2).map eSite)
  | [] => Eventually.of (fun _ i hi => by simp at hi)
  | (l, b, e) :: is => by
    obtain ⟨N1, h1⟩ := exprSites_ev tr rn hn e
    obtain ⟨N2, h2⟩ := itemsSites_ev tr rn hn is
    refine ⟨max N1 N2, fun n hn' i hi => ?_⟩
    simp only [List.mem_cons] at hi
    rcases hi with rfl | hi
    · exact h1 n (by omega)
    · exact h2 n (by omega) i hi
termination_by is => sizeOf is
end


/-! ## Sets and maps of HsPrelude -/

section Containers
variable {α β : Type} [BEq α] [LawfulBEq α]

theorem hsSet_member_iff (x : α) (s : HsSet α) : HsSet.member x s = true ↔ x ∈ s.elems := by
  simp [HsSet.member]

theorem hsSet_member_eq (x : α) (s : HsSet α) : HsSet.member x s = s.elems.contains x := by
  apply Bool.eq_iff_iff.2
  simp [hsSet_member_iff]

theorem hsSet_insert_mem (x y : α) (s : HsSet α) : x ∈ (HsSet.insert y s).elems ↔ x = y ∨ x ∈ s.elems := by
  unfold HsSet.insert
  split
  · rename_i h
    rw [hsSet_member_iff] at h
    constructor
    · exact Or.inr
    · rintro (rfl | h') <;> assumption
  · simp [or_comm]

theorem hsSet_foldl_mem (l : List α) : ∀ (s : HsSet α) (x : α),
    x ∈ (l.foldl (fun s y => HsSet.insert y s) s).elems ↔ x ∈ l ∨ x ∈ s.elems := by
  induction l with
  | nil => simp
  | cons y ys ih =>
    intro s x
    simp only [List.foldl_cons, ih, hsSet_insert_mem, List.mem_cons]
    constructor
    · rintro (h | h | h)
      · exact Or.inl (Or.inr h)
      · exact Or.inl (Or.inl h)
      · exact Or.inr h
    · rintro ((h | h) | h)
      · exact Or.inr (Or.inl h)
      · exact Or.inl h
      · exact Or.inr (Or.inr h)

theorem hsSet_fromList_mem (l : List α) (x : α) : x ∈ (HsSet.fromList l).elems ↔ x ∈ l := by
  simp [HsSet.fromList, hsSet_foldl_mem]

theorem hsSet_member_fromList (l : List α) (x : α) : HsSet.member x (HsSet.fromList l) = l.contains x := by
  apply Bool.eq_iff_iff.2
  simp [hsSet_member_iff, hsSet_fromList_mem]

theorem hsSet_member_union (x : α) (a b : HsSet α) :
    HsSet.member x (HsSet.union a b) = (HsSet.member x a || HsSet.member x b) := by
  apply Bool.eq_iff_iff.2
  simp only [hsSet_member_iff, HsSet.union, Bool.or_eq_true, hsSet_foldl_mem]
  exact Or.comm

theorem hsSet_member_difference (x : α) (a b : HsSet α) :
    HsSet.member x (HsSet.difference a b) = (HsSet.member x a && !HsSet.member x b) := by
  apply Bool.eq_iff_iff.2
  simp [hsSet_member_iff, HsSet.difference, List.mem_filter]

omit [LawfulBEq α] in
theorem hsSet_member_singleton (x y : α) : HsSet.member x (HsSet.singleton y) = (y == x) := by
  simp [HsSet.member, HsSet.singleton]

theorem hsSet_beq_iff (a b : HsSet α) :
    (a == b) = true ↔ ∀ x, x ∈ a.elems ↔ x ∈ b.elems := by
  show HsSet.beq a b = true ↔ _
  simp only [HsSet.beq, Bool.and_eq_true, List.all_eq_true, hsSet_member_iff]
  constructor
  · rintro ⟨h1, h2⟩ x
    exact ⟨h1 x, h2 x⟩
  · intro h
    exact ⟨fun x hx => (h x).1 hx, fun x hx => (h x).2 hx⟩

end Containers

section Maps
variable {β : Type}

def lk (k : String) (ps : List (String × β)) : Option β := (ps.find? (·.1 == k)).map (·.2)

theorem lk_nil (k : String) : lk k ([] : List (String × β)) = none := rfl

theorem lk_cons (k a : String) (b : β) (ps : List (String × β)) :
    lk k ((a, b) :: ps) = if a = k then some b else lk k ps := by
  by_cases h : a = k <;> simp [lk, h]

theorem lk_map (f : β → β → β) (k k' : String) (v : β) : ∀ (ps : List (String × β)),
    lk k (ps.map (fun p => if p.1 == k' then (k', f v p.2) else p)) =
      if k' = k then (lk k ps).map (f v) else lk k ps
  | [] => by simp [lk_nil]
  | (a, b) :: ps => by
    have ih := lk_map f k k' v ps
    rw [List.map_cons]
    by_cases hak : a = k'
    · subst hak
      simp only [beq_self_eq_true, ↓reduceIte, lk_cons]
      by_cases hk : a = k
      · subst hk; simp
      · simp only [hk, ↓reduceIte]
        rw [ih]
        simp [hk]
    · have hb : (a == k') = false := by simpa using hak
      simp only [hb, Bool.false_eq_true, ↓reduceIte, lk_cons, ih]
      by_cases hk : a = k
      · subst hk
        have : k' ≠ a := Ne.symm hak
        simp [this]
      · simp [hk]

theorem lk_append (k k' : String) (v : β) : ∀ (ps : List (String × β)),
    lk k (ps ++ [(k', v)]) = match lk k ps with
      | some x => some x
      | none => if k' = k then some v else none
  | [] => by by_cases h : k' = k <;> simp [lk_cons, lk_nil, h]
  | (a, b) :: ps => by
    rw [List.cons_append, lk_cons, lk_cons, lk_append k k' v ps]
    by_cases hk : a = k <;> simp [hk]

theorem lookup_lk (k : String) (m : HsMap String β) : HsMap.lookup k m = lk k m.pairs := rfl

theorem lookup_insertWith (f : β → β → β) (k k' : String) (v : β) (m : HsMap String β) :
    HsMap.lookup k (HsMap.insertWith f k' v m) =
      if k' = k then some (match HsMap.lookup k m with | some old => f v old | none => v)
      else HsMap.lookup k m := by
  unfold HsMap.insertWith
  split
  · rename_i hmem
    rw [lookup_lk, lookup_lk]
    simp only
    rw [lk_map]
    by_cases h : k' = k
    · subst h
      simp only [↓reduceIte]
      have : (lk k' m.pairs).isSome := by
        simp only [HsMap.member, List.any_eq_true, beq_iff_eq] at hmem
        obtain ⟨p, hp, hpk⟩ := hmem
        simp only [lk, Option.isSome_map, List.find?_isSome, beq_iff_eq]
        exact ⟨p, hp, hpk⟩
      cases h2 : lk k' m.pairs with
      | none => simp [h2] at this
      | some x => simp
    · simp [h]
  · rename_i hmem
    rw [lookup_lk, lookup_lk]
    simp only
    rw [lk_append]
    by_cases h : k' = k
    · subst h
      have : lk k' m.pairs = none := by
        simp only [HsMap.member, List.any_eq_true, beq_iff_eq, not_exists, not_and] at hmem
        simp only [lk, Option.map_eq_none_iff, List.find?_eq_none, beq_iff_eq]
        exact fun p hp => hmem p hp
      simp [this]
    · cases h2 : lk k m.pairs <;> simp [h]


theorem lookup_insert (k k' : String) (v : β) (m : HsMap String β) :
    HsMap.lookup k (HsMap.insert k' v m) = if k' = k then some v else HsMap.lookup k m := by
  simp only [HsMap.insert, lookup_insertWith]
  by_cases h : k' = k
  · subst h; cases HsMap.lookup k' m <;> simp
  · simp [h]

theorem lookup_foldl_insert (k : String) : ∀ (xs : List (String × β)) (m : HsMap String β),
    HsMap.lookup k (xs.foldl (fun m p => HsMap.insert p.1 p.2 m) m) =
      xs.foldl (fun acc p => if p.1 == k then some p.2 else acc) (HsMap.lookup k m)
  | [], m => rfl
  | (a, b) :: xs, m => by
    simp only [List.foldl_cons]
    rw [lookup_foldl_insert k xs, lookup_insert]
    by_cases h : a = k <;> simp [h]

theorem lookup_fromList (k : String) (xs : List (String × β)) :
    HsMap.lookup k (HsMap.fromList xs) = findLast xs k := by
  simp only [HsMap.fromList, lookup_foldl_insert, findLast]
  rfl

theorem lookup_foldl_append (k : String) {γ : Type} : ∀ (xs : List (String × List γ)) (m : HsMap String (List γ)),
    (HsMap.lookup k (xs.foldl (fun m p => HsMap.insertWith (HsBase.flip HsList.append) p.1 p.2 m) m)).getD [] =
      (HsMap.lookup k m).getD [] ++ (xs.filter (fun p => p.1 == k)).flatMap (·.2)
  | [], m => by simp
  | (a, b) :: xs, m => by
    simp only [List.foldl_cons]
    rw [lookup_foldl_append k xs, lookup_insertWith]
    by_cases h : a = k
    · subst h
      cases HsMap.lookup a m <;> simp [HsBase.flip, HsList.append]
    · simp [h]

theorem findWithDefault_fromListWith (k : String) {γ : Type} (xs : List (String × List γ)) :
    HsMap.findWithDefault [] k (HsMap.fromListWith (HsBase.flip HsList.append) xs) =
      (xs.filter (fun p => p.1 == k)).flatMap (·.2) := by
  simp only [HsMap.findWithDefault, HsMap.fromListWith]
  rw [lookup_foldl_append]
  simp [HsMap.lookup]

theorem member_lookup (k : String) (m : HsMap String β) : HsMap.member k m = (HsMap.lookup k m).isSome := by
  apply Bool.eq_iff_iff.2
  simp [HsMap.member, HsMap.lookup, List.find?_isSome, List.any_eq_true]

theorem member_keysSet (k : String) (m : HsMap String β) : HsSet.member k (HsMap.keysSet m) = HsMap.member k m := by
  simp [HsSet.member, HsMap.keysSet, HsMap.member, List.any_map, Function.comp_def]

end Maps


/-! ## Maps built from lists -/

section MapsFromList
variable {β : Type}

/-- Every pair of the map is what a lookup of its key finds. -/
def PairsFound (m : HsMap String β) : Prop := ∀ p ∈ m.pairs, HsMap.lookup p.1 m = some p.2

theorem pairsFound_insert (k : String) (v : β) (m : HsMap String β) (h : PairsFound m) :
    PairsFound (HsMap.insert k v m) := by
  intro p hp
  rw [lookup_insert]
  unfold HsMap.insert HsMap.insertWith at hp
  split at hp
  · simp only [List.mem_map] at hp
    obtain ⟨q, hq, rfl⟩ := hp
    by_cases hqk : q.1 = k
    · have : (q.1 == k) = true := by simpa using hqk
      simp [this]
    · have : (q.1 == k) = false := by simpa using hqk
      simp only [this, Bool.false_eq_true, ↓reduceIte]
      rw [ite_eq_right_iff.2 (fun he => absurd he.symm hqk)]
      exact h q hq
  · rename_i hmem
    simp only [List.mem_append, List.mem_singleton] at hp
    rcases hp with hp | rfl
    · have hne : k ≠ p.1 := by
        intro he
        apply hmem
        simp only [HsMap.member, List.any_eq_true, beq_iff_eq]
        exact ⟨p, hp, he.symm⟩
      rw [ite_eq_right_iff.2 (fun he => absurd he hne)]
      exact h p hp
    · simp

theorem pairsFound_foldl (xs : List (String × β)) : ∀ (m : HsMap String β), PairsFound m →
    PairsFound (xs.foldl (fun m p => HsMap.insert p.1 p.2 m) m) := by
  induction xs with
  | nil => exact fun _ h => h
  | cons x xs ih => exact fun m h => ih _ (pairsFound_insert _ _ _ h)

theorem pairsFound_fromList (xs : List (String × β)) : PairsFound (HsMap.fromList xs) :=
  pairsFound_foldl xs _ (fun p hp => by simp at hp)

theorem foldl_findLast_isSome (k : String) : ∀ (xs : List (String × β)) (acc : Option β),
    (xs.foldl (fun acc p => if p.1 == k then some p.2 else acc) acc).isSome =
      (acc.isSome || (xs.map (·.1)).contains k)
  | [], acc => by simp
  | (a, b) :: xs, acc => by
    simp only [List.foldl_cons, foldl_findLast_isSome k xs, List.map_cons, List.contains_cons]
    by_cases h : a = k
    · subst h; simp
    · have : (a == k) = false := by simpa using h
      have h' : (k == a) = false := by simpa using Ne.symm h
      simp [this, h']

theorem findLast_isSome (xs : List (String × β)) (k : String) :
    (findLast xs k).isSome = (xs.map (·.1)).contains k := by
  have := foldl_findLast_isSome k xs none
  simp only [Option.isSome_none, Bool.false_or] at this
  exact this

theorem member_fromList (xs : List (String × β)) (k : String) :
    HsMap.member k (HsMap.fromList xs) = (xs.map (·.1)).contains k := by
  rw [member_lookup, lookup_fromList, findLast_isSome]

theorem foldl_findLast_map {β' : Type} (g : β → β') (k : String) : ∀ (xs : List (String × β)) (acc : Option β),
    (xs.map fun p => (p.1, g p.2)).foldl (fun acc p => if p.1 == k then some p.2 else acc) (acc.map g) =
      (xs.foldl (fun acc p => if p.1 == k then some p.2 else acc) acc).map g
  | [], acc => rfl
  | (a, b) :: xs, acc => by
    simp only [List.map_cons, List.foldl_cons]
    by_cases h : (a == k) = true
    · simp only [h, ↓reduceIte]
      rw [show some (g b) = (some b).map g from rfl, foldl_findLast_map g k xs]
    · simp only [h, Bool.false_eq_true, ↓reduceIte]
      rw [foldl_findLast_map g k xs]

theorem findLast_map {β' : Type} (g : β → β') (xs : List (String × β)) (k : String) :
    findLast (xs.map fun p => (p.1, g p.2)) k = (findLast xs k).map g := by
  simp only [findLast]
  exact foldl_findLast_map g k xs none


end MapsFromList


/-! ## Rules -/

/-- A translated rule and a model rule: the same name, parameters and alternatives. -/
structure RuleCorr (tr : LabelsTranslated.Rule) (mr : Rule) : Prop where
  name : tr.ruleName = mr.name
  params : tr.ruleParams.map LabelsTranslated.Param.paramName = mr.params
  alts : tr.ruleAlts.map (fun a => (a.altLoc, a.altItems)) = eGalts (mr.alts.map fun a => (a.loc, a.items))

inductive RulesCorr : List LabelsTranslated.Rule → List Rule → Prop
  | nil : RulesCorr [] []
  | cons {tr mr trs mrs} : RuleCorr tr mr → RulesCorr trs mrs → RulesCorr (tr :: trs) (mr :: mrs)

theorem RuleCorr.items {tr : LabelsTranslated.Rule} {mr : Rule} (h : RuleCorr tr mr) :
    tr.ruleAlts.map LabelsTranslated.Alt.altItems = eAlts (mr.alts.map (·.items)) := by
  have := congrArg (List.map Prod.snd) h.alts
  simp only [List.map_map, Function.comp_def, eGalts_snd] at this
  simpa [Function.comp_def] using this

theorem RulesCorr.names : ∀ {trs : List LabelsTranslated.Rule} {mrs : List Rule}, RulesCorr trs mrs →
    trs.map LabelsTranslated.Rule.ruleName = mrs.map (·.name)
  | [], [], .nil => rfl
  | _ :: _, _ :: _, .cons h hs => by simp [h.name, hs.names]

theorem RulesCorr.map {β : Type} {f : LabelsTranslated.Rule → β} {g : Rule → β}
    (hfg : ∀ tr mr, RuleCorr tr mr → f tr = g mr) :
    ∀ {trs : List LabelsTranslated.Rule} {mrs : List Rule}, RulesCorr trs mrs → trs.map f = mrs.map g
  | [], [], .nil => rfl
  | _ :: _, _ :: _, .cons h hs => by simp [hfg _ _ h, RulesCorr.map hfg hs]

theorem ruleAbs_e {tp : LabelsTranslated.Pass} {mp : Pass} (hp : PassCorr tp mp) {tr : LabelsTranslated.Rule}
    {mr : Rule} (h : RuleCorr tr mr) : LabelsTranslated.ruleAbs tp tr = eAbs (ruleAbs mp mr) := by
  simp only [LabelsTranslated.ruleAbs, ruleAbs, HsList.concatMap, flatMap_single]
  rw [← altsAbs_e hp, ← h.items]
  simp [List.map_map, Function.comp_def]

/-! ## The abstractions of the rules -/

/-- A translated environment and a model one with the same bindings. -/
def EnvCorr (te : HsMap String LabelsTranslated.Abs) (me : Env) : Prop :=
  ∀ n, HsMap.lookup n te = (findLast me n).map eAbs

/-- The keys of a map are the names, and each pair is what a lookup finds. -/
structure KeysAre (te : HsMap String LabelsTranslated.Abs) (names : List String) : Prop where
  found : PairsFound te
  member : ∀ k, HsMap.member k te = names.contains k

theorem eAbs_inj {a b : Abs} (h : eAbs a = eAbs b) : a = b := by
  obtain ⟨⟨c1, e1⟩, ⟨c2, e2⟩, ⟨c3, e3⟩⟩ := a
  obtain ⟨⟨d1, f1⟩, ⟨d2, f2⟩, ⟨d3, f3⟩⟩ := b
  simp only [eAbs, eCS, LabelsTranslated.Abs.Abs.injEq, LabelsTranslated.CharSet.CharSet.injEq] at h
  obtain ⟨⟨h1, h1'⟩, ⟨h2, h2'⟩, ⟨h3, h3'⟩⟩ := h
  have := map_cp_inj h1; have := map_cp_inj h2; have := map_cp_inj h3
  subst_vars
  rfl

theorem abs_beq_e (a b : Abs) : (eAbs a == eAbs b) = decide (a = b) := by
  show LabelsTranslated.instBEqAbs.beq _ _ = _
  simp only [eAbs, LabelsTranslated.instBEqAbs.beq]
  rw [charSet_beq_e, charSet_beq_e, charSet_beq_e]
  apply Bool.eq_iff_iff.2
  obtain ⟨c, e, s⟩ := a
  obtain ⟨c', e', s'⟩ := b
  simp [Abs.mk.injEq]

theorem optAbs_beq_e (a b : Option Abs) : (a.map eAbs == b.map eAbs) = decide (a = b) := by
  cases a <;> cases b <;> simp [abs_beq_e]

theorem envBeq_e {a b : HsMap String LabelsTranslated.Abs} {ma mb : Env} {names : List String}
    (ka : KeysAre a names) (kb : KeysAre b names) (ha : EnvCorr a ma) (hb : EnvCorr b mb) :
    HsBase.eq a b = names.all (fun n => findLast ma n == findLast mb n) := by
  show HsMap.beq a b = _
  simp only [HsMap.beq]
  have h2 : (b.pairs.all fun p => HsMap.member p.1 a) = true := by
    simp only [List.all_eq_true]
    intro p hp
    rw [ka.member, ← kb.member, member_lookup, kb.found p hp]
    rfl
  rw [h2, Bool.and_true]
  apply Bool.eq_iff_iff.2
  simp only [List.all_eq_true, beq_iff_eq]
  constructor
  · intro h n hn
    have hm : HsMap.member n a = true := by rw [ka.member]; simpa using hn
    rw [member_lookup] at hm
    obtain ⟨v, hv⟩ := Option.isSome_iff_exists.1 hm
    have hp : (n, v) ∈ a.pairs := by
      simp only [HsMap.lookup, Option.map_eq_some_iff] at hv
      obtain ⟨q, hq, rfl⟩ := hv
      have := List.mem_of_find?_eq_some hq
      have hk := List.find?_some hq
      simp only [beq_iff_eq] at hk
      rw [← hk]
      exact this
    have := h (n, v) hp
    rw [hb, ← hv, ha] at this
    rw [optAbs_beq_e] at this
    simpa [eq_comm] using this
  · intro h p hp
    have hn : names.contains p.1 = true := by rw [← ka.member, member_lookup, ka.found p hp]; rfl
    have := h p.1 (by simpa using hn)
    rw [hb, ← ka.found p hp, ha, optAbs_beq_e]
    simpa [eq_comm] using this

theorem keysAre_fromList (xs : List (String × LabelsTranslated.Abs)) :
    KeysAre (HsMap.fromList xs) (xs.map (·.1)) :=
  ⟨pairsFound_fromList xs, fun k => member_fromList xs k⟩

theorem keysAre_rules (rulesM : List Rule) (f : Rule → Abs) :
    KeysAre (HsMap.fromList ((rulesM.map fun r => (r.name, f r)).map fun p => (p.1, eAbs p.2)))
      (rulesM.map (·.name)) := by
  have := keysAre_fromList ((rulesM.map fun r => (r.name, f r)).map fun p => (p.1, eAbs p.2))
  rwa [show ((rulesM.map fun r => (r.name, f r)).map fun p => (p.1, eAbs p.2)).map (·.1) = rulesM.map (·.name) by
    simp [List.map_map, Function.comp_def]] at this

theorem envCorr_fromList (xs : List (String × Abs)) :
    EnvCorr (HsMap.fromList (xs.map fun p => (p.1, eAbs p.2))) xs := by
  intro n
  rw [lookup_fromList, findLast_map]

theorem passEnv_e {te : HsMap String LabelsTranslated.Abs} {me : Env} (h : EnvCorr te me) (n : String) :
    HsMap.findWithDefault LabelsTranslated.bottom n te = eAbs ((findLast me n).getD bottom) := by
  simp only [HsMap.findWithDefault, h n, bottom_e]
  cases findLast me n <;> rfl

theorem fixpointGo_e {rulesT : List LabelsTranslated.Rule} {rulesM : List Rule} (hr : RulesCorr rulesT rulesM)
    {mkT : HsMap String LabelsTranslated.Abs → LabelsTranslated.Pass} {mkM : Env → Pass}
    (hmk : ∀ te me, EnvCorr te me → PassCorr (mkT te) (mkM me)) :
    ∀ (b n : Nat) (te : HsMap String LabelsTranslated.Abs) (me : Env), 1001 - n ≤ b →
      KeysAre te (rulesM.map (·.name)) → EnvCorr te me → ∀ fuel, b + 1 ≤ fuel →
        KeysAre (LabelsTranslated.fixpoint.go_197 fuel rulesT mkT te n) (rulesM.map (·.name)) ∧
        EnvCorr (LabelsTranslated.fixpoint.go_197 fuel rulesT mkT te n) (fixpointGo rulesM mkM me n) := by
  intro b
