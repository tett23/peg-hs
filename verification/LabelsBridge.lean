/-- The list of the component map of the translated `leftRecursion`. -/
def tComps (s : HsSet String) (sccs : List (HsSCC LabelsTranslated.Rule)) : List (String × HsSet String) :=
  HsList.append (HsList.concat (HsList.concatMap (fun ν221 => (match ν221 with
    | (HsSCC.CyclicSCC rs) => [(HsList.concatMap (fun ν220 => (match ν220 with
      | r => [((LabelsTranslated.Rule.ruleName r), (HsSet.fromList (List.map LabelsTranslated.Rule.ruleName rs)))])) rs)]
    | _ => [])) sccs)) (HsList.concatMap (fun ν222 => (match ν222 with
    | (HsSCC.AcyclicSCC r) => (if (HsList.elem (LabelsTranslated.Rule.ruleName r)
        ((LabelsTranslated.leftRecursion.edges_923 s) r)) then
        [((LabelsTranslated.Rule.ruleName r), (HsSet.singleton (LabelsTranslated.Rule.ruleName r)))] else [])
    | _ => [])) sccs)

/-- The translated `leftRecursion`, with the component list named. -/
def tLeftRecursion (fuel : Nat) (rules : List LabelsTranslated.Rule) :
    (HsSet String) × (HsSet String) × (String → (Int → Bool)) :=
  let ruleMap : HsMap String LabelsTranslated.Rule := HsMap.fromList (HsList.concatMap (fun ν218 => (match ν218 with
    | r => [((LabelsTranslated.Rule.ruleName r), r)])) rules)
  let nullable : HsSet String := LabelsTranslated.nullableRules fuel rules
  let sccs : List (HsSCC LabelsTranslated.Rule) := HsGraph.stronglyConnComp (HsList.concatMap (fun ν219 =>
    (match ν219 with
    | r => [(r, (LabelsTranslated.Rule.ruleName r), ((LabelsTranslated.leftRecursion.edges_923 nullable) r))])) rules)
  let component : HsMap String (HsSet String) := HsMap.fromList (tComps nullable sccs)
  let inLr : HsSet String := HsMap.keysSet component
  let direct : HsSet String := HsSet.fromList (HsList.concatMap (fun ν223 => (match ν223 with
    | r => (if (HsSet.member (LabelsTranslated.Rule.ruleName r) inLr) then
        (if ((LabelsTranslated.leftRecursion.isDirect_930 component ruleMap nullable) r) then
          [(LabelsTranslated.Rule.ruleName r)] else []) else []))) rules)
  let other : HsSet String := HsSet.difference inLr direct
  (direct, other, (fun ν224 ν225 => ((LabelsTranslated.leftRecursion.growing_927 component ruleMap nullable) ν224 ν225)))

theorem tLeftRecursion_eq (fuel : Nat) (rules : List LabelsTranslated.Rule) :
    LabelsTranslated.leftRecursion fuel rules = tLeftRecursion fuel rules := rfl

theorem comps_e (sccs : List (HsSCC LabelsTranslated.Rule)) (s : HsSet String) :
    tComps s sccs =
      (lrComps (sccs.map (sccMap fun r => (r.ruleName, LabelsTranslated.leftRecursion.edges_923 s r)))).map
        fun p => (p.1, HsSet.fromList p.2) := by
  simp only [tComps, lrComps, HsList.append, HsList.concat, HsList.concatMap, List.map_append]
  congr 1
  · induction sccs with
    | nil => rfl
    | cons c cs ih =>
      simp only [List.flatMap_cons, List.flatten_append, List.map_cons, List.map_append] at ih ⊢
      rw [ih]
      cases c with
      | AcyclicSCC r => simp [sccMap]
      | CyclicSCC rs => simp [sccMap, flatMap_single, List.map_map, Function.comp_def]
  · induction sccs with
    | nil => rfl
    | cons c cs ih =>
      simp only [List.flatMap_cons, List.map_cons, List.map_append] at ih ⊢
      rw [ih]
      cases c with
      | AcyclicSCC r =>
        simp only [sccMap, elem_contains]
        split <;> simp [*, singleton_fromList]
      | CyclicSCC rs => simp [sccMap]

theorem growing_e {compT : HsMap String (HsSet String)} {rmT : HsMap String LabelsTranslated.Rule}
    {nT : HsSet String} {comps : List (String × List String)} {calls : List (String × List (List String))}
    (hcomp : ∀ n, HsMap.lookup n compT = (findLast comps n).map HsSet.fromList)
    (hrm : ∀ n, (HsMap.lookup n rmT).map (fun r => r.ruleAlts.map (LabelsTranslated.leftRecursion.altCalls_922 nT)) =
      findLast calls n) (n : String) (i : Nat) :
    LabelsTranslated.leftRecursion.growing_927 compT rmT nT n i = growingIn ⟨calls, comps⟩ n i := by
  simp only [LabelsTranslated.leftRecursion.growing_927, growingIn, componentIn, hcomp, ← hrm, HsList.drop]
  cases findLast comps n with
  | none => simp
  | some c =>
    cases HsMap.lookup n rmT with
    | none => simp
    | some r =>
      simp only [Option.map_some, Int.toNat_natCast, List.getElem?_map]
      cases hd : List.drop i r.ruleAlts with
      | nil =>
        have := congrArg List.head? hd
        rw [List.head?_drop] at this
        simp [this]
      | cons a t =>
        have := congrArg List.head? hd
        rw [List.head?_drop] at this
        simp [this, HsList.any, hsSet_member_fromList]

/-- The item test of `isDirect`, translated and in the model. -/
def tDirectItems (name : String) (items : List LabelsTranslated.Item) : Bool :=
  match items with
  | (List.cons (LabelsTranslated.Item.Item _ _ (LabelsTranslated.Expr.ERef _ n List.nil)) _) => HsBase.eq n name
  | _ => false

def mDirectItems (name : String) (items : List Item) : Bool :=
  match items with
  | (_, _, .ref _ n []) :: _ => n == name
  | _ => false

/-- The test of `isDirect` on one alternative of the translated rule. -/
def tDirectAlt (growing : String → Int → Bool) (name : String) (p : Int × LabelsTranslated.Alt) : List Bool :=
  match p with
  | (i, a) => if growing name i then [tDirectItems name (LabelsTranslated.Alt.altItems a)] else []

def mDirectAlt (growing : String → Nat → Bool) (name : String) (p : Nat × Alt) : Bool :=
  !growing name p.1 || mDirectItems name p.2.items

theorem isDirect_unfold (compT : HsMap String (HsSet String)) (rmT : HsMap String LabelsTranslated.Rule)
    (nT : HsSet String) (r : LabelsTranslated.Rule) :
    LabelsTranslated.leftRecursion.isDirect_930 compT rmT nT r =
      (match HsMap.lookup r.ruleName compT with
        | some comp => HsBase.and (HsBase.eq comp (HsSet.singleton r.ruleName))
            (HsList.and (HsList.concatMap (tDirectAlt (LabelsTranslated.leftRecursion.growing_927 compT rmT nT)
              r.ruleName) (HsList.zipFrom 0 r.ruleAlts)))
        | none => false) := rfl

theorem isDirectIn_unfold (t : LrTables) (r : Rule) :
    isDirectIn t r = (match componentIn t r.name with
      | some comp => (comp.all (· == r.name) && comp.contains r.name) &&
          (indexed 0 r.alts).all (mDirectAlt (growingIn t) r.name)
      | none => false) := rfl

theorem directItems_e (name : String) (items : List Item) :
    tDirectItems name (eItems items) = mDirectItems name items := by
  match items with
  | [] => simp [eItems, tDirectItems, mDirectItems]
  | (l, b, e) :: rest =>
    cases e with
    | ref l' n args => cases args <;> simp [eItems, eExpr, HsBase.eq, tDirectItems, mDirectItems]
    | _ => simp [eItems, eExpr, tDirectItems, mDirectItems]

theorem directAlts_e (g : String → Int → Bool) (gm : String → Nat → Bool) (hg : ∀ n (i : Nat), g n i = gm n i)
    (name : String) : ∀ (tas : List LabelsTranslated.Alt) (mas : List Alt) (k : Nat),
      tas.map LabelsTranslated.Alt.altItems = eAlts (mas.map (·.items)) →
      HsList.and (HsList.concatMap (tDirectAlt g name) (HsList.zipFrom k tas)) =
        (indexed k mas).all (mDirectAlt gm name)
  | [], [], _, _ => by simp [HsList.and, HsList.concatMap, HsList.zipFrom, indexed]
  | [], _ :: _, _, h => by simp [eAlts] at h
  | _ :: _, [], _, h => by simp [eAlts] at h
  | ta :: tas, ma :: mas, k, h => by
    simp only [List.map_cons, eAlts, List.cons.injEq] at h
    have ih := directAlts_e g gm hg name tas mas (k + 1) (by rw [h.2])
    simp only [HsList.and, HsList.concatMap] at ih ⊢
    rw [zipFrom_cons, List.flatMap_cons, List.all_append, indexed, List.all_cons]
    rw [show ((k : Int) + 1) = ((k + 1 : Nat) : Int) by omega, ih]
    congr 1
    simp only [tDirectAlt, mDirectAlt, hg, h.1, directItems_e]
    cases gm name k <;> simp

theorem setEq_single (comp : List String) (name : String) :
    setEq comp [name] = (comp.all (· == name) && comp.contains name) := by
  apply Bool.eq_iff_iff.2
  simp [setEq]

theorem isDirect_e {compT : HsMap String (HsSet String)} {rmT : HsMap String LabelsTranslated.Rule}
    {nT : HsSet String} {comps : List (String × List String)} {calls : List (String × List (List String))}
    (hcomp : ∀ n, HsMap.lookup n compT = (findLast comps n).map HsSet.fromList)
    (hrm : ∀ n, (HsMap.lookup n rmT).map (fun r => r.ruleAlts.map (LabelsTranslated.leftRecursion.altCalls_922 nT)) =
      findLast calls n) {tr : LabelsTranslated.Rule} {mr : Rule} (hc : RuleCorr tr mr) :
    LabelsTranslated.leftRecursion.isDirect_930 compT rmT nT tr = isDirectIn ⟨calls, comps⟩ mr := by
  rw [isDirect_unfold, isDirectIn_unfold, hc.name, hcomp]
  simp only [componentIn]
  cases findLast comps mr.name with
  | none => simp
  | some c =>
    simp only [Option.map_some, HsBase.and]
    rw [singleton_fromList, setCorr_beq (setCorr_fromList c) (setCorr_fromList [mr.name]), setEq_single]
    congr 1
    rw [← hc.name]
    exact directAlts_e (LabelsTranslated.leftRecursion.growing_927 compT rmT nT) (growingIn ⟨calls, comps⟩)
      (growing_e hcomp hrm) tr.ruleName tr.ruleAlts mr.alts 0 hc.items

theorem direct_e {compT : HsMap String (HsSet String)} {rmT : HsMap String LabelsTranslated.Rule}
    {nT : HsSet String} {comps : List (String × List String)} {calls : List (String × List (List String))}
    (hcomp : ∀ n, HsMap.lookup n compT = (findLast comps n).map HsSet.fromList)
    (hrm : ∀ n, (HsMap.lookup n rmT).map (fun r => r.ruleAlts.map (LabelsTranslated.leftRecursion.altCalls_922 nT)) =
      findLast calls n) :
    ∀ {rulesT : List LabelsTranslated.Rule} {rulesM : List Rule}, RulesCorr rulesT rulesM →
      HsList.concatMap (fun r => if HsSet.member r.ruleName (HsMap.keysSet compT) = true then
          (if LabelsTranslated.leftRecursion.isDirect_930 compT rmT nT r = true then [r.ruleName] else []) else [])
        rulesT =
      (rulesM.filter (fun r => (comps.map (·.1)).contains r.name && isDirectIn ⟨calls, comps⟩ r)).map (·.name)
  | [], [], .nil => rfl
  | tr :: trs, mr :: mrs, .cons hc hs => by
    have ih := direct_e hcomp hrm hs
    simp only [HsList.concatMap, List.flatMap_cons] at ih ⊢
    rw [ih, isDirect_e hcomp hrm hc, member_keysSet, member_lookup, hcomp, hc.name]
    have : (Option.map HsSet.fromList (findLast comps mr.name)).isSome = (comps.map (·.1)).contains mr.name := by
      rw [Option.isSome_map, findLast_isSome]
    rw [this]
    by_cases h1 : mr.name ∈ comps.map (·.1) <;>
      by_cases h2 : isDirectIn ⟨calls, comps⟩ mr = true <;> simp [h1, h2, List.filter_cons]

theorem leftRecursion_e {rulesT : List LabelsTranslated.Rule} {rulesM : List Rule} (hr : RulesCorr rulesT rulesM)
    (fuel : Nat) (hf : rulesM.length + 1 ≤ fuel) :
    LrCorr (LabelsTranslated.leftRecursion fuel rulesT) (leftRecursion rulesM) := by
  have hnull := nullableRules_e hr fuel hf
  rw [tLeftRecursion_eq]
  simp only [tLeftRecursion, leftRecursion, lrTables]
  generalize LabelsTranslated.nullableRules fuel rulesT = nT at hnull ⊢
  rw [comps_e, sccs_e hr hnull]
  generalize lrComps (lrSccs (nullableRules rulesM) rulesM) = comps
  have hcomp : ∀ n, HsMap.lookup n (HsMap.fromList (comps.map fun p => (p.1, HsSet.fromList p.2))) =
      (findLast comps n).map HsSet.fromList := fun n => by rw [lookup_fromList, findLast_map]
  generalize HsMap.fromList (comps.map fun p => (p.1, HsSet.fromList p.2)) = compT at hcomp
  have hrm : ∀ n, (HsMap.lookup n (HsMap.fromList (HsList.concatMap (fun r => [(r.ruleName, r)]) rulesT))).map
      (fun r => r.ruleAlts.map (LabelsTranslated.leftRecursion.altCalls_922 nT)) =
      findLast (rulesM.map fun r => (r.name, r.alts.map fun a => leftCalls (nullableRules rulesM) a.items)) n := by
    intro n
    rw [lookup_fromList]
    simp only [HsList.concatMap, flatMap_single]
    exact findLast_rules (fun tr mr hc => altCalls_e hnull hc) hr n
  generalize HsMap.fromList (HsList.concatMap (fun r => [(r.ruleName, r)]) rulesT) = rmT at hrm
  have hdirect := direct_e hcomp hrm hr
  refine ⟨?_, ?_, ?_⟩
  · simp only [hdirect]
    exact setCorr_fromList _
  · intro x
    rw [hdirect]
    simp only [hsSet_member_difference, hsSet_member_fromList, member_keysSet, member_lookup, hcomp,
      Option.isSome_map, findLast_isSome]
    apply Bool.eq_iff_iff.2
    simp [List.mem_filter]
  · intro n i
    exact growing_e hcomp hrm n i


/-! ## The sites of a rule, the grammar, the context -/

theorem sites_ev {tr : LabelsTranslated.Rule} {mr : Rule} (hc : RuleCorr tr mr) :
    Eventually (fun n => LabelsTranslated.sites n tr = (sites mr).map eSite) := by
  obtain ⟨N, hN⟩ := altsSites_ev tr mr.name hc.name (mr.alts.map (·.items))
  refine ⟨N + 1, fun n hn => ?_⟩
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  simp only [LabelsTranslated.sites, sites]
  have halts : HsList.concatMap (fun a => [(LabelsTranslated.Alt.altLoc a, LabelsTranslated.Alt.altItems a)])
      tr.ruleAlts = eGalts (mr.alts.map fun a => (a.loc, a.items)) := by
    simp only [HsList.concatMap, flatMap_single]
    exact hc.alts
  simp only [halts]
  have := altSites_part mr.name [] (mr.alts.map fun a => (a.loc, a.items)) true
    (fun k j is item => LabelsTranslated.sites.itemSites_264 (m + 1) tr
      [LabelsTranslated.Frame.FSeq is j, LabelsTranslated.Frame.FAlts (eGalts (mr.alts.map fun a => (a.loc, a.items))) k true]
      item)
    (fun k j is i hm hi => by
      obtain ⟨l', hl'⟩ := hm
      have his : is ∈ mr.alts.map (·.items) := by
        simp only [List.mem_map] at hl' ⊢
        obtain ⟨a, ha, he⟩ := hl'
        simp only [Prod.mk.injEq] at he
        exact ⟨a, ha, he.2⟩
      rw [LabelsTranslated.sites.itemSites_264]
      simp only [eItem, LabelsTranslated.Item.itemLoc, LabelsTranslated.Item.itemExpr]
      have := hN m (by omega) i (List.mem_flatten.2 ⟨is, his, hi⟩)
        [.seq is j, .alts (mr.alts.map fun a => (a.loc, a.items)) k true] i.1
      simpa [eFrame] using this)
    (mr.alts.map fun a => (a.loc, a.items)) 0 (fun _ hp => hp)
  have hsnd : (mr.alts.map fun a => (a.loc, a.items)).map Prod.snd = mr.alts.map (·.items) := by
    simp [Function.comp_def]
  rw [hsnd] at this
  simpa using this

theorem rulesSites_ev : ∀ {trs : List LabelsTranslated.Rule} {mrs : List Rule}, RulesCorr trs mrs →
    Eventually (fun n => HsList.concatMap (fun r => LabelsTranslated.sites n r) trs = (mrs.flatMap sites).map eSite)
  | [], [], .nil => Eventually.of (fun _ => rfl)
  | _ :: _, _ :: _, .cons hc hs => by
    obtain ⟨a, ha⟩ := sites_ev hc
    obtain ⟨b, hb⟩ := rulesSites_ev hs
    refine ⟨max a b, fun n hn => ?_⟩
    have := hb n (by omega)
    simp only [HsList.concatMap] at this ⊢
    simp [List.flatMap_cons, ha n (by omega), this]

/-- A translated grammar and a model grammar: the fields that the label check reads. -/
structure GrammarCorr (tg : LabelsTranslated.Grammar) (mg : Grammar) : Prop where
  start : tg.grammarStart = mg.start.map eLocated
  entries : tg.grammarEntries = mg.entries.map eLocated
  recovers : tg.grammarRecovers = mg.recovers.map fun p => (eLocated p.1, eLocated p.2)
  safe : tg.grammarSafe = mg.safe.map eLocated
  rules : RulesCorr tg.grammarRules mg.rules

theorem unlabelRule_e {tr : LabelsTranslated.Rule} {mr : Rule} (hc : RuleCorr tr mr) :
    RuleCorr (LabelsTranslated.Rule.Rule tr.ruleName tr.ruleLoc tr.ruleParams tr.ruleTemplateParams tr.ruleType
      tr.ruleAnnotation (HsList.concatMap (fun a => [LabelsTranslated.Alt.Alt a.altLoc
        (LabelsTranslated.unlabelItems a.altItems) a.altAction a.altConstructor]) tr.ruleAlts))
      { mr with alts := mr.alts.map (fun a => { a with items := unlabelItems a.items }) } where
  name := hc.name
  params := hc.params
  alts := by
    have := congrArg (List.map fun p => (p.1, LabelsTranslated.unlabelItems p.2)) hc.alts
    rw [List.map_map] at this
    show (HsList.concatMap (fun a => [LabelsTranslated.Alt.Alt a.altLoc
        (LabelsTranslated.unlabelItems a.altItems) a.altAction a.altConstructor]) tr.ruleAlts).map
        (fun a => (a.altLoc, a.altItems)) = _
    simp only [HsList.concatMap, flatMap_single, List.map_map]
    refine Eq.trans ?_ (this.trans ?_)
    · rfl
    · simp [eGalts, unlabelItems_e, Function.comp_def]

theorem unlabelRules_e : ∀ {trs : List LabelsTranslated.Rule} {mrs : List Rule}, RulesCorr trs mrs →
    RulesCorr (HsList.concatMap (fun r => [LabelsTranslated.Rule.Rule r.ruleName r.ruleLoc r.ruleParams
      r.ruleTemplateParams r.ruleType r.ruleAnnotation (HsList.concatMap (fun a => [LabelsTranslated.Alt.Alt a.altLoc
        (LabelsTranslated.unlabelItems a.altItems) a.altAction a.altConstructor]) r.ruleAlts)]) trs)
      (mrs.map fun r => { r with alts := r.alts.map (fun a => { a with items := unlabelItems a.items }) })
  | [], [], .nil => .nil
  | _ :: _, _ :: _, .cons hc hs => by
    simp only [HsList.concatMap, List.flatMap_cons, List.singleton_append, List.map_cons]
    exact .cons (unlabelRule_e hc) (unlabelRules_e hs)

theorem unlabelGrammar_e {tg : LabelsTranslated.Grammar} {mg : Grammar} (h : GrammarCorr tg mg) :
    GrammarCorr (LabelsTranslated.unlabelGrammar tg) (unlabelGrammar mg) where
  start := h.start
  entries := h.entries
  recovers := h.recovers
  safe := h.safe
  rules := unlabelRules_e h.rules


def RuleOpt : Option LabelsTranslated.Rule → Option Rule → Prop
  | some a, some b => RuleCorr a b
  | none, none => True
  | _, _ => False

theorem ruleOpt_foldl (n : String) : ∀ {trs : List LabelsTranslated.Rule} {mrs : List Rule}, RulesCorr trs mrs →
    ∀ (accT : Option LabelsTranslated.Rule) (accM : Option Rule), RuleOpt accT accM →
      RuleOpt ((trs.map fun r => (r.ruleName, r)).foldl (fun acc p => if p.1 == n then some p.2 else acc) accT)
        ((mrs.map fun r => (r.name, r)).foldl (fun acc p => if p.1 == n then some p.2 else acc) accM)
  | [], [], .nil, _, _, h => h
  | tr :: trs, mr :: mrs, .cons hc hs, accT, accM, h => by
    simp only [List.map_cons, List.foldl_cons]
    apply ruleOpt_foldl n hs
    rw [hc.name]
    split
    · exact hc
    · exact h

theorem ruleOpt_findLast {trs : List LabelsTranslated.Rule} {mrs : List Rule} (hr : RulesCorr trs mrs) (n : String) :
    RuleOpt (findLast (trs.map fun r => (r.ruleName, r)) n) (findLast (mrs.map fun r => (r.name, r)) n) :=
  ruleOpt_foldl n hr none none trivial

/-- The translated and the model context agree on embedded values. -/
structure CtxCorr (tc : LabelsTranslated.Ctx) (mc : Ctx) : Prop where
  pass : PassCorr tc.ctxPass mc.pass
  callers : ∀ n, HsMap.findWithDefault [] n tc.ctxCallers = (callers mc n).map eSite
  entries : SetCorr tc.ctxEntries mc.entries
  recovery : SetCorr tc.ctxRecovery mc.recovery
  directLr : SetCorr tc.ctxDirectLr mc.directLr
  otherLr : SetCorr tc.ctxOtherLr mc.otherLr
  growing : ∀ n (i : Nat), tc.ctxGrowing n i = mc.growing n i
  rules : ∀ n, RuleOpt (HsMap.lookup n tc.ctxRules) (findLast mc.rules n)
  expandable : SetCorr tc.ctxExpandable mc.expandable

def tCallerPairs (s : LabelsTranslated.Site) : List (String × List LabelsTranslated.Site) :=
  match s with
  | s@(LabelsTranslated.Site.Site _ _ _ (LabelsTranslated.Expr.ERef _ n _)) => [(n, [s])]
  | _ => []

def tStart (g : LabelsTranslated.Grammar) (rules : List LabelsTranslated.Rule) : String :=
  match (g.grammarStart, rules) with
  | ((Option.some s), _) => LabelsTranslated.Located.unLoc s
  | (Option.none, (List.cons r _)) => LabelsTranslated.Rule.ruleName r
  | _ => ""

def tRecoveryNames (g : LabelsTranslated.Grammar) : List String :=
  HsList.concatMap (fun ν229 => match ν229 with
    | (_, r) => [LabelsTranslated.Located.unLoc r]) g.grammarRecovers

def tContext (fuel : Nat) (g : LabelsTranslated.Grammar) : LabelsTranslated.Ctx :=
  let rules := g.grammarRules
  match LabelsTranslated.abstractions fuel rules with
  | (_, pass) =>
    let callers := HsMap.fromListWith (HsBase.flip HsList.append)
      (HsList.concatMap (fun r => HsList.concatMap tCallerPairs (LabelsTranslated.sites fuel r)) rules)
    let start := tStart g rules
    match LabelsTranslated.leftRecursion fuel rules with
    | (direct, other, growing) =>
      LabelsTranslated.Ctx.Ctx pass callers
        (HsSet.fromList (start :: g.grammarEntries.map LabelsTranslated.Located.unLoc))
        (HsSet.fromList (tRecoveryNames g)) direct other growing
        (HsMap.fromList (HsList.concatMap (fun r => [(r.ruleName, r)]) rules))
        (HsSet.difference (HsSet.fromList (HsList.concatMap (fun r =>
          if LabelsTranslated.context.expandable_503 r then [r.ruleName] else []) rules)) (HsSet.union direct other))

theorem tContext_eq (fuel : Nat) (g : LabelsTranslated.Grammar) :
    LabelsTranslated.context fuel g = tContext fuel g := rfl

theorem callerPairs_e (s : Site) :
    tCallerPairs (eSite s) = if isRef s.expr then [(refName s.expr, [eSite s])] else [] := by
  obtain ⟨r, fs, l, e⟩ := s
  cases e <;> simp [tCallerPairs, eSite, eExpr, isRef, refName]

theorem callers_list (n : String) : ∀ (ss : List Site),
    ((ss.map eSite).flatMap tCallerPairs |>.filter (fun p => p.1 == n)).flatMap (·.2) =
      ((ss.filter fun s => isRef s.expr).filter (fun s => refName s.expr == n)).map eSite
  | [] => rfl
  | s :: ss => by
    have ih := callers_list n ss
    simp only [List.map_cons, List.flatMap_cons, List.filter_append, List.flatMap_append, ih, callerPairs_e]
    by_cases h1 : isRef s.expr = true
    · by_cases h2 : (refName s.expr == n) = true
      · simp [h1, h2, List.filter_cons]
      · simp [h1, h2, List.filter_cons]
    · simp [h1, List.filter_cons]

theorem start_e {tg : LabelsTranslated.Grammar} {mg : Grammar} (h : GrammarCorr tg mg) :
    tStart tg tg.grammarRules = startName mg := by
  unfold tStart startName
  rw [h.start]
  cases hs : mg.start with
  | some s => simp [eLocated, LabelsTranslated.Located.unLoc]
  | none =>
    have hr := h.rules
    generalize tg.grammarRules = trs at hr ⊢
    generalize mg.rules = mrs at hr ⊢
    cases hr with
    | nil => simp
    | cons hc _ => simp [hc.name]

theorem recovery_e {tg : LabelsTranslated.Grammar} {mg : Grammar} (h : GrammarCorr tg mg) :
    tRecoveryNames tg = mg.recovers.map (·.2.2) := by
  unfold tRecoveryNames
  rw [h.recovers]
  simp [HsList.concatMap, flatMap_single, eLocated, LabelsTranslated.Located.unLoc, Function.comp_def]

theorem expandable_e {tr : LabelsTranslated.Rule} {mr : Rule} (hc : RuleCorr tr mr) :
    LabelsTranslated.context.expandable_503 tr = !(mr.alts.any (fun a => itemsMention a.items)) := by
  simp only [LabelsTranslated.context.expandable_503, HsBase.not]
  congr 1
  have : HsList.any (fun a => HsList.any (fun i => LabelsTranslated.exprMentions
      (fun x => LabelsTranslated.context.isTemplateOrEnv_504 x) (LabelsTranslated.Item.itemExpr i))
      (LabelsTranslated.Alt.altItems a)) tr.ruleAlts =
      (tr.ruleAlts.map LabelsTranslated.Alt.altItems).any (fun is => HsList.any (fun i =>
        LabelsTranslated.exprMentions (fun x => LabelsTranslated.context.isTemplateOrEnv_504 x)
          (LabelsTranslated.Item.itemExpr i)) is) := by
    simp [HsList.any, List.any_map, Function.comp_def]
  rw [this, hc.items, eAlts_map]
  simp [List.any_map, Function.comp_def, itemsMention_any]

theorem contextWith_pass (k : Nat → List Item → String) (g : Grammar) :
    (contextWith k g).pass = (abstractions g.rules).2 := by simp only [contextWith]
theorem contextWith_entries (k : Nat → List Item → String) (g : Grammar) :
    (contextWith k g).entries = startName g :: g.entries.map (·.2) := by simp only [contextWith]
theorem contextWith_recovery (k : Nat → List Item → String) (g : Grammar) :
    (contextWith k g).recovery = g.recovers.map (·.2.2) := by simp only [contextWith]
theorem contextWith_rules (k : Nat → List Item → String) (g : Grammar) :
    (contextWith k g).rules = g.rules.map (fun r => (r.name, r)) := by simp only [contextWith]
theorem contextWith_refSites (k : Nat → List Item → String) (g : Grammar) :
