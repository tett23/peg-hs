def sccMap {α β : Type} (f : α → β) : HsSCC α → HsSCC β
  | .AcyclicSCC a => .AcyclicSCC (f a)
  | .CyclicSCC as => .CyclicSCC (as.map f)

theorem insertOnKey_map {α β : Type} (f : α → β) (x : α × String × List String) :
    ∀ (l : List (α × String × List String)),
      HsGraph.insertOnKey (f x.1, x.2) (l.map fun e => (f e.1, e.2)) = (HsGraph.insertOnKey x l).map fun e => (f e.1, e.2)
  | [] => by simp [HsGraph.insertOnKey]
  | y :: ys => by
    simp only [List.map_cons, HsGraph.insertOnKey]
    split <;> simp [insertOnKey_map f x ys]

theorem nodes_map {α β : Type} (f : α → β) : ∀ (xs : List (α × String × List String)),
    (xs.map fun e => (f e.1, e.2)).foldr HsGraph.insertOnKey [] =
      (xs.foldr HsGraph.insertOnKey []).map fun e => (f e.1, e.2)
  | [] => rfl
  | x :: xs => by
    simp only [List.map_cons, List.foldr_cons, nodes_map f xs]
    exact insertOnKey_map f x _

mutual
theorem decTree_map {α β : Type} (f : α → β) (vf : Nat → α) :
    (t : HsGraph.Tree) → (vs : List α) → HsGraph.decTree (fun v => f (vf v)) t (vs.map f) = (HsGraph.decTree vf t vs).map f
  | .node v ts, vs => by
    simp only [HsGraph.decTree, List.map_cons]
    rw [decForest_map f vf ts vs]
theorem decForest_map {α β : Type} (f : α → β) (vf : Nat → α) :
    (ts : List HsGraph.Tree) → (vs : List α) →
      HsGraph.decForest (fun v => f (vf v)) ts (vs.map f) = (HsGraph.decForest vf ts vs).map f
  | [], vs => by simp [HsGraph.decForest]
  | t :: ts, vs => by
    simp only [HsGraph.decForest]
    rw [decForest_map f vf ts vs, decTree_map f vf t]
end

theorem scc_map {α β : Type} [Inhabited α] [Inhabited β] (f : α → β) (hf : f default = default)
    (xs : List (α × String × List String)) :
    HsGraph.stronglyConnComp (xs.map fun e => (f e.1, e.2.1, e.2.2)) = (HsGraph.stronglyConnComp xs).map (sccMap f) := by
  have hxs : (xs.map fun e => (f e.1, e.2.1, e.2.2)) = xs.map fun e => (f e.1, e.2) := rfl
  simp only [HsGraph.stronglyConnComp, hxs, nodes_map]
  generalize xs.foldr HsGraph.insertOnKey [] = nodes
  have hkey : ∀ k, (nodes.map fun e => (f e.1, e.2)).findIdx? (fun e => e.2.1 == k) = nodes.findIdx? (fun e => e.2.1 == k) := by
    intro k
    simp [List.findIdx?_map, Function.comp_def]
  have hg : ((nodes.map fun e => (f e.1, e.2)).map fun e => e.2.2.filterMap
      (fun k => (nodes.map fun e => (f e.1, e.2)).findIdx? (fun e => e.2.1 == k))) =
      nodes.map fun e => e.2.2.filterMap (fun k => nodes.findIdx? (fun e => e.2.1 == k)) := by
    simp [hkey, Function.comp_def]
  simp only [hg]
  have hvf : ∀ v, ((nodes.map fun e => (f e.1, e.2)).getD v default).1 = f ((nodes.getD v default).1) := by
    intro v
    simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
    cases nodes[v]? with
    | none => exact hf.symm
    | some e => simp
  simp only [hvf, List.map_map]
  apply List.map_congr_left
  intro t _
  simp only [Function.comp_def]
  split
  · split <;> simp [sccMap]
  · simp only [sccMap]
    have := decTree_map f (fun v => (nodes.getD v default).1) t []
    simpa using this


