lineIndex t = listArray (0, length starts - 1) starts
  where
    n = TU.lengthWord8 t
    starts = 0 : go 0
    go i
      | i >= n = []
      | otherwise =
          let TU.Iter c d = TU.iter t i
           in if c == '\n' then (i + d) : go (i + d) else go (i + d)

lineOf arr off = go lo hi
  where
    (lo, hi) = bounds arr
    go a b
      | a >= b = a
      | otherwise =
          let m = (a + b + 1) `div` 2
           in if arr ! m <= off then go m b else go a (m - 1)

