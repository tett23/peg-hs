/-- The category of a code point. -/
def ofCode (n : Nat) : HsGeneralCategory :=
  if PegHs.AssembleChars.modifierRanges.any (fun r => decide (r.1 ≤ n ∧ n ≤ r.2)) then ModifierLetter
  else match generalCategoryRanges.find? (fun r => decide (r.1 ≤ n ∧ n ≤ r.2.1)) with
    | some r => ofIndex r.2.2
    | none => NotAssigned

set_option maxRecDepth 100000 in
/-- The table has no run of ModifierLetter. -/
theorem ranges_not_modifier : generalCategoryRanges.all (fun r => r.2.2 != 3) = true := by
  decide +kernel

theorem ofCode_modifier_iff (n : Nat) :
    ofCode n = ModifierLetter ↔
      PegHs.AssembleChars.modifierRanges.any (fun r => decide (r.1 ≤ n ∧ n ≤ r.2)) = true := by
  unfold ofCode
  split
  · simp_all
  · rename_i h
    simp only [h, Bool.false_eq_true, iff_false]
    split
    · rename_i r hr
      have mem := List.mem_of_find?_eq_some hr
      have := List.all_eq_true.mp ranges_not_modifier r mem
      intro eq
      revert this
      generalize r.2.2 = k at eq
      match k, eq with
      | 3, _ => decide
      | 0, h' | 1, h' | 2, h' | 4, h' | 5, h' | 6, h' | 7, h' | 8, h' | 9, h' | 10, h' | 11, h'
      | 12, h' | 13, h' | 14, h' | 15, h' | 16, h' | 17, h' | 18, h' | 19, h' | 20, h' | 21, h'
      | 22, h' | 23, h' | 24, h' | 25, h' | 26, h' | 27, h' | 28, h' => cases h'
      | _ + 29, h' => cases h'
    · simp

end HsGeneralCategory
