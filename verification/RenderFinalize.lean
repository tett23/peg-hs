/-
Codegen.generate's last step, `finalize`, and the header lines of
Codegen.render (ADR 0097 invariant 3).

`generate` renders the module twice: once with an empty restore marker, to
choose a marker that is no line of that render (`freshRestoreMarker`), and once
with that marker. `fragment` and `verbatimBlock` put the marker on a line of its
own after each piece of user code, and `finalize` replaces each line equal to
the marker by a LINE pragma that names the next line of the generated file:

    finalize opts marker t = T.unlines (zipWith fix [1 :: Int ..] (T.lines t))

The models below follow that source (pinned by check-render-finalize.sh):
`textLines` is Data.Text.lines (split at each '\n'; a final '\n' starts no
line), `textUnlines` is Data.Text.unlines (a '\n' after every line),
`finalizeFrom` is `zipWith fix [n ..]`, `restoreMarker` is the marker that
`freshRestoreMarker` chooses, and `headerLines` are the comment and pragma
lines that open `render`'s list. check-render-finalize.sh runs these Lean
definitions on modules that peg-hs generated and compares the results with the
files byte for byte.

Theorems:
- `unlines_lines`: unlines after lines gives the text back, with at most one
  '\n' added at the end.
- `finalize_lex`: the finalized text lexes to the tokens of the rendered text.
- `finalize_header`, `finalize_render_header`: the header lines (the two
  comments, the LANGUAGE pragmas and the OPTIONS_GHC pragma) come out of
  finalize unchanged and first.
- `finalize_line_numbers`: the LINE pragma that replaces the marker on line
  i + 1 names line i + 2, the line after it.

Premises left explicit in the theorems:
- `eof` (finalize_lex): a '\n' added at the end of the rendered text adds no
  token. finalize ends the text with '\n' when render did not.
- `steps` (finalize_lex): for each line equal to the marker, replacing it by
  its LINE pragma in the partly finalized text does not change the tokens.
  Both lines are pragmas that GHC lexes as no token: the marker is a pragma
  GHC does not know (`{-# PEG'RESTORE_x... #-}`), and LINE only moves the
  position. `transparent_of_marker_line` gives `steps` from the same
  statement for every context (`MarkerLine`). check-render-finalize.sh checks
  the composite of these steps and `eof` with GHC 9.10.3's own lexer on
  generated modules.
- `source_ok`, `languages_ok`, `shown_ok`: the file name in the first comment,
  the `%language` arguments and the shown output name hold no '\n'. generate
  rejects file names with control characters (ADR 0080), Haskell's `show`
  escapes '\n', and a directive argument is `(!'\n' .)*` in Peg.hpeg.
-/

namespace PegHs.RenderFinalize

-- Data.Text.lines on the characters of a text. `acc` holds the current line,
-- reversed. A final '\n' ends the last line and starts none.
def linesFrom (acc : List Char) : List Char → List (List Char)
  | [] => if acc = [] then [] else [acc.reverse]
  | c :: cs => if c = '\n' then acc.reverse :: linesFrom [] cs else linesFrom (c :: acc) cs

-- Data.Text.unlines on characters: each line followed by '\n'.
def unlinesChars (ls : List (List Char)) : List Char :=
  (ls.map (· ++ ['\n'])).flatten

def textLines (t : String) : List String :=
  (linesFrom [] t.toList).map String.ofList

def textUnlines (ls : List String) : String :=
  String.join (ls.map (· ++ "\n"))

-- `showT n` for a positive Int is its decimal digits; `shown` is
-- `T.pack (show (optOutputName opts))`.
def linePragma (n : Nat) (shown : String) : String :=
  "{-# LINE " ++ toString n ++ " " ++ shown ++ " #-}"

-- `fix n line` in finalize.
def fixLine (shown marker : String) (n : Nat) (line : String) : String :=
  if line = marker then linePragma (n + 1) shown else line

-- `zipWith fix [n ..]`.
def finalizeFrom (shown marker : String) : Nat → List String → List String
  | _, [] => []
  | n, l :: ls => fixLine shown marker n l :: finalizeFrom shown marker (n + 1) ls

def finalizeAt (shown marker : String) (n : Nat) (t : String) : String :=
  textUnlines (finalizeFrom shown marker n (textLines t))

def finalize (shown marker t : String) : String :=
  finalizeAt shown marker 1 t

-- freshRestoreMarker: "{-# PEG'RESTORE_" <> T.replicate n "x" <> " #-}".
def restoreMarker (n : Nat) : String :=
  "{-# PEG'RESTORE_" ++ String.ofList (List.replicate n 'x') ++ " #-}"

def runtimeVersions : String := "peg-runtime >=0.1 && <0.2"

-- The lines before `module` in render's list.
def headerLines (source : String) (languages : List String) (pruned : Bool) : List String :=
  ["-- This module was generated by peg-hs from " ++ source ++ ". Do not edit it by hand.",
   "-- It needs " ++ runtimeVersions ++ "."] ++
  languages.map (fun x => "{-# LANGUAGE " ++ x ++ " #-}") ++
  (if pruned then ["{-# OPTIONS_GHC -Wno-unused-imports -Wno-unused-top-binds #-}"] else [])

/-! Lines and unlines -/

theorem linesFrom_nil (acc : List Char) :
    linesFrom acc [] = if acc = [] then [] else [acc.reverse] := rfl

theorem linesFrom_newline (acc cs : List Char) :
    linesFrom acc ('\n' :: cs) = acc.reverse :: linesFrom [] cs := by
  simp [linesFrom]

theorem linesFrom_other (acc : List Char) (c : Char) (cs : List Char) (hc : c ≠ '\n') :
    linesFrom acc (c :: cs) = linesFrom (c :: acc) cs := by
  simp [linesFrom, hc]

theorem unlinesChars_nil : unlinesChars [] = [] := rfl

theorem unlinesChars_cons (l : List Char) (ls : List (List Char)) :
    unlinesChars (l :: ls) = l ++ '\n' :: unlinesChars ls := by
  simp [unlinesChars]

theorem fixLine_marker (shown marker : String) (n : Nat) :
    fixLine shown marker n marker = linePragma (n + 1) shown := by
  simp [fixLine]

theorem fixLine_other (shown marker : String) (n : Nat) (l : String) (hl : l ≠ marker) :
    fixLine shown marker n l = l := by
  simp [fixLine, hl]

theorem unlines_linesFrom (acc cs : List Char) :
    unlinesChars (linesFrom acc cs) = acc.reverse ++ cs ∨
    unlinesChars (linesFrom acc cs) = acc.reverse ++ cs ++ ['\n'] := by
  induction cs generalizing acc with
  | nil =>
    rw [linesFrom_nil]
    by_cases h : acc = []
    · left
      simp [h, unlinesChars_nil]
    · right
      simp [h, unlinesChars_cons, unlinesChars_nil]
  | cons c cs ih =>
    by_cases hc : c = '\n'
    · subst hc
      rw [linesFrom_newline, unlinesChars_cons]
      rcases ih [] with h | h
      · left
        rw [h]
        simp
      · right
        rw [h]
        simp
    · rw [linesFrom_other acc c cs hc]
      rcases ih (c :: acc) with h | h
      · left
        rw [h]
        simp
      · right
        rw [h]
        simp

theorem toList_textUnlines (ls : List String) :
    (textUnlines ls).toList = unlinesChars (ls.map String.toList) := by
  induction ls with
  | nil => simp [textUnlines, unlinesChars]
  | cons l ls ih =>
    simp only [textUnlines, List.map_cons, String.join_cons, String.toList_append] at ih ⊢
    rw [ih]
    simp [unlinesChars]

theorem map_toList_textLines (t : String) :
    (textLines t).map String.toList = linesFrom [] t.toList := by
  simp [textLines, Function.comp_def]

theorem unlines_lines (t : String) :
    textUnlines (textLines t) = t ∨ textUnlines (textLines t) = t ++ "\n" := by
  rcases unlines_linesFrom [] t.toList with h | h
  · left
    apply String.toList_inj.mp
    rw [toList_textUnlines, map_toList_textLines, h]
    simp
  · right
    apply String.toList_inj.mp
    rw [toList_textUnlines, map_toList_textLines, h, String.toList_append]
    simp

theorem textUnlines_append (a b : List String) :
    textUnlines (a ++ b) = textUnlines a ++ textUnlines b := by
  apply String.toList_inj.mp
  simp [toList_textUnlines, unlinesChars, String.toList_append]

/-! finalize keeps the tokens -/

-- One obligation per line equal to the marker, on the text finalized up to
-- that line. Every other line gives `True`.
def Transparent {α : Type} (lex : String → List α) (shown marker : String) :
    List String → Nat → List String → Prop
  | _, _, [] => True
  | done, n, l :: ls =>
    (l = marker →
      lex (textUnlines (done ++ marker :: ls)) =
        lex (textUnlines (done ++ linePragma (n + 1) shown :: ls))) ∧
    Transparent lex shown marker (done ++ [fixLine shown marker n l]) (n + 1) ls

theorem finalizeFrom_lex {α : Type} (lex : String → List α) (shown marker : String)
    (done : List String) (n : Nat) (rest : List String)
    (steps : Transparent lex shown marker done n rest) :
    lex (textUnlines (done ++ finalizeFrom shown marker n rest)) =
      lex (textUnlines (done ++ rest)) := by
  induction rest generalizing done n with
  | nil => simp [finalizeFrom]
  | cons l ls ih =>
    obtain ⟨step, tail⟩ := steps
    have shifted := ih (done ++ [fixLine shown marker n l]) (n + 1) tail
    simp only [List.append_assoc, List.singleton_append] at shifted
    simp only [finalizeFrom]
    rw [shifted]
    by_cases hl : l = marker
    · subst hl
      rw [fixLine_marker]
      exact (step rfl).symm
    · rw [fixLine_other shown marker n l hl]

theorem finalize_lex {α : Type} (lex : String → List α) (shown marker t : String)
    (eof : lex (t ++ "\n") = lex t)
    (steps : Transparent lex shown marker [] 1 (textLines t)) :
    lex (finalize shown marker t) = lex t := by
  have h := finalizeFrom_lex lex shown marker [] 1 (textLines t) steps
  simp only [List.nil_append] at h
  simp only [finalize, finalizeAt]
  rw [h]
  rcases unlines_lines t with e | e <;> rw [e]
  exact eof

-- The same obligation in every context: a line holding the marker and a line
-- holding any LINE pragma lex alike.
def MarkerLine {α : Type} (lex : String → List α) (shown marker : String) : Prop :=
  ∀ (before after : List String) (n : Nat),
    lex (textUnlines (before ++ marker :: after)) =
      lex (textUnlines (before ++ linePragma n shown :: after))

theorem transparent_of_marker_line {α : Type} (lex : String → List α)
    (shown marker : String) (h : MarkerLine lex shown marker)
    (done : List String) (n : Nat) (rest : List String) :
    Transparent lex shown marker done n rest := by
  induction rest generalizing done n with
  | nil => trivial
  | cons l ls ih => exact ⟨fun _ => h done ls (n + 1), ih _ _⟩

/-! The header lines come out unchanged and first -/

theorem linesFrom_line (acc h r : List Char) (hn : '\n' ∉ h) :
    linesFrom acc (h ++ '\n' :: r) = (acc.reverse ++ h) :: linesFrom [] r := by
  induction h generalizing acc with
  | nil => simp [linesFrom]
  | cons c h ih =>
    have hc : c ≠ '\n' := fun e => hn (e ▸ List.mem_cons_self)
    have hn' : '\n' ∉ h := fun m => hn (List.mem_cons_of_mem _ m)
    rw [List.cons_append, linesFrom_other acc c _ hc, ih (c :: acc) hn']
    simp

theorem linesFrom_unlines (ls : List (List Char)) (r : List Char)
    (hn : ∀ l ∈ ls, '\n' ∉ l) :
    linesFrom [] (unlinesChars ls ++ r) = ls ++ linesFrom [] r := by
  induction ls with
  | nil => simp [unlinesChars]
  | cons l ls ih =>
    have hl := hn l List.mem_cons_self
    have rest := ih (fun x m => hn x (List.mem_cons_of_mem _ m))
    simp only [unlinesChars, List.map_cons, List.flatten_cons, List.append_assoc] at rest ⊢
    rw [show l ++ (['\n'] ++ ((List.map (· ++ ['\n']) ls).flatten ++ r)) =
      l ++ '\n' :: ((List.map (· ++ ['\n']) ls).flatten ++ r) by simp]
    rw [linesFrom_line [] l _ hl, rest]
    simp

theorem textLines_prefix (hs : List String) (rest : String)
    (hn : ∀ h ∈ hs, '\n' ∉ h.toList) :
    textLines (textUnlines hs ++ rest) = hs ++ textLines rest := by
  have hc : ∀ l ∈ hs.map String.toList, '\n' ∉ l := by
    intro l m
    obtain ⟨h, mh, rfl⟩ := List.mem_map.mp m
    exact hn h mh
  simp only [textLines, String.toList_append, toList_textUnlines,
    linesFrom_unlines _ _ hc, List.map_append, List.map_map]
  congr 1
  simp [Function.comp_def]

theorem textLines_textUnlines (ls : List String)
    (hn : ∀ h ∈ ls, '\n' ∉ h.toList) :
    textLines (textUnlines ls) = ls := by
  have h := textLines_prefix ls "" hn
  rw [String.append_empty] at h
  rw [h]
  simp [textLines, linesFrom_nil]

theorem finalizeFrom_prefix (shown marker : String) (n : Nat) (hs ls : List String)
    (hm : ∀ h ∈ hs, h ≠ marker) :
    finalizeFrom shown marker n (hs ++ ls) = hs ++ finalizeFrom shown marker (n + hs.length) ls := by
  induction hs generalizing n with
  | nil => simp
  | cons h hs ih =>
    have hh : h ≠ marker := hm h List.mem_cons_self
    simp only [List.cons_append, finalizeFrom, fixLine_other shown marker n h hh, List.length_cons]
    rw [ih (n + 1) (fun x m => hm x (List.mem_cons_of_mem _ m))]
    simp only [List.cons.injEq, true_and]
    congr 2
    omega

theorem intercalate_cons (h : String) (l : List String) (hl : l ≠ []) :
    String.intercalate "\n" (h :: l) = h ++ "\n" ++ String.intercalate "\n" l := by
  obtain ⟨b, bs, rfl⟩ := List.exists_cons_of_ne_nil hl
  exact String.intercalate_cons_cons

theorem intercalate_prefix (hs body : List String) (hb : body ≠ []) :
    String.intercalate "\n" (hs ++ body) = textUnlines hs ++ String.intercalate "\n" body := by
  induction hs with
  | nil =>
    apply String.toList_inj.mp
    simp [textUnlines]
  | cons h hs ih =>
    have hne : hs ++ body ≠ [] := by simp [hb]
    rw [List.cons_append, intercalate_cons h _ hne, ih]
    apply String.toList_inj.mp
    simp [textUnlines, String.join_cons, String.toList_append]

theorem finalize_header (shown marker : String) (hs body : List String)
    (hn : ∀ h ∈ hs, '\n' ∉ h.toList) (hm : ∀ h ∈ hs, h ≠ marker) (hb : body ≠ []) :
    finalize shown marker (String.intercalate "\n" (hs ++ body)) =
      textUnlines hs ++ finalizeAt shown marker (1 + hs.length) (String.intercalate "\n" body) := by
  simp only [finalize, finalizeAt]
  rw [intercalate_prefix hs body hb, textLines_prefix hs _ hn,
    finalizeFrom_prefix shown marker 1 hs _ hm, textUnlines_append]

theorem ne_of_prefix {p q x y : String} (hlen : p.toList.length = q.toList.length)
    (hpq : p ≠ q) : p ++ x ≠ q ++ y := by
  intro h
  have e := congrArg String.toList h
  simp only [String.toList_append] at e
  exact hpq (String.toList_inj.mp (List.append_inj_left e hlen))

theorem header_lines_single (source : String) (languages : List String) (pruned : Bool)
    (source_ok : '\n' ∉ source.toList) (languages_ok : ∀ x ∈ languages, '\n' ∉ x.toList) :
    ∀ h ∈ headerLines source languages pruned, '\n' ∉ h.toList := by
  intro h m
  simp only [headerLines, List.mem_append, List.mem_cons, List.mem_map,
    List.not_mem_nil, or_false] at m
  rcases m with ((rfl | rfl) | ⟨x, mx, rfl⟩) | mo
  · simp only [String.toList_append, List.mem_append, not_or]
    exact ⟨⟨by decide, source_ok⟩, by decide⟩
  · simp only [runtimeVersions, String.toList_append, List.mem_append, not_or]
    exact ⟨⟨by decide, by decide⟩, by decide⟩
  · simp only [String.toList_append, List.mem_append, not_or]
    exact ⟨⟨by decide, languages_ok x mx⟩, by decide⟩
  · cases pruned
    · simp at mo
    · simp only [ite_true, List.mem_cons, List.not_mem_nil, or_false] at mo
      subst mo
      decide

theorem header_lines_not_marker (source : String) (languages : List String) (pruned : Bool)
    (k : Nat) : ∀ h ∈ headerLines source languages pruned, h ≠ restoreMarker k := by
  intro h m
  have marker : restoreMarker k =
      "{-# P" ++ ("EG'RESTORE_" ++ String.ofList (List.replicate k 'x') ++ " #-}") := by
    apply String.toList_inj.mp
    simp only [restoreMarker, String.toList_append]
    rw [show ("{-# PEG'RESTORE_" : String).toList =
      ("{-# P" : String).toList ++ ("EG'RESTORE_" : String).toList by decide]
    simp
  rw [marker]
  simp only [headerLines, List.mem_append, List.mem_cons, List.mem_map,
    List.not_mem_nil, or_false] at m
  rcases m with ((rfl | rfl) | ⟨x, _, rfl⟩) | mo
  · rw [show ("-- This module was generated by peg-hs from " : String) =
      "-- Th" ++ "is module was generated by peg-hs from " by decide]
    simp only [String.append_assoc]
    exact ne_of_prefix (by decide) (by decide)
  · rw [show ("-- It needs " : String) = "-- It" ++ " needs " by decide]
    simp only [String.append_assoc]
    exact ne_of_prefix (by decide) (by decide)
  · rw [show ("{-# LANGUAGE " : String) = "{-# L" ++ "ANGUAGE " by decide]
    simp only [String.append_assoc]
    exact ne_of_prefix (by decide) (by decide)
  · cases pruned
    · simp at mo
    · simp only [ite_true, List.mem_cons, List.not_mem_nil, or_false] at mo
      subst mo
      rw [show ("{-# OPTIONS_GHC -Wno-unused-imports -Wno-unused-top-binds #-}" : String) =
        "{-# O" ++ "PTIONS_GHC -Wno-unused-imports -Wno-unused-top-binds #-}" by decide]
      exact ne_of_prefix (by decide) (by decide)

-- render's list starts with the header lines; `body` is the rest of the
-- list, from `module` on. finalize leaves the header lines, in order, at the
-- top of the generated file.
theorem finalize_render_header (shown source : String) (languages : List String)
    (pruned : Bool) (k : Nat) (body : List String)
    (source_ok : '\n' ∉ source.toList) (languages_ok : ∀ x ∈ languages, '\n' ∉ x.toList)
    (hb : body ≠ []) :
    finalize shown (restoreMarker k)
        (String.intercalate "\n" (headerLines source languages pruned ++ body)) =
      textUnlines (headerLines source languages pruned) ++
        finalizeAt shown (restoreMarker k) (1 + (headerLines source languages pruned).length)
          (String.intercalate "\n" body) :=
  finalize_header _ _ _ _
    (header_lines_single source languages pruned source_ok languages_ok)
    (header_lines_not_marker source languages pruned k) hb

/-! Each LINE pragma names the line after it -/

theorem finalizeFrom_getElem? (shown marker : String) (n : Nat) (ls : List String) (i : Nat) :
    (finalizeFrom shown marker n ls)[i]? = (ls[i]?).map (fixLine shown marker (n + i)) := by
  induction ls generalizing n i with
  | nil => simp [finalizeFrom]
  | cons l ls ih =>
    cases i with
    | zero => simp [finalizeFrom]
    | succ i =>
      simp only [finalizeFrom, List.getElem?_cons_succ]
      rw [ih (n + 1) i]
      congr 2
      omega

theorem toString_no_newline (n : Nat) : '\n' ∉ (toString n).toList := by
  intro m
  have digit : ∀ c ∈ (toString n).toList, c.isDigit = true := by
    intro c mc
    exact Nat.isDigit_of_mem_toDigits (b := 10) (by decide) (by decide) (by simpa [Nat.repr] using mc)
  exact absurd (digit '\n' m) (by decide)

theorem line_pragma_single (n : Nat) (shown : String) (shown_ok : '\n' ∉ shown.toList) :
    '\n' ∉ (linePragma n shown).toList := by
  simp only [linePragma, String.toList_append, List.mem_append, not_or]
  exact ⟨⟨⟨⟨by decide, toString_no_newline n⟩, by decide⟩, shown_ok⟩, by decide⟩

theorem textLines_no_newline (t : String) : ∀ h ∈ textLines t, '\n' ∉ h.toList := by
  suffices ∀ acc cs, '\n' ∉ acc → ∀ l ∈ linesFrom acc cs, '\n' ∉ l by
    intro h m
    obtain ⟨l, ml, rfl⟩ := List.mem_map.mp m
    simpa using this [] t.toList (by simp) l ml
  intro acc cs
  induction cs generalizing acc with
  | nil =>
    intro ha l ml
    by_cases h : acc = []
    · simp [linesFrom, h] at ml
    · simp only [linesFrom_nil, h, ite_false, List.mem_cons, List.not_mem_nil, or_false] at ml
      subst ml
      simpa using ha
  | cons c cs ih =>
    intro ha l ml
    by_cases hc : c = '\n'
    · subst hc
      simp only [linesFrom_newline, List.mem_cons] at ml
      rcases ml with rfl | ml
      · simpa using ha
      · exact ih [] (by simp) l ml
    · simp only [linesFrom_other acc c cs hc] at ml
      refine ih (c :: acc) ?_ l ml
      simp only [List.mem_cons, not_or]
      exact ⟨fun e => hc e.symm, ha⟩

theorem finalizeFrom_no_newline (shown marker : String) (shown_ok : '\n' ∉ shown.toList)
    (n : Nat) (ls : List String) (hn : ∀ h ∈ ls, '\n' ∉ h.toList) :
    ∀ h ∈ finalizeFrom shown marker n ls, '\n' ∉ h.toList := by
  induction ls generalizing n with
  | nil => simp [finalizeFrom]
  | cons l ls ih =>
    intro h m
    simp only [finalizeFrom, List.mem_cons] at m
    rcases m with rfl | m
    · unfold fixLine
      split
      · exact line_pragma_single _ shown shown_ok
      · exact hn l List.mem_cons_self
    · exact ih (n + 1) (fun x mx => hn x (List.mem_cons_of_mem _ mx)) h m

-- Lines are counted from 1: the marker on line i + 1 of the rendered text
-- becomes, on line i + 1 of the generated file, the LINE pragma for line
-- i + 2. finalize keeps every other line where it was.
theorem finalize_line_numbers (shown marker t : String) (shown_ok : '\n' ∉ shown.toList)
    (i : Nat) :
    (textLines (finalize shown marker t))[i]? =
      ((textLines t)[i]?).map (fun l => if l = marker then linePragma (i + 2) shown else l) := by
  simp only [finalize, finalizeAt]
  rw [textLines_textUnlines _ (finalizeFrom_no_newline shown marker shown_ok 1 _
    (textLines_no_newline t)), finalizeFrom_getElem?]
  congr 1
  funext l
  simp only [fixLine]
  congr 2
  omega

#print axioms unlines_lines
#print axioms finalize_lex
#print axioms transparent_of_marker_line
#print axioms finalize_header
#print axioms header_lines_single
#print axioms header_lines_not_marker
#print axioms finalize_render_header
#print axioms finalize_line_numbers

end PegHs.RenderFinalize
