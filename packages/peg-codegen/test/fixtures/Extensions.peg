%module Fixture.Extensions
%language OverloadedStrings, OverloadedLists, LambdaCase
%language Strict, StrictData, NoImplicitPrelude
%start Expr
%entry Term

%{
import Prelude (Int, read, (+), (-), (*), (^))
import Data.Text (unpack)
}%

Expr :: Int
Expr <- l:Expr '+' r:Term { l + r }
      / l:Expr '-' r:Term { l - r }
      / Term

Term :: Int
Term <- l:Term '*' r:Pow { l * r }
      / Pow

Pow :: Int
Pow <- b:Factor '^' e:Pow { b ^ e }
     / Factor

Factor :: Int
Factor <- '(' e:Expr ')' { e }
        / Num

Num :: Int
Num <- ds:$[0-9]+ { read (unpack ds) }
