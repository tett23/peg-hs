%module Fixture.NoMemo
%nomemo Spaces
%nomemo Key
%export Item(..)

%{
import Prelude ()
import qualified Prelude as P
import Data.Text (Text)
import qualified Data.Text as T

data Item = Word Text | Number P.Int | Quoted Text | Pair Text Text
  deriving (P.Eq, P.Show)
}%

Items :: [Item]
Items <- Spaces is:Item* !. { is }

Item :: Item
Item <- w:$([a-z] [a-z0-9_]*) Spaces { Word w }
     / &[0-9] n:$[0-9]+ Spaces { Number (P.read (T.unpack n)) }
     / '"' s:$(!'"' ('\\' . / .))* '"' Spaces { Quoted s }
     / '<' a:Key ',' b:Key '>' Spaces { Pair a b }
     / 'あ' v:$('い' / 'う') Spaces { Word (T.cons 'あ' v) }
     / "\u{1F600}" Spaces { Word (T.pack "smile") }

# 値を持つ括弧グループ
Key :: Text
Key <- k:([a-z]+ $[0-9]+ / $'_') { k }

Spaces :: ()
Spaces <- [ \t\n]* { () }
