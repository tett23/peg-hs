cabal-version:      3.0
name:               peg-cli
version:            0.1.0.0
synopsis:           Command line interface of the peg-hs parser generator
description:
  The @peg-hs@ executable of the peg-hs parser generator. Its
  subcommands generate a Haskell module from a @.peg@ grammar (@gen@),
  format grammars (@fmt@), lint them (@lint@), parse an input with a
  grammar and show its AST or lossless syntax tree (@parse@), and run the
  language server (@lsp@). Generated modules depend only on @peg-runtime@.
  See the README at <https://github.com/tett23/peg-hs> for a tutorial.
homepage:           https://github.com/tett23/peg-hs
bug-reports:        https://github.com/tett23/peg-hs/issues
license:            MIT
license-file:       LICENSE
author:             tett23
maintainer:         tett23@gmail.com
copyright:          2026 tett23
category:           Parsing
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files:
  test/golden/*.txt
tested-with:        GHC == 9.10.3 || == 9.12.4 || == 9.14.1

source-repository head
  type:     git
  location: https://github.com/tett23/peg-hs
  subdir:   packages/peg-cli

executable peg-hs
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:
    Command.Fmt
    Command.Gen
    Command.Lint
    Command.Lsp
    Command.Parse
    Files
    Diagnostics
    EditDistance
    Embedded
    FileIO
    GhcVersion
    Options
    Paths_peg_cli
    Pretty
    ProcessBytes
  autogen-modules:
    Paths_peg_cli
  ghc-options:      -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  build-depends:
    , base         >=4.20 && <4.23
    , bytestring   >=0.11 && <0.13
    , directory    >=1.3  && <1.4
    , filepath     >=1.4  && <1.6
    , peg-codegen  >=0.1  && <0.2
    , peg-grammar  >=0.1  && <0.2
    , peg-lsp      >=0.1  && <0.2
    , process      >=1.6  && <1.7
    , text         >=2.0  && <2.2
  default-language: GHC2021
  default-extensions: LambdaCase

test-suite peg-cli-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test app
  other-modules:
    EditDistance
    Embedded
    FileIO
    GhcVersion
    Pretty
  ghc-options:      -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -threaded -rtsopts "-with-rtsopts=-N"
  build-tool-depends: peg-cli:peg-hs
  build-depends:
    , base         >=4.20 && <4.23
    , directory    >=1.3  && <1.4
    , filepath     >=1.4  && <1.6
    , bytestring
    , peg-grammar
    , peg-lsp
    , text
    , process      >=1.6  && <1.7
    , tasty        >=1.4  && <1.6
    , tasty-golden >=2.3  && <2.4
    , tasty-hunit  >=0.10 && <0.11
    , tasty-quickcheck >=0.10 && <0.12
  default-language: GHC2021
