cabal-version:      3.0
name:               peg-lsp
version:            0.1.0.0
synopsis:           The language server of the .hpeg notation of peg-hs
description:
  A language server for @.hpeg@ grammar files of the peg-hs parser
  generator: diagnostics, formatting, semantic tokens, definitions,
  references, hover and document symbols. The protocol (JSON-RPC over
  standard input and output) is implemented here, without the lsp
  package; its JSON parser is generated by peg-hs.
homepage:           https://github.com/tett23/peg-hs
bug-reports:        https://github.com/tett23/peg-hs/issues
license:            MIT
license-file:       LICENSE
author:             tett23
maintainer:         tett23@gmail.com
copyright:          2026 tett23
category:           Parsing
build-type:         Simple
tested-with:        GHC == 9.10.3
extra-doc-files:    CHANGELOG.md
extra-source-files:
  grammar/Json.hpeg
  test/golden/*.txt

source-repository head
  type:     git
  location: https://github.com/tett23/peg-hs
  subdir:   packages/peg-lsp

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:
    Peg.Lsp
    Peg.Lsp.Json
    Peg.Lsp.Rpc
    Peg.Lsp.Server
  other-modules:
    Peg.Lsp.JsonParser
  build-depends:
    , base         >=4.20 && <4.23
    , bytestring   >=0.11 && <0.13
    , containers   >=0.6  && <0.8
    , peg-grammar  >=0.1  && <0.2
    , peg-runtime  >=0.1  && <0.2
    , text         >=2.0  && <2.2
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions: LambdaCase OverloadedStrings

test-suite peg-lsp-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  -- The tests run in parallel (ADR 0039).
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  hs-source-dirs:   test
  build-depends:
    , base
    , bytestring
    , directory        >=1.3  && <1.4
    , filepath         >=1.4  && <1.6
    , peg-grammar
    , peg-lsp
    , tasty            >=1.4  && <1.6
    , tasty-golden     >=2.3  && <2.4
    , tasty-hunit      >=0.10 && <0.11
    , tasty-quickcheck >=0.10 && <0.12
    , text
  default-language: GHC2021
  default-extensions: LambdaCase OverloadedStrings
