cabal-version:      3.0
name:               peg-runtime
version:            0.1.0.0
synopsis:           Runtime library for parsers generated by peg-hs
description:
  Runtime support for parsers generated by the peg-hs parser generator:
  input positions, parse errors with expected sets, packrat memo tables
  and bounded left recursion.
  Generated modules depend on this package only.
homepage:           https://github.com/tett23/peg-hs
bug-reports:        https://github.com/tett23/peg-hs/issues
license:            MIT
license-file:       LICENSE
author:             tett23
maintainer:         tett23@gmail.com
copyright:          2026 tett23
category:           Parsing
build-type:         Simple
tested-with:        GHC == 9.10.3

source-repository head
  type:     git
  location: https://github.com/tett23/peg-hs
  subdir:   packages/peg-runtime

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:
    Peg.Runtime
    Peg.Runtime.Internal
    Peg.Runtime.Syntax
  other-modules:
    Peg.Runtime.Position
  build-depends:
    , array       >=0.5   && <0.6
    , base        >=4.20  && <4.21
    , containers  >=0.6   && <0.8
    , text        >=2.0   && <2.2
  hs-source-dirs:   src
  default-language: GHC2021

test-suite peg-runtime-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    , base
    , containers
    , peg-runtime
    , tasty             >=1.4  && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
    , text
  default-language: GHC2021
