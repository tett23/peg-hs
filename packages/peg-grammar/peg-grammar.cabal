cabal-version:      3.0
name:               peg-grammar
version:            0.1.0.0
synopsis:           The .hpeg grammar notation of peg-hs: syntax tree, parser and checks
description:
  Reads @.hpeg@ grammar files for the peg-hs parser generator and checks
  them: undefined and unreachable rules, left recursion, repetitions of
  expressions that match the empty string, the values of groups and
  actions, and labels that may reject valid input. It also formats and
  lints grammars, and gives editors their highlights and outlines.
homepage:           https://github.com/tett23/peg-hs
bug-reports:        https://github.com/tett23/peg-hs/issues
license:            MIT
license-file:       LICENSE
author:             tett23
maintainer:         tett23@gmail.com
copyright:          2026 tett23
category:           Parsing
build-type:         Simple
tested-with:        GHC == 9.10.3 || == 9.12.4 || == 9.14.1
extra-doc-files:    CHANGELOG.md
extra-source-files:
  grammar/Peg.hpeg
  grammar/PegSyntax.hpeg
  grammar/SyntaxVariant.txt
  test/golden/*.txt
  test/golden/format/*.hpeg
  test/golden/format/*.txt

source-repository head
  type:     git
  location: https://github.com/tett23/peg-hs
  subdir:   packages/peg-grammar

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:
    Peg.Grammar
    Peg.Grammar.Assemble
    Peg.Grammar.Check
    Peg.Grammar.Format
    Peg.Grammar.Highlight
    Peg.Grammar.Labels
    Peg.Grammar.Lint
    Peg.Grammar.Outline
    Peg.Grammar.Parser
    Peg.Grammar.Templates
  other-modules:
    Peg.Grammar.SelfHosted
    Peg.Grammar.SelfHostedSyntax
  build-depends:
    , base         >=4.20  && <4.23
    , bytestring   >=0.11  && <0.13
    , containers   >=0.6   && <0.8
    , peg-runtime  >=0.1   && <0.2
    , text         >=2.0   && <2.2
  hs-source-dirs:   src
  default-language: GHC2021

test-suite peg-grammar-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  -- The tests run in parallel (ADR 0039).
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  hs-source-dirs:   test test/generated
  other-modules:
    Format
    Labels
    Lint
    Ranges
    Recovery
    Shard
    SelfHostedNoLabels
    TemplateParams
  build-depends:
    , base
    , bytestring
    , containers
    , directory    >=1.3  && <1.4
    , filepath     >=1.4  && <1.6
    , peg-grammar
    , peg-runtime
    , QuickCheck
    , tasty        >=1.4  && <1.6
    , tasty-golden >=2.3  && <2.4
    , tasty-hunit  >=0.10 && <0.11
    , tasty-quickcheck >=0.10 && <0.12
    , text
  default-language: GHC2021
