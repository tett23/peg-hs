# A grammar written carelessly, for the formatter (ADR 0032).
%module Example.Format # the module
%language OverloadedStrings
%{
import Data.Text (Text)
}%

# The start rule.
Items :: [Text]
Items <- is:Item* { id is }

Item :: Text
Item <- w:$([a-z]+) Sp { id w } # a word
     / &[0-9] n:$[0-9]+ Sp { id n }
     / ("(" Sp) Item Sp ")" Sp
       { "group" }
     / Rep<'-'>(1, 2) x:Item { id x }
     / Op<'+'> x:Item ^item {
       x <> "!"
     }

Op<o> :: ()
Op<o> <- o Sp { id () }

Rep<o>(a :: Int, b :: Int) :: ()
Rep<o> <- o &{ a <= b } Sp { id () }

Sp <- [ \t\n]* { id () } # spaces
# the end
