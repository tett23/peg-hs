{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "peg-hs",
  "scopeName": "source.hpeg",
  "fileTypes": [
    "hpeg"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#verbatim"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#definition"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.hpeg",
      "match": "#.*$"
    },
    "verbatim": {
      "name": "meta.embedded.block.haskell",
      "begin": "^\\s*(%\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.hpeg"
        }
      },
      "end": "(\\}%)",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.hpeg"
        }
      },
      "contentName": "source.haskell",
      "patterns": [
        {
          "include": "#haskell-string"
        },
        {
          "include": "source.haskell"
        }
      ]
    },
    "directive": {
      "match": "^\\s*(%[\\p{L}_][\\p{L}\\p{N}_']*)(?:[ \\t]+([^#\\n]*[^#\\s]))?[ \\t]*(#.*)?$",
      "captures": {
        "1": {
          "name": "keyword.other.directive.hpeg"
        },
        "2": {
          "name": "string.unquoted.directive.hpeg"
        },
        "3": {
          "name": "comment.line.number-sign.hpeg"
        }
      }
    },
    "annotation": {
      "begin": "^([\\p{L}_][\\p{L}\\p{N}_']*)(?=(?:\\s*<[^>\\n]*>)?(?:\\s*\\([^\\n]*\\))?\\s*::)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.rule.hpeg"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#template-parameters"
        },
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parameters.begin.hpeg"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parameters.end.hpeg"
            }
          },
          "contentName": "meta.embedded.parameters.hpeg source.haskell",
          "patterns": [
            {
              "include": "#haskell-nested"
            },
            {
              "include": "#haskell-string"
            },
            {
              "include": "#haskell-char"
            },
            {
              "include": "#reserved-binding"
            },
            {
              "include": "source.haskell"
            }
          ]
        },
        {
          "match": "(::)\\s*(.*)$",
          "captures": {
            "1": {
              "name": "keyword.operator.definition.hpeg"
            },
            "2": {
              "name": "meta.embedded.type.hpeg source.haskell",
              "patterns": [
                {
                  "include": "#haskell-string"
                },
                {
                  "include": "source.haskell"
                }
              ]
            }
          }
        }
      ]
    },
    "definition": {
      "begin": "^([\\p{L}_][\\p{L}\\p{N}_']*)(?=(?:\\s*<[^>\\n]*>)?\\s*<-)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.rule.hpeg"
        }
      },
      "end": "(?=^\\s*(?:%|[\\p{L}_][\\p{L}\\p{N}_']*(?:\\s*<[^>\\n]*>)?(?:\\s*\\([^\\n]*\\))?\\s*(?:::|<-)))",
      "patterns": [
        {
          "include": "#template-parameters"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "template-parameters": {
      "begin": "\\G\\s*(<)(?!-)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.template.hpeg"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template.hpeg"
        }
      },
      "patterns": [
        {
          "match": "::",
          "name": "keyword.operator.definition.hpeg"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_']*",
          "name": "variable.parameter.template.hpeg"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#predicate"
        },
        {
          "include": "#action"
        },
        {
          "include": "#literal-single"
        },
        {
          "include": "#literal-double"
        },
        {
          "include": "#class"
        },
        {
          "include": "#label"
        },
        {
          "include": "#binding"
        },
        {
          "include": "#call"
        },
        {
          "include": "#template-call"
        },
        {
          "match": "<-|::",
          "name": "keyword.operator.definition.hpeg"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_']*",
          "name": "variable.other.rule.hpeg"
        },
        {
          "match": "/",
          "name": "keyword.operator.choice.hpeg"
        },
        {
          "match": "[*+?&!$]",
          "name": "keyword.operator.hpeg"
        },
        {
          "match": "\\.",
          "name": "constant.language.any.hpeg"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.group.hpeg"
        }
      ]
    },
    "action": {
      "name": "meta.embedded.action.hpeg",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.action.begin.hpeg"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.action.end.hpeg"
        }
      },
      "contentName": "source.haskell",
      "patterns": [
        {
          "include": "#haskell-nested"
        },
        {
          "include": "#haskell-string"
        },
        {
          "include": "#haskell-char"
        },
        {
          "include": "#reserved-binding"
        },
        {
          "include": "source.haskell"
        }
      ]
    },
    "predicate": {
      "name": "meta.embedded.predicate.hpeg",
      "begin": "([&!])\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.hpeg"
        },
        "2": {
          "name": "punctuation.section.predicate.begin.hpeg"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.predicate.end.hpeg"
        }
      },
      "contentName": "source.haskell",
      "patterns": [
        {
          "include": "#haskell-nested"
        },
        {
          "include": "#haskell-string"
        },
        {
          "include": "#haskell-char"
        },
        {
          "include": "#reserved-binding"
        },
        {
          "include": "source.haskell"
        }
      ]
    },
    "call": {
      "begin": "([\\p{L}_][\\p{L}\\p{N}_']*)(\\()",
      "beginCaptures": {
        "1": {
          "name": "variable.other.rule.hpeg"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.hpeg"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.hpeg"
        }
      },
      "contentName": "meta.embedded.arguments.hpeg source.haskell",
      "patterns": [
        {
          "include": "#haskell-nested"
        },
        {
          "include": "#haskell-string"
        },
        {
          "include": "#haskell-char"
        },
        {
          "include": "#reserved-binding"
        },
        {
          "include": "source.haskell"
        }
      ]
    },
    "template-call": {
      "begin": "([\\p{L}_][\\p{L}\\p{N}_']*)(<)(?!-)",
      "beginCaptures": {
        "1": {
          "name": "variable.other.rule.hpeg"
        },
        "2": {
          "name": "punctuation.definition.template.hpeg"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template.hpeg"
        }
      },
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.template.hpeg"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "literal-single": {
      "name": "string.quoted.single.hpeg",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "literal-double": {
      "name": "string.quoted.double.hpeg",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "class": {
      "name": "string.regexp.class.hpeg",
      "begin": "\\[",
      "end": "\\]|$",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.hpeg",
      "match": "\\\\(?:u\\{[0-9a-fA-F]*\\}|.)"
    },
    "label": {
      "name": "entity.name.tag.label.hpeg",
      "match": "\\^\\s*[\\p{L}_][\\p{L}\\p{N}_']*"
    },
    "binding": {
      "name": "variable.parameter.binding.hpeg",
      "match": "[\\p{L}_][\\p{L}\\p{N}_']*:(?!:)"
    },
    "reserved-binding": {
      "name": "variable.language.hpeg",
      "match": "(?<![\\p{L}\\p{N}_'])(?:_span|_env|_col)(?![\\p{L}\\p{N}_'])"
    },
    "haskell-nested": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#haskell-nested"
            },
            {
              "include": "#haskell-string"
            },
            {
              "include": "#haskell-char"
            },
            {
              "include": "#reserved-binding"
            },
            {
              "include": "source.haskell"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#haskell-nested"
            },
            {
              "include": "#haskell-string"
            },
            {
              "include": "#haskell-char"
            },
            {
              "include": "#reserved-binding"
            },
            {
              "include": "source.haskell"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#haskell-nested"
            },
            {
              "include": "#haskell-string"
            },
            {
              "include": "#haskell-char"
            },
            {
              "include": "#reserved-binding"
            },
            {
              "include": "source.haskell"
            }
          ]
        }
      ]
    },
    "haskell-string": {
      "name": "string.quoted.double.haskell",
      "match": "\"(?:[^\"\\\\]|\\\\.)*\""
    },
    "haskell-char": {
      "name": "string.quoted.single.haskell",
      "match": "(?<![\\p{L}\\p{N}_'])'(?:\\\\.[^'\\n]*|[^\\\\\\n])'"
    }
  }
}
