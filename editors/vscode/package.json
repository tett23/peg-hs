{
  "name": "peg-hs",
  "displayName": "peg-hs",
  "description": "The .hpeg notation of peg-hs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tett23/peg-hs"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hpeg",
        "aliases": [
          "peg-hs",
          "hpeg"
        ],
        "extensions": [
          ".hpeg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hpeg",
        "scopeName": "source.hpeg",
        "path": "./syntaxes/hpeg.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.haskell": "haskell",
          "meta.embedded.action.hpeg": "haskell",
          "meta.embedded.predicate.hpeg": "haskell",
          "meta.embedded.arguments.hpeg": "haskell",
          "meta.embedded.parameters.hpeg": "haskell",
          "meta.embedded.type.hpeg": "haskell"
        }
      }
    ],
    "configurationDefaults": {
      "[hpeg]": {
        "editor.formatOnSave": true
      }
    },
    "configuration": {
      "title": "peg-hs",
      "properties": {
        "peg-hs.path": {
          "type": "string",
          "default": "peg-hs",
          "scope": "machine",
          "description": "The peg-hs executable, which runs the language server with `peg-hs lsp`. Only the user settings can set it; the settings of a workspace cannot."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "peg-hs.path"
      ],
      "description": "The language server only reads grammars and does not run their Haskell, so it runs in an untrusted workspace too, with the peg-hs executable of the user settings."
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:hpeg"
  ],
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
