{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hpeg",
      "camelcase": "Hpeg",
      "scope": "source.hpeg",
      "path": ".",
      "file-types": ["hpeg"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^hpeg$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "The .hpeg notation of peg-hs",
    "links": {
      "repository": "https://github.com/tett23/peg-hs"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
