%module Example # the module
# <- @keyword.directive
#        ^ @module
#                ^ @comment
%{
import Data.Char (isDigit)
}%
# <- @punctuation.special
%language OverloadedStrings
#          ^ @constant
%entry Term
#       ^ @function.call
%recover term Skip
#         ^ @label
#              ^ @function.call
%safe skip
#      ^ @label
%nomemo Skip

Expr :: Int
# <- @function
#    ^ @keyword.operator
Expr <- l:Expr '+' r:Term ^term { l + r }
     #  ^ @variable.parameter
     #   ^ @punctuation.delimiter
     #    ^ @function.call
     #         ^ @string
     #                    ^ @operator
     #                     ^ @label
     #                          ^ @punctuation.special
     #                                  ^ @punctuation.special
     / Term

Term :: Int
Term <- !'-' [0-9]+ . T<'x'> { _span }
     #  ^ @operator
     #   ^ @string
     #       ^ @string.regexp
     #            ^ @operator
     #              ^ @constant.builtin
     #                ^ @function.call
     #                 ^ @punctuation.bracket
     #                         ^ @variable.builtin
     / V<'z', 'w'>(1) { 2 }
     # ^ @function.call
     #  ^ @punctuation.bracket
     #      ^ @punctuation.delimiter
     #            ^ @punctuation.bracket
     #              ^ @punctuation.bracket
     / '\n' { 0 }
     #  ^ @string.escape
     / ('y' / &{ True } . ^skip) { 1 }
     # ^ @punctuation.bracket
     #         ^ @punctuation.special
     #                ^ @punctuation.special
     #                         ^ @punctuation.bracket
     / 'z' { 2 }

Skip :: Int
Skip <- (!'\n' .)* { 0 }

V<p, q>(n :: Int) :: Int
#  ^ @punctuation.delimiter
V<p, q> <- p q { n }

T<p> :: Int
T<p> <- p { 0 }
#    ^ @keyword.operator
