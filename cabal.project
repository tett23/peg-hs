-- The compiler follows the version ghcup marks as recommended (ADR 0013).
with-compiler: ghc-9.10.3

packages:
  packages/peg-runtime
  packages/peg-grammar
  packages/peg-codegen
  packages/peg-cli
  packages/peg-lsp
  -- The setup hooks of ADR 0085. examples/hooks, which uses them, has a
  -- cabal.project of its own: CI builds it in the job hooks.
  packages/peg-hooks
  conformance
  -- The library and tests of the wasm reactor (ADR 0078). The reactor
  -- itself is built with cabal.project.wasm.
  wasm

tests: True
benchmarks: True

-- Generated code must compile without warnings (ADR 0014). -Werror cannot
-- be put in a published .cabal file, so it is set here.
package peg-codegen
  ghc-options: -Werror
