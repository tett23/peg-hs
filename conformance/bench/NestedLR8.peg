# ADR 0024 の計算量の検査：左再帰の段を 8 個重ねた文法
%module Conformance.Bench.NestedLR8

E0 :: ()
E0 <- E1 { () }

E1 :: ()
E1 <- E1 'o1' E2 { () }
   / E2

E2 :: ()
E2 <- E2 'o2' E3 { () }
   / E3

E3 :: ()
E3 <- E3 'o3' E4 { () }
   / E4

E4 :: ()
E4 <- E4 'o4' E5 { () }
   / E5

E5 :: ()
E5 <- E5 'o5' E6 { () }
   / E6

E6 :: ()
E6 <- E6 'o6' E7 { () }
   / E7

E7 :: ()
E7 <- E7 'o7' E8 { () }
   / E8

E8 :: ()
E8 <- E8 'o8' Atom { () }
   / Atom

Atom :: ()
Atom <- 'x' { () }
     / '(' E0 ')' { () }
