# Lua 5.5 の文法。ADR 0022 の適合性テストに使う。
# マニュアルの「The Complete Syntax of Lua」をできるだけそのまま写す。
# 字句の規則は参照実装の字句解析器（llex.c）に合わせる。
%module Conformance.Lua.Parser
%entry Exp
%language OverloadedStrings
%syntax
%token Name
%token Numeral
%token LiteralString
%token Ws
%token Comment
%trivia Ws
%trivia Comment
%inline Sp
%nomemo LongClose

%{
import Conformance.Lua.Ast
import Data.Maybe (fromMaybe)
import Data.Text (Text)
import qualified Data.Text as T
}%

# チャンクとブロック ------------------------------------------------------------
Chunk :: Block
Chunk <- Sp b:Block { b }

Block :: Block
Block <- ss:Stat* r:RetStat? { Block ss r }

RetStat :: [Exp]
RetStat <- K<'return'> es:ExpList? (';' Sp)? { fromMaybe [] es }

# 文 ------------------------------------------------------------------------------
Stat :: Stat
Stat <- ';' Sp { SEmpty }
     / '::' Sp n:Name Sp '::' Sp { SLabel n }
     / K<'break'> { SBreak }
     / K<'goto'> n:Name Sp { SGoto n }
     / K<'do'> b:Block K<'end'> { SDo b }
     / K<'while'> c:Exp K<'do'> b:Block K<'end'> { SWhile c b }
     / K<'repeat'> b:Block K<'until'> c:Exp { SRepeat b c }
     / K<'if'> c:Exp K<'then'> b:Block eis:ElseIf* e:Else? K<'end'> { SIf ((c, b) : eis) e }
     / K<'for'> n:Name Sp '=' !'=' Sp a:Exp ',' Sp z:Exp s:(',' Sp Exp)? K<'do'> b:Block K<'end'> { SForNum n a z s b }
     / K<'for'> ns:NameList K<'in'> es:ExpList K<'do'> b:Block K<'end'> { SForIn ns es b }
     / K<'function'> n:FuncName f:FuncBody { SFunction n f }
     / K<'local'> K<'function'> n:Name Sp f:FuncBody { SLocalFunction n f }
     / K<'local'> a:Attrib? ns:AttNames es:('=' !'=' Sp ExpList)? { SLocal a ns (fromMaybe [] es) }
     / GlobalStat
     / vs:VarList '=' !'=' Sp es:ExpList { SAssign vs es }
     / c:Call { SCall c }

ElseIf :: (Exp, Block)
ElseIf <- K<'elseif'> c:Exp K<'then'> b:Block { (c, b) }

Else :: Block
Else <- K<'else'> b:Block { b }

# 参照実装は LUA_COMPAT_GLOBAL でビルドされており、global は予約語ではない。
# 文の先頭の global は、次の字句が '<'、名前、'*'、function のいずれかのときだけ宣言になる。
GlobalStat :: Stat
GlobalStat <- K<'global'> &('<' !'<' !'=' / Name / '*' / K<'function'>) s:GlobalBody { s }

GlobalBody :: Stat
GlobalBody <- K<'function'> n:Name Sp f:FuncBody { SGlobalFunction n f }
           / a:Attrib? '*' Sp { SGlobalAll a }
           / a:Attrib? ns:AttNames es:('=' !'=' Sp ExpList)? { SGlobal a ns (fromMaybe [] es) }

Attrib :: Text
Attrib <- '<' !'<' !'=' Sp n:Name Sp '>' Sp { n }

AttNames :: [(Text, Maybe Text)]
AttNames <- n:Name Sp a:Attrib? ns:MoreAttName* { (n, a) : ns }

MoreAttName :: (Text, Maybe Text)
MoreAttName <- ',' Sp n:Name Sp a:Attrib? { (n, a) }

FuncName :: FuncName
FuncName <- n:Name Sp ns:('.' !'.' Sp Name Sp)* m:(':' !':' Sp Name Sp)? { FuncName (n : ns) m }

# 区切りのある一つ以上の列
List<p :: a, sep> :: [a]
List<p, sep> <- x:p xs:(sep Sp p)* { x : xs }

VarList :: [Exp]
VarList <- List<Var, ','>

NameList :: [Text]
NameList <- n:Name Sp ns:(',' Sp Name Sp)* { n : ns }

ExpList :: [Exp]
ExpList <- List<Exp, ','>

# 前置式 --------------------------------------------------------------------------
# prefixexp、var、functioncall の三つの規則は、互いを経由した間接の左再帰である。
# マニュアルは prefixexp ::= var | functioncall | '(' exp ')' の順に書くが、
# 順序付き選択では var が先にあると、成長の途中で名前だけの var が成功して
# 呼び出しの選択肢が試されない。そのため functioncall を先に置く。
PrefixExp :: Exp
PrefixExp <- Call
          / Var
          / '(' Sp e:Exp ')' Sp { EParen e }

Var :: Exp
Var <- p:PrefixExp '[' !('='* '[') Sp k:Exp ']' Sp { EIndex p k }
    / p:PrefixExp '.' !'.' Sp n:Name Sp { EField p n }
    / n:Name Sp { EName n }

Call :: Exp
Call <- p:PrefixExp as:Args { ECall p as }
     / p:PrefixExp ':' !':' Sp n:Name Sp as:Args { EMethod p n as }

Args :: [Exp]
Args <- '(' Sp es:ExpList? ')' Sp { fromMaybe [] es }
     / t:Table { [t] }
     / s:LiteralString Sp { [EStr s] }

# 式 --------------------------------------------------------------------------------
# 優先順位の低い順。左結合の段は左再帰、右結合の段（..、^）は右再帰で書く。
Exp :: Exp
Exp <- Or

Or :: Exp
Or <- l:Or K<'or'> r:And { EBin "or" l r }
   / And

And :: Exp
And <- l:And K<'and'> r:Cmp { EBin "and" l r }
    / Cmp

Cmp :: Exp
Cmp <- l:Cmp o:CmpOp r:BOr { EBin o l r }
    / BOr

CmpOp :: Text
CmpOp <- o:$('<=' / '>=' / '==' / '~=' / '<' !'<' / '>' !'>') Sp { o }

BOr :: Exp
BOr <- l:BOr '|' Sp r:BXor { EBin "|" l r }
    / BXor

BXor :: Exp
BXor <- l:BXor '~' !'=' Sp r:BAnd { EBin "~" l r }
     / BAnd

BAnd :: Exp
BAnd <- l:BAnd '&' Sp r:Shift { EBin "&" l r }
     / Shift

Shift :: Exp
Shift <- l:Shift o:$('<<' / '>>') Sp r:Concat { EBin o l r }
      / Concat

Concat :: Exp
Concat <- l:Add '..' !'.' Sp r:Concat { EBin ".." l r }
       / Add

Add :: Exp
Add <- l:Add o:$[+\-] Sp r:Mul { EBin o l r }
    / Mul

Mul :: Exp
Mul <- l:Mul o:$('*' / '//' / '/' / '%') Sp r:Unary { EBin o l r }
    / Unary

# 単項演算子は ^ より弱い。-a^b は -(a^b) であり、^ の右の項には単項演算子が付く
Unary :: Exp
Unary <- o:UnOp e:Unary { EUn o e }
      / Pow

UnOp :: Text
UnOp <- K<'not'> { "not" }
     / o:$('-' / '#' / '~' !'=') Sp { o }

Pow :: Exp
Pow <- b:Simple '^' Sp e:Unary { EBin "^" b e }
    / Simple

Simple :: Exp
Simple <- K<'nil'> { ENil }
       / K<'false'> { EFalse }
       / K<'true'> { ETrue }
       / n:Numeral Sp { ENum n }
       / s:LiteralString Sp { EStr s }
       / '...' Sp { EVararg }
       / K<'function'> f:FuncBody { EFunction f }
       / Table
       / PrefixExp

FuncBody :: FuncBody
FuncBody <- '(' Sp p:ParList? ')' Sp b:Block K<'end'> { let (ns, v) = fromMaybe ([], Nothing) p in FuncBody ns v b }

ParList :: ([Text], Maybe (Maybe Text))
ParList <- ns:NameList v:(',' Sp VarArg)? { (ns, v) }
        / v:VarArg { ([], Just v) }

VarArg :: Maybe Text
VarArg <- '...' Sp n:(Name Sp)? { n }

Table :: Exp
Table <- '{' Sp fs:FieldList? '}' Sp { ETable (fromMaybe [] fs) }

FieldList :: [Field]
FieldList <- f:Field fs:MoreField* FieldSep? { f : fs }

MoreField :: Field
MoreField <- FieldSep f:Field { f }

FieldSep :: ()
FieldSep <- [,;] Sp { () }

Field :: Field
Field <- '[' !('='* '[') Sp k:Exp ']' Sp '=' !'=' Sp v:Exp { FKey k v }
      / n:Name Sp '=' !'=' Sp v:Exp { FName n v }
      / e:Exp { FPos e }

# 字句 ------------------------------------------------------------------------------
Name :: Text
Name <- n:$([a-zA-Z_] [a-zA-Z0-9_]*) !{ isKeyword n } { n }

# 参照実装の read_numeral と同じく、数の形かどうかを問わずに字句を切り出してから
# 数に変換できるかを判定する。1..2 は数の誤りになる
Numeral :: Text
Numeral <- n:$(HexRaw / DecRaw) ![a-zA-Z_] &{ validNumeral n } { n }

HexRaw :: ()
HexRaw <- '0' [xX] ([pP] [+\-]? / [0-9a-fA-F.])* { () }

DecRaw :: ()
DecRaw <- &([0-9] / '.' [0-9]) ([eE] [+\-]? / [0-9a-fA-F.])* { () }

LiteralString :: Text
LiteralString <- s:$('"' DqChar* '"' / '\'' SqChar* '\'' / LongBracket) { s }

DqChar :: ()
DqChar <- '\\' Escape { () }
       / ![\n\r\\"] . { () }

SqChar :: ()
SqChar <- '\\' Escape { () }
       / ![\n\r\\'] . { () }

Escape :: ()
Escape <- [abfnrtv\\"'] { () }
       / '\n' '\r'? { () }
       / '\r' '\n'? { () }
       / 'x' [0-9a-fA-F] [0-9a-fA-F] { () }
       / 'z' [ \t\n\r\u{0B}\u{0C}]* { () }
       / 'u{' h:$[0-9a-fA-F]+ '}' &{ hexValue h < 2 ^ (31 :: Int) } { () }
       / d:$([0-9] [0-9]? [0-9]?) &{ read (T.unpack d) <= (255 :: Int) } { () }

# 長括弧。閉じの = の数は開きと一致しなければならない
LongBracket :: ()
LongBracket <- '[' e:$'='* '[' (!LongClose(T.length e) .)* LongClose(T.length e) { () }

LongClose(n :: Int) :: ()
LongClose <- ']' e:$'='* &{ T.length e == n } ']' { () }

Comment :: ()
Comment <- '--' &('[' '='* '[') LongBracket { () }
        / '--' !('[' '='* '[') (![\n\r] .)* { () }

Ws :: ()
Ws <- [ \t\n\r\u{0B}\u{0C}]+ { () }

Sp :: ()
Sp <- (Ws / Comment)* { () }

# 予約語 ----------------------------------------------------------------------------
# 予約語の後に識別子の文字が続かない。global は予約語ではないが、宣言の始まりを同じ形で読む
K<w> :: ()
K<w> <- w ![a-zA-Z0-9_] Sp { () }
