cabal-version:      3.0
name:               peg-conformance
version:            0.1.0.0
synopsis:           Conformance tests of peg-hs with grammars of real languages
description:
  Not published. Grammars of real languages (JSON, CommonMark, Lua, TOML)
  written in the peg-hs notation, checked against public test suites
  (ADR 0010, ADR 0011, ADR 0022, ADR 0023), and the benchmarks of ADR 0007.
license:            MIT
license-file:       LICENSE
author:             tett23
maintainer:         tett23@gmail.com
category:           Parsing
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

-- The generated parsers, committed next to their grammars.
library
  import:           warnings
  exposed-modules:
    Conformance.Bench.JsonCounted
    Conformance.Bench.JsonNomemo
    Conformance.Bench.JsonRecover
    Conformance.Bench.JsonSyntax
    Conformance.Bench.NestedLR2
    Conformance.Bench.NestedLR4
    Conformance.Bench.NestedLR8
    Conformance.Bench.Pathological
    Conformance.CommonMark
    Conformance.CommonMark.Block
    Conformance.CommonMark.Emphasis
    Conformance.CommonMark.Entities
    Conformance.CommonMark.Inline
    Conformance.CommonMark.Types
    Conformance.CommonMark.V1.Block
    Conformance.CommonMark.V1.Inline
    Conformance.Json.Encode
    Conformance.Json.Parser
    Conformance.Lua.Ast
    Conformance.Lua.Eval
    Conformance.Lua.Parser
    Conformance.Toml.Document
    Conformance.Toml.NoLabels
    Conformance.Toml.Parser
    Conformance.Toml.Types
  hs-source-dirs:   json bench commonmark lua toml
  build-depends:
    , base
    , bytestring
    , containers
    , peg-runtime
    , text
  default-language: GHC2021

test-suite json-conformance
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          JsonMain.hs
  hs-source-dirs:   test
  ghc-options:      -Werror -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , peg-codegen
    , peg-conformance
    , peg-runtime
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , text
  default-language: GHC2021

-- Bounds on the evaluation counts guaranteed by ADR 0007.
test-suite complexity
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          ComplexityMain.hs
  hs-source-dirs:   test
  ghc-options:      -Werror -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , peg-codegen
    , peg-conformance
    , peg-runtime
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
  default-language: GHC2021

-- ADR 0007. Run with: cabal bench peg-conformance
-- Pass --memo-report to print memo table sizes and live memory instead.
benchmark peg-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          BenchMain.hs
  hs-source-dirs:   bench-main
  ghc-options:      -rtsopts "-with-rtsopts=-T"
  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , containers
    , criterion        >=1.6 && <1.7
    , deepseq
    , peg-codegen
    , peg-conformance
    , peg-grammar
    , peg-runtime
    , text
  default-language: GHC2021

-- ADR 0011. Options: --accept, --report FILE, --show N (see the module).
test-suite commonmark-conformance
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          CommonMarkMain.hs
  -- The tests run in parallel (ADR 0039).
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  hs-source-dirs:   test
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , peg-codegen
    , peg-conformance
    , peg-runtime
    , text
  default-language: GHC2021

-- ADR 0022. The golden data is made by lua/golden/regen.sh.
test-suite lua-conformance
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          LuaMain.hs
  hs-source-dirs:   test
  ghc-options:      -Werror -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , peg-codegen
    , peg-conformance
    , peg-runtime
    , tasty
    , tasty-hunit
    , text
  default-language: GHC2021

-- ADR 0023. The stages of the invalid cases are in toml/invalid-stages.golden.
test-suite toml-conformance
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          TomlMain.hs
  hs-source-dirs:   test
  ghc-options:      -Werror -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , filepath
    , peg-codegen
    , peg-grammar
    , peg-conformance
    , peg-runtime
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , text
  default-language: GHC2021
